if(NOT DEFINED FLEXYGRAM_FLAVOR OR NOT FLEXYGRAM_FLAVOR STREQUAL "diagnostic")
    message(FATAL_ERROR "FLEXYGRAM_PRODUCTION_INCOMPLETE: native implementation is diagnostic-only; missing or unknown flavor is forbidden")
endif()
if(NOT FLEXYGRAM_POLICY_SCOPE MATCHES "^[a-f0-9]+:diagnostic$")
    message(FATAL_ERROR "Invalid Java/JNI variant policy scope")
endif()
string(LENGTH "${FLEXYGRAM_POLICY_SCOPE}" _scope_length)
if(NOT _scope_length EQUAL 75)
    message(FATAL_ERROR "Invalid Java/JNI variant policy scope length")
endif()
set(FLEXYGRAM_BUILD_DIAGNOSTIC 1)
configure_file("${CMAKE_CURRENT_LIST_DIR}/tgnet/VariantPolicy.generated.h.in"
    "${CMAKE_CURRENT_BINARY_DIR}/flexygram-policy/VariantPolicy.generated.h" @ONLY)
include_directories("${CMAKE_CURRENT_BINARY_DIR}/flexygram-policy")
