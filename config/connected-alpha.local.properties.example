# Copy values privately to root local.properties. Never commit real values.
# Obtain YOUR api_id/api_hash at https://my.telegram.org -> API development tools.
TELEGRAM_APP_ID=
TELEGRAM_APP_HASH=
# Keep a durable private copy of this Alpha-only signing key and passwords.
# Key path is config/connected-alpha-test.keystore (ignored).
ALPHA_STORE_PASSWORD=
ALPHA_KEY_ALIAS=
ALPHA_KEY_PASSWORD=
# Optional, own Google OAuth web client; phone/code login does not require it.
ALPHA_GOOGLE_AUTH_CLIENT_ID=
# Optional, your Maps key restricted to Alpha package + certificate.
MAPS_API_KEY=
# Machine-specific SDK and Python 3.11 executable.
sdk.dir=
CHAQUOPY_BUILD_PYTHON=
# Firebase: YOUR Android app config at
# TMessagesProj/src/connectedAlpha/google-services.json (ignored).
