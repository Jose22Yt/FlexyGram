import android.app.Activity;import android.content.Context;import android.graphics.*;import android.view.*;import android.widget.*;import java.io.*;import java.util.*;
import androidx.recyclerview.widget.RecyclerView;
import org.junit.*;import static org.junit.Assert.*;import org.junit.runner.RunWith;import org.robolectric.*;import org.robolectric.annotation.*;
import app.flexygram.settings.signature.*;import org.telegram.ui.ActionBar.*;import org.telegram.ui.Components.RecyclerListView;import org.telegram.messenger.*;
/** Real Android graphics and AndroidX Adapter. Telegram host/controllers are explicit doubles. */
@RunWith(RobolectricTestRunner.class) @Config(manifest=Config.NONE,sdk=35) @GraphicsMode(GraphicsMode.Mode.NATIVE)
public class Settings3AndroidTest {
 Activity activity;
 @Before public void setup()throws Exception{activity=Robolectric.buildActivity(Activity.class).setup().get();BaseFragment.activity=activity;ApplicationLoader.applicationContext=activity;LocaleController.isRTL=false;Theme.dark=false;var m=activity.getAssets().getClass().getMethod("addAssetPath",String.class);assertTrue((Integer)m.invoke(activity.getAssets(),System.getProperty("probe.root")+"/resources.ap_")>0);}
 @After public void finish(){activity.finish();}
 @Test public void globalWidgetOwnershipDoesNotDuplicateHomeControls(){for(String key:new String[]{"SwitchStyle","SliderStyle","IconReplacements","CenterActionBarTitleType"})assertEquals("universal",SignatureLegacyExtras.categoryForKey(key));assertEquals("home",SignatureLegacyExtras.categoryForKey("FolderNameAsTitle"));assertEquals("home",SignatureLegacyExtras.categoryForKey("AlwaysShowDownloadIcon"));assertEquals("ayu",SignatureLegacyExtras.categoryForKey("ClearMessageDatabase"));assertEquals("chat",SignatureLegacyExtras.categoryForKey("futureNcPreference","nc"));assertEquals("universal",SignatureLegacyExtras.categoryForKey("futureNgPreference","ng"));}
 @Test public void rootHasExactlyTenApprovedEntries(){assertEquals(Arrays.asList("chat","home","navigation","ayu","plugins","flexyfiles","files","universal","studio","about"),Settings3Registry.all().stream().map(e->e.id).toList());}
 @Test public void rootKeepsSharedSideMarginsAfterSystemInsetsInBothThemesAndDirections(){
  for(boolean dark:new boolean[]{false,true})for(boolean rtl:new boolean[]{false,true}){
   Theme.dark=dark;LocaleController.isRTL=rtl;
   var page=new SignatureSettingsActivity();page.onFragmentCreate();View root=page.createView(activity);
   root.setLayoutDirection(rtl?View.LAYOUT_DIRECTION_RTL:View.LAYOUT_DIRECTION_LTR);
   for(int bottom:new int[]{0,32,0}){
    page.onInsets(0,0,0,bottom);
    assertEquals(SettingsCardStyle.INSET,root.getPaddingLeft());assertEquals(SettingsCardStyle.INSET,root.getPaddingRight());
    assertEquals(Math.max(8,bottom),root.getPaddingBottom());
    root.measure(View.MeasureSpec.makeMeasureSpec(440,View.MeasureSpec.EXACTLY),View.MeasureSpec.makeMeasureSpec(4000,View.MeasureSpec.AT_MOST));root.layout(0,0,440,root.getMeasuredHeight());
    List<Settings2Cell> rows=new ArrayList<>();collectRows(root,rows);assertEquals(10,rows.size());
    for(Settings2Cell row:rows){assertEquals(SettingsCardStyle.INSET,row.getLeft());assertEquals(440-SettingsCardStyle.INSET,row.getRight());}
   }
  }
 }
 @Test public void unionScopesAdmitEachOriginalPreferenceOnce(){for(String source:new String[]{"chats","appearance","general","other"}){var union=new Settings2Policy.Rows(source,"messages|post_appearance|menus|media|stickers|chat_list|avatars|folders|general|profile|archive");for(var entry:Settings2Policy.inventory().entrySet()){if(!entry.getKey().startsWith(source+":"))continue;String key=entry.getKey().substring(source.length()+1);boolean expected=Arrays.asList("messages","post_appearance","menus","media","stickers","chat_list","avatars","folders","general","profile","archive").contains(entry.getValue());assertEquals(key,expected,union.named(key));assertEquals(expected,union.anonymous());}union.reset();assertFalse(union.anonymous());}}
 @Test public void nativeTilesKeepWhiteSymbolsAndCategoryColoursInBothThemes(){for(boolean dark:new boolean[]{false,true}){
  Theme.dark=dark;Settings2Cell row=new Settings2Cell(activity,null);row.bind("Chat","Description",R.drawable.settings3_chat,0,false);
  ImageView icon=(ImageView)row.getChildAt(0);assertTrue(icon.getDrawable() instanceof SettingsCategoryIcon);assertEquals(24,icon.getDrawable().getIntrinsicWidth());
  Bitmap bitmap=Bitmap.createBitmap(32,32,Bitmap.Config.ARGB_8888);icon.getDrawable().setBounds(0,0,32,32);icon.getDrawable().draw(new Canvas(bitmap));
  int white=0,green=0;for(int x=0;x<32;x++)for(int y=0;y<32;y++){int color=bitmap.getPixel(x,y);if(Color.alpha(color)>200){if(Color.red(color)>240&&Color.green(color)>240&&Color.blue(color)>240)white++;if(Color.green(color)>Color.red(color)+30&&Color.green(color)>Color.blue(color)+30)green++;}}
  assertTrue("native filled white glyph",white>10);assertTrue("green category tile",green>100);bitmap.recycle();
  assertEquals(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText),((TextView)row.getChildAt(1)).getCurrentTextColor());
 }}
 @Test public void groupedRootKeepsCardsAfterRealBaseBindingAndUsesSmallerIconsWithoutArrows(){
  for(boolean dark:new boolean[]{false,true}){
   Theme.dark=dark;var page=new SignatureSettingsActivity();page.onFragmentCreate();View root=page.createView(activity);
   List<Settings2Cell> rows=new ArrayList<>();collectRows(root,rows);assertEquals(10,rows.size());
   for(var row:rows){assertNotNull("The base adapter must not erase its card",row.getBackground());assertEquals(3,row.getChildCount());
    row.measure(View.MeasureSpec.makeMeasureSpec(400,View.MeasureSpec.EXACTLY),0);row.layout(0,0,400,row.getMeasuredHeight());
    assertEquals(24,row.getChildAt(0).getMeasuredWidth());assertTrue(row.getHeight()>=48);
   }
  }
 }
 void collectRows(View v,List<Settings2Cell> rows){if(v instanceof Settings2Cell)rows.add((Settings2Cell)v);else if(v instanceof ViewGroup)for(int i=0;i<((ViewGroup)v).getChildCount();i++)collectRows(((ViewGroup)v).getChildAt(i),rows);}
 @Test public void actualCardPainterHasDifferentFirstMiddleLastAndSingleCorners(){
  for(boolean dark:new boolean[]{false,true}){
   Theme.dark=dark;var painter=new SettingsCardBackground();
   for(int[] corners:new int[][]{{28,6},{6,6},{6,28},{28,28}}){
    Bitmap b=Bitmap.createBitmap(200,48,Bitmap.Config.ARGB_8888);painter.draw(new Canvas(b),new RectF(0,0,200,48),corners[0],corners[1],1);
    assertEquals(corners[0]==28?0:255,Color.alpha(b.getPixel(2,2)));
    assertEquals(corners[1]==28?0:255,Color.alpha(b.getPixel(2,45)));
    assertNotEquals(Theme.getColor(Theme.key_windowBackgroundGray),b.getPixel(100,24));b.recycle();
   }
  }
 }
 @Test public void universalSettingsKeepHeadersAndTransparentRowsOutsideCards(){
  var list=new org.telegram.ui.Components.UniversalRecyclerView(activity);SettingsCardLists.apply(list,null);
  assertTrue(list.forced);assertFalse(list.adapter.applyBackground);assertEquals(12,list.inset);assertEquals(28f,list.radius,0);
  assertFalse(list.type.test(1));assertFalse(list.type.test(4));assertTrue(list.type.test(2));
  View v=new View(activity);var holder=new RecyclerListView.Holder(v);v.setTag(holder);list.addView(v);
  assertTrue(list.content.test(v));v.setTag(R.id.transparent_tag,true);assertFalse(list.content.test(v));
 }
 @Test public void sectionTypesStayCorrectWithoutAttachingOrMeasuringNeighbors(){
  var merged=new NativeSectionsAdapter();merged.add(new Owner(activity,3,4),new Child(activity,3,4));merged.add(new Owner(activity,3,2),new Child(activity,3,2));
  assertFalse(merged.isSettingsContentType(4));assertTrue(merged.isSettingsContentType(4098));assertFalse(merged.isSettingsContentType(-1));assertFalse(merged.isSettingsContentType(100000));
  var list=new app.exteraless.appearance.SectionCardRecyclerView(activity);list.setAdapter(merged);list.setSections(0,0,true);
  assertTrue(list.forced);assertFalse(list.type.test(4));assertTrue(list.type.test(4098));
  View header=new org.telegram.ui.Cells.HeaderCell(activity);assertFalse(list.content.test(header));
  View ordinary=new View(activity);assertTrue(list.content.test(ordinary));ordinary.setTag(RecyclerListView.TAG_NOT_SECTION);assertFalse(list.content.test(ordinary));merged.close();
 }
 @Test public void textScalingAndRtlKeepAccessibleBounds(){for(boolean compact:new boolean[]{false,true})for(boolean rtl:new boolean[]{false,true})for(float scale:new float[]{1f,1.5f,2f}){LocaleController.isRTL=rtl;activity.getResources().getDisplayMetrics().scaledDensity=scale;var row=new Settings2Cell(activity,null,compact);row.bind("A very long settings label with wrapping","Long explanation that must remain readable",R.drawable.settings3_hand,0,false);row.measure(View.MeasureSpec.makeMeasureSpec(320,View.MeasureSpec.EXACTLY),0);row.layout(0,0,320,row.getMeasuredHeight());assertTrue(row.getHeight()>=(compact?48:72));for(int i=0;i<row.getChildCount();i++){View v=row.getChildAt(i);assertTrue(v.getLeft()>=0);assertTrue(v.getRight()<=320);assertTrue(v.getBottom()<=row.getHeight());}}}
 static class Owner implements NativeSettingsSection {
  final Child adapter;int clicked=-1;Owner(Context c,int count,int type){adapter=new Child(c,count,type);}
  public RecyclerListView.SelectionAdapter prepareSettings3(BaseFragment f,RecyclerListView l){return adapter;}
  public void settings3Click(View v,int p,float x,float y){clicked=p;}public boolean settings3LongClick(View v,int p,float x,float y){clicked=p;return true;}
  public boolean settings3Enabled(int p,RecyclerView.ViewHolder h){return p!=0&&h.getItemViewType()==adapter.type;}
  public BaseFragment settings3Controller(){return null;}public void releaseSettings3(){}
 }
 static class Child extends RecyclerListView.SelectionAdapter implements SettingsSectionTypes {public boolean isSettingsContentType(int type){return type!=4;}final Context context;int count,type,lastType=-1,lastBind=-1,recycled;Child(Context c,int n,int t){context=c;count=n;type=t;}public int getItemCount(){return count;}public int getItemViewType(int p){return type;}public RecyclerView.ViewHolder onCreateViewHolder(ViewGroup p,int t){lastType=t;return new RecyclerListView.Holder(new TextView(context));}public void onBindViewHolder(RecyclerView.ViewHolder h,int p){assertEquals(type,h.getItemViewType());lastBind=p;}public boolean isEnabled(RecyclerView.ViewHolder h){return true;}public void onViewRecycled(RecyclerView.ViewHolder h){recycled++;}}
 @Test public void localTypesPositionsClicksAndRecyclingAreIsolated(){var merged=new NativeSectionsAdapter();Owner a=new Owner(activity,3,100),b=new Owner(activity,4,100);merged.add(a,a.adapter);merged.add(b,b.adapter);assertEquals(7,merged.getItemCount());assertNotEquals(merged.getItemViewType(1),merged.getItemViewType(4));var parent=new FrameLayout(activity);var holder=merged.createViewHolder(parent,merged.getItemViewType(4));merged.bindViewHolder(holder,4);assertEquals(100,b.adapter.lastType);assertEquals(1,b.adapter.lastBind);assertTrue(merged.isEnabled(holder));merged.click(holder.itemView,4,0,0);assertEquals(1,b.clicked);assertEquals(-1,a.clicked);merged.onViewRecycled(holder);assertEquals(1,b.adapter.recycled);assertTrue(merged.longClick(holder.itemView,5,0,0));assertEquals(2,b.clicked);merged.close();merged.onViewRecycled(holder);}
 @Test public void conditionalRowsNotifyCorrectGlobalOffsetsAndStopAfterClose(){var merged=new NativeSectionsAdapter();Owner a=new Owner(activity,3,4),b=new Owner(activity,2,4);merged.add(a,a.adapter);merged.add(b,b.adapter);List<String> events=new ArrayList<>();merged.registerAdapterDataObserver(new RecyclerView.AdapterDataObserver(){public void onItemRangeInserted(int p,int n){events.add("insert:"+p+":"+n);}public void onItemRangeRemoved(int p,int n){events.add("remove:"+p+":"+n);}});b.adapter.count++;b.adapter.notifyItemInserted(1);assertEquals("insert:4:1",events.get(0));a.adapter.count++;a.adapter.notifyItemInserted(0);merged.click(null,5,0,0);assertEquals(1,b.clicked);b.adapter.count--;b.adapter.notifyItemRemoved(1);assertEquals("remove:5:1",events.get(2));assertEquals(6,merged.getItemCount());merged.close();int size=events.size();b.adapter.notifyItemInserted(0);assertEquals(size,events.size());}
 @Test public void originalFlexyFilesOptInPersistsWithoutTouchingOtherKeys(){var prefs=activity.getSharedPreferences("flexyfiles_local",0);prefs.edit().putBoolean("enabled",true).putString("untouched","keep").apply();var page=new SignatureFlexyFilesActivity();page.onFragmentCreate();page.createView(activity);page.click(page.rowKeys().get("flexyfilesEnabled"));assertFalse(app.flexygram.files.FlexyFiles.enabled());assertEquals("keep",prefs.getString("untouched",null));var next=new SignatureFlexyFilesActivity();next.onFragmentCreate();assertFalse(app.flexygram.files.FlexyFiles.enabled());}
 @Test public void studioKeepsTransferActionsAndTheApprovedMotionPreference(){var page=new app.flexygram.studio.FlexyStudioActivity();page.onFragmentCreate();assertEquals(new HashSet<>(Arrays.asList("flexystudioExport","flexystudioImport","flexystudioShare","flexystudioFastMotion")),page.rowKeys().keySet());}
 @Test public void renderActualRootInBothThemes()throws Exception{for(boolean dark:new boolean[]{false,true}){Theme.dark=dark;var page=new SignatureSettingsActivity();page.onFragmentCreate();draw(page.createView(activity),"root-"+(dark?"dark":"light"));}}
 @Test public void presetCardsChooseOnlyTheTappedStyleAndSurviveRecreation(){
  for(boolean header:new boolean[]{false,true}){
   if(header)app.flexygram.header.HeaderConfig.style(1);else app.flexygram.composer.FlexyComposerConfig.setStyle(0);
   var page=new ConversationStyleSettingsActivity(header);page.onFragmentCreate();View root=page.createView(activity);
   List<StylePreviewCard> cards=new ArrayList<>();cards(root,cards);assertEquals(header?5:2,cards.size());assertTrue(cards.get(0).isSelected());
   cards.get(cards.size()-1).performClick();assertTrue(cards.get(cards.size()-1).isSelected());assertFalse(cards.get(0).isSelected());
   assertEquals(header?4:1,header?app.flexygram.header.HeaderConfig.style():app.flexygram.composer.FlexyComposerConfig.compact()?1:0);
   var saved=new android.os.Bundle();page.saveSelfArgs(saved);var next=new ConversationStyleSettingsActivity();next.restoreSelfArgs(saved);next.onFragmentCreate();
   List<StylePreviewCard> restored=new ArrayList<>();cards(next.createView(activity),restored);assertEquals(cards.size(),restored.size());assertTrue(restored.get(restored.size()-1).isSelected());
  }
 }
 void cards(View v,List<StylePreviewCard> out){if(v instanceof StylePreviewCard)out.add((StylePreviewCard)v);if(v instanceof ViewGroup)for(int i=0;i<((ViewGroup)v).getChildCount();i++)cards(((ViewGroup)v).getChildAt(i),out);}
 void draw(View view,String name)throws Exception{int width=440;view.measure(View.MeasureSpec.makeMeasureSpec(width,View.MeasureSpec.EXACTLY),View.MeasureSpec.makeMeasureSpec(4000,View.MeasureSpec.AT_MOST));view.layout(0,0,width,view.getMeasuredHeight());Bitmap b=Bitmap.createBitmap(width,view.getHeight(),Bitmap.Config.ARGB_8888);Canvas canvas=new Canvas(b);canvas.drawColor(Theme.getColor(Theme.key_windowBackgroundGray));view.draw(canvas);try(var out=new FileOutputStream(new File(System.getProperty("probe.root"),"settings3-"+name+"-isolated.png"))){assertTrue(b.compress(Bitmap.CompressFormat.PNG,100,out));}b.recycle();}
}
