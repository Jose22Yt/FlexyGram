import android.app.*;import android.content.*;import android.graphics.*;import android.view.*;import android.widget.*;
import app.flexygram.bubbles.interaction.*;import app.flexygram.bubbles.interaction.BubbleActionPanelView.Action;
import app.flexygram.settings.SignatureMatteSettingsActivity;import org.telegram.ui.ActionBar.Theme;
import java.util.*;import java.io.*;import java.lang.reflect.*;
import org.junit.*;import static org.junit.Assert.*;import org.junit.runner.RunWith;import org.robolectric.*;import org.robolectric.annotation.*;
@RunWith(RobolectricTestRunner.class) @Config(sdk=35,manifest=Config.NONE) @GraphicsMode(GraphicsMode.Mode.NATIVE)
public class MessageMenuAndroidTest {
 Activity activity;int dp(float n){return(int)(n*activity.getResources().getDisplayMetrics().density+.5f);}
 @Before public void setup(){activity=Robolectric.buildActivity(Activity.class).setup().get();SignatureMatteSettingsActivity.activity=activity;activity.getSharedPreferences(BubbleMenuConfig.FILE,0).edit().clear().commit();BubbleInteractionSettings.reload();Theme.dark=false;}
 @After public void finish(){activity.finish();}
 void layout(View view,int width){view.measure(View.MeasureSpec.makeMeasureSpec(dp(width),View.MeasureSpec.EXACTLY),View.MeasureSpec.makeMeasureSpec(0,View.MeasureSpec.UNSPECIFIED));view.layout(0,0,view.getMeasuredWidth(),view.getMeasuredHeight());}
 List<View> actions(View view){List<View> result=new ArrayList<>();if(view.getTag() instanceof Action)result.add(view);if(view instanceof ViewGroup){ViewGroup g=(ViewGroup)view;for(int i=0;i<g.getChildCount();i++)result.addAll(actions(g.getChildAt(i)));}return result;}
 BubbleActionPanelView panel(int style,EnumSet<Action> permitted,EnumSet<Action> chosen){var panel=new BubbleActionPanelView(activity,null,style,chosen);panel.setAllowedActions(permitted);layout(panel,260);return panel;}
 @Test public void everyMenuStyleUsesSharedBackdropAndCanReturnToSolid() {
  for(int style=0;style<4;style++){
   var panel=new BubbleActionPanelView(activity,null,style,BubbleMenuConfig.defaults());
   List<View> surfaces=new ArrayList<>();
   panel.setSurfaceFactory((view,radius)->{surfaces.add(view);return new android.graphics.drawable.ColorDrawable(0x80304050);});
   panel.setAllowedActions(EnumSet.allOf(Action.class));layout(panel,260);
   assertEquals(new int[]{1,2,3,2}[style],surfaces.size());
   for(View view:surfaces)assertEquals(0x80304050,((android.graphics.drawable.ColorDrawable)view.getBackground()).getColor());
   int[] samples=new int[2];int i=0;
   for(int under:new int[]{Color.RED,Color.BLUE}){
    Bitmap b=Bitmap.createBitmap(panel.getWidth(),panel.getHeight(),Bitmap.Config.ARGB_8888);
    Canvas c=new Canvas(b);c.drawColor(under);panel.draw(c);samples[i++]=b.getPixel(dp(1),dp(20));b.recycle();
   }
   assertNotEquals("no opaque card hides the backdrop",samples[0],samples[1]);
   panel.setSurfaceFactory(null);panel.setAllowedActions(EnumSet.allOf(Action.class));layout(panel,260);
   View first=style==0?panel:((ViewGroup)panel).getChildAt(0);
   assertTrue(first.getBackground() instanceof android.graphics.drawable.GradientDrawable);
   assertEquals(7,actions(panel).size());
  }
 }
 @Test public void fullWindowBackdropCoversInputAndDismissRestoresUnderlyingPixels() {
  Bitmap live=Bitmap.createBitmap(100,120,Bitmap.Config.ARGB_8888);live.eraseColor(Color.BLUE);
  Bitmap backdrop=Bitmap.createBitmap(10,12,Bitmap.Config.ARGB_8888);backdrop.eraseColor(Color.YELLOW);
  for(int alpha:new int[]{0,128,255}) {
   Bitmap frame=live.copy(Bitmap.Config.ARGB_8888,true);Canvas c=new Canvas(frame);
   Paint p=new Paint();p.setShader(new BitmapShader(backdrop,Shader.TileMode.CLAMP,Shader.TileMode.CLAMP));p.setAlpha(alpha);
   int save=c.save();c.drawRect(0,0,100,120,p);c.restoreToCount(save);
   assertEquals("Composer and chat receive identical backdrop coverage",frame.getPixel(50,0),frame.getPixel(50,119));
   if(alpha==255)assertEquals(Color.YELLOW,frame.getPixel(50,119));
   if(alpha==0)assertTrue(live.sameAs(frame));
   assertEquals("Live composer pixels were never modified",Color.BLUE,live.getPixel(50,119));
   frame.recycle();
  }
  live.recycle();backdrop.recycle();
 }
 @Test public void wholeSelectionScrollsWithOriginalMessageSizeAndCompleteBackground() {
  for(int messageHeight:new int[]{120,450,6000}) {
   int[] offset={0};var scroll=new MessageMenuScrollView(activity,y->offset[0]=y);
   LinearLayout content=new LinearLayout(activity);content.setOrientation(1);
   View reactions=new View(activity),bubble=new View(activity),actions=new View(activity);
   content.addView(reactions,new LinearLayout.LayoutParams(320,64));
   bubble.setBackgroundColor(Color.GREEN);content.addView(bubble,new LinearLayout.LayoutParams(320,messageHeight));
   content.addView(actions,new LinearLayout.LayoutParams(320,240));scroll.addView(content);
   scroll.setViewportHeight(700);layout(scroll,320);
   assertEquals(messageHeight,bubble.getHeight());assertEquals(1f,bubble.getScaleX(),0f);
   assertEquals(64+messageHeight+240,content.getHeight());assertTrue(scroll.getHeight()<=700);
   int range=Math.max(0,content.getHeight()-scroll.getHeight());scroll.scrollTo(0,range);
   assertEquals(range,scroll.getScrollY());assertEquals(range,offset[0]);
   assertEquals(content.getHeight(),actions.getBottom());scroll.scrollTo(0,0);assertEquals(0,offset[0]);
  }
 }
 @Test public void productionOverlayRedrawPreservesComposerAboveBlurWithoutChangingAlpha() {
  ComposerOverlayProbe host=new ComposerOverlayProbe(activity);
  host.measure(View.MeasureSpec.makeMeasureSpec(100,View.MeasureSpec.EXACTLY),View.MeasureSpec.makeMeasureSpec(120,View.MeasureSpec.EXACTLY));host.layout(0,0,100,120);
  Bitmap frame=Bitmap.createBitmap(100,120,Bitmap.Config.ARGB_8888);frame.eraseColor(Color.YELLOW);
  Canvas canvas=new Canvas(frame);int save=canvas.getSaveCount();host.redraw(canvas);
  assertEquals(Color.CYAN,frame.getPixel(50,110));assertEquals(Color.YELLOW,frame.getPixel(50,80));
  assertEquals(1f,host.chatInputViewsContainer.getAlpha(),0f);assertEquals(View.VISIBLE,host.chatInputViewsContainer.getVisibility());assertEquals(save,canvas.getSaveCount());
  frame.eraseColor(Color.YELLOW);host.scrimViewProgress=0;host.redraw(canvas);assertEquals(Color.YELLOW,frame.getPixel(50,110));
  host.scrimViewProgress=1;host.selectedBubbleMotionMessage=null;host.redraw(canvas);assertEquals(Color.YELLOW,frame.getPixel(50,110));frame.recycle();
 }
 @Test public void selectedMenuHasOneNativeFrameClockAndInterruptsCleanly() {
  int[] draws={0},done={0};var motion=new SelectedBubbleMotion();
  motion.enter(()->draws[0]++);assertEquals(.94f,motion.panelScale(),.0001f);assertEquals(8f,motion.panelOffset(),.001f);
  org.robolectric.Shadows.shadowOf(android.os.Looper.getMainLooper()).idleFor(java.time.Duration.ofMillis(350));
  assertFalse(motion.isRunning());assertEquals(1f,motion.panelScale(),0f);assertTrue(draws[0]>2);
  motion.close(()->done[0]++);motion.finishImmediately();motion.finishImmediately();assertEquals(1,done[0]);
  int stopped=draws[0];org.robolectric.Shadows.shadowOf(android.os.Looper.getMainLooper()).idleFor(java.time.Duration.ofMillis(350));
  assertEquals(stopped,draws[0]);assertFalse(motion.hasOwner());
 }
 @Test public void selectedMenuReentryReleasesOnlyThePreviousOwner() {
  int[] first={0},next={0},cleanup={0};var motion=new SelectedBubbleMotion();
  motion.enter(()->first[0]++);motion.close(()->cleanup[0]++);
  motion.enter(()->next[0]++);int old=first[0];assertEquals(1,cleanup[0]);
  org.robolectric.Shadows.shadowOf(android.os.Looper.getMainLooper()).idleFor(java.time.Duration.ofMillis(350));
  assertEquals(old,first[0]);assertTrue(next[0]>1);assertEquals(1f,motion.panelScale(),0);
  motion.reset();assertFalse(motion.hasOwner());
 }
 @Test public void lateBackdropFadesOnTheExistingClockWithoutRestartingTheCard() {
  var motion=new SelectedBubbleMotion();java.util.List<Float> samples=new java.util.ArrayList<>();motion.enter(()->samples.add(motion.backdropProgress()));
  org.robolectric.Shadows.shadowOf(android.os.Looper.getMainLooper()).idleFor(java.time.Duration.ofMillis(350));
  assertFalse(motion.isRunning());assertEquals(1f,motion.panelScale(),0);
  samples.clear();motion.backdropReady();assertTrue(motion.isRunning());assertEquals(0f,motion.backdropProgress(),0);
  org.robolectric.Shadows.shadowOf(android.os.Looper.getMainLooper()).idleFor(java.time.Duration.ofMillis(64));
  assertEquals(1f,motion.panelScale(),0);
  int intermediate=0;float previous=0;
  for(float sample:samples){assertTrue(sample>=previous);assertTrue(sample-previous<.25f);if(sample>0&&sample<1)intermediate++;previous=sample;}
  assertTrue("native frames must crossfade, not jump",intermediate>=4);
  org.robolectric.Shadows.shadowOf(android.os.Looper.getMainLooper()).idleFor(java.time.Duration.ofMillis(350));
  assertEquals(1f,motion.backdropProgress(),0);assertFalse(motion.isRunning());
  motion.close();motion.finishImmediately();assertEquals(0f,motion.backdropProgress(),0);motion.backdropReady();assertFalse(motion.isRunning());
 }
 @Test public void actualScrimProcessingDefersPixelsAndPublishesOwnedBitmapsOnUiQueue() {
  Bitmap[] result={null,null};int[] calls={0};
  AsyncScrimProbe.makeGlobalBlurBitmaps((bg,options)->{result[0]=bg;result[1]=options;calls[0]++;},true);
  assertTrue(AsyncScrimProbe.AndroidUtilities.requestedAsync);assertEquals(0,calls[0]);
  AsyncScrimProbe.Utilities.themeQueue.drain();assertEquals(0,calls[0]);assertTrue(AsyncScrimProbe.AndroidUtilities.original.isRecycled());
  AsyncScrimProbe.AndroidUtilities.ui.drain();assertEquals(1,calls[0]);assertNotNull(result[0]);assertNotSame(result[0],result[1]);
  assertFalse(result[0].isRecycled());assertFalse(result[1].isRecycled());result[0].recycle();result[1].recycle();
 }
 @Test public void actualCaptureReturnsBeforePixelBlurAndRestoresTheCaptureFlag() {
  var view=new View(activity){public void draw(Canvas canvas){assertTrue(NativeCaptureProbe.makingGlobalBlurBitmap);canvas.drawColor(Color.RED);}};
  view.layout(0,0,120,240);NativeCaptureProbe.views=java.util.List.of(view);NativeCaptureProbe.Utilities.blurs=0;
  Bitmap[] result={null};NativeCaptureProbe.makeGlobalBlurBitmap(b->result[0]=b,15,15,null,null,true);
  assertFalse(NativeCaptureProbe.makingGlobalBlurBitmap);assertNull(result[0]);assertEquals(0,NativeCaptureProbe.Utilities.blurs);
  NativeCaptureProbe.Utilities.themeQueue.drain();assertNotNull(result[0]);assertEquals(1,NativeCaptureProbe.Utilities.blurs);
  assertTrue(NativeCaptureProbe.AndroidUtilities.ui.tasks.isEmpty());assertEquals(Color.RED,result[0].getPixel(1,1));result[0].recycle();
  result[0]=null;NativeCaptureProbe.Utilities.blurs=0;
  NativeCaptureProbe.makeGlobalBlurBitmap(b->result[0]=b,15,15,null,null,false);
  assertNotNull(result[0]);assertEquals(1,NativeCaptureProbe.Utilities.blurs);assertFalse(NativeCaptureProbe.makingGlobalBlurBitmap);result[0].recycle();
 }
 @Test public void choicesPersistAndNeverGrantUnavailableActions(){
  for(int style=0;style<4;style++){BubbleMenuConfig.layout(activity,style);assertEquals(style,BubbleMenuConfig.layout(activity));assertTrue(BubbleInteractionSettings.signaturePanel(activity));}
  BubbleMenuConfig.actions(activity,EnumSet.of(Action.COPY,Action.SAVE));assertEquals(EnumSet.of(Action.COPY,Action.SAVE),BubbleMenuConfig.actions(activity));
  for(int style=0;style<4;style++){
   var panel=panel(style,EnumSet.of(Action.REPLY,Action.COPY),BubbleMenuConfig.actions(activity));List<Action> clicked=new ArrayList<>();panel.setListener(clicked::add);
   var rows=actions(panel);assertEquals(2,rows.size());for(View row:rows)row.performClick();assertEquals(EnumSet.of(Action.COPY,Action.MORE),EnumSet.copyOf(clicked));
  }
  activity.getSharedPreferences(BubbleMenuConfig.FILE,0).edit().putStringSet(BubbleMenuConfig.ACTIONS,Set.of("UNKNOWN","COPY")).commit();assertEquals(EnumSet.of(Action.COPY),BubbleMenuConfig.actions(activity));
  BubbleMenuConfig.actions(activity,EnumSet.noneOf(Action.class));for(int style=0;style<4;style++)assertEquals(Action.MORE,actions(panel(style,EnumSet.allOf(Action.class),BubbleMenuConfig.actions(activity))).get(0).getTag());
 }
 @Test public void layoutsMatchGridGroupsAndToolbarAndStayLegibleInBothThemes()throws Exception{
  for(boolean dark:new boolean[]{false,true})for(int style=0;style<4;style++){
   Theme.dark=dark;var panel=panel(style,EnumSet.allOf(Action.class),BubbleMenuConfig.defaults());assertEquals(7,actions(panel).size());
   if(style==BubbleMenuConfig.GROUPS){assertEquals(3,panel.getChildCount());assertEquals(2,actions(panel.getChildAt(0)).size());assertEquals(3,actions(panel.getChildAt(1)).size());assertEquals(2,actions(panel.getChildAt(2)).size());}
   if(style==BubbleMenuConfig.GRID){assertEquals(2,panel.getChildCount());assertEquals(6,actions(panel.getChildAt(0)).size());assertEquals(Action.MORE,actions(panel.getChildAt(1)).get(0).getTag());}
   if(style==BubbleMenuConfig.TOOLBAR){assertEquals(2,panel.getChildCount());assertEquals(List.of(Action.REPLY,Action.COPY,Action.FORWARD),actions(panel.getChildAt(0)).stream().map(v->(Action)v.getTag()).toList());}
   for(View row:actions(panel)){assertTrue(row.getMeasuredHeight()>=dp(44));assertTrue(row.getWidth()>0);assertTrue(row.isClickable());assertNotNull(row.getContentDescription());}
   Bitmap bitmap=Bitmap.createBitmap(panel.getWidth(),panel.getHeight(),Bitmap.Config.ARGB_8888);Canvas canvas=new Canvas(bitmap);canvas.drawColor(Theme.getColor(Theme.key_windowBackgroundGray));panel.draw(canvas);
   try(var out=new FileOutputStream(new File(System.getProperty("probe.root"),"menu-"+style+"-"+(dark?"dark":"light")+"-native.png"))){assertTrue(bitmap.compress(Bitmap.CompressFormat.PNG,100,out));}bitmap.recycle();
   panel.setLayoutDirection(View.LAYOUT_DIRECTION_RTL);layout(panel,244);for(View row:actions(panel))assertTrue(row.getWidth()<=panel.getWidth());
  }
 }
 @Test public void miniatureTapChoosesTheRealRendererWithoutRunningAnAction(){
  var gallery=new BubbleMenuGallery(activity,null,()->{});layout(gallery,320);LinearLayout strip=(LinearLayout)gallery.getChildAt(0);assertEquals(4,strip.getChildCount());
  for(int style=0;style<4;style++){strip.getChildAt(style).performClick();assertEquals(style,BubbleMenuConfig.layout(activity));for(int other=0;other<4;other++)assertEquals(style==other,strip.getChildAt(other).isSelected());}
 }
 List<CheckBox> checks(View view){List<CheckBox> result=new ArrayList<>();if(view instanceof CheckBox)result.add((CheckBox)view);if(view instanceof ViewGroup){ViewGroup g=(ViewGroup)view;for(int i=0;i<g.getChildCount();i++)result.addAll(checks(g.getChildAt(i)));}return result;}
 @Test public void actionsDialogCancelApplyAndResetAreAtomic()throws Exception{
  BubbleInteractionSettingsActivity page=new BubbleInteractionSettingsActivity();page.createView(activity);Field field=BubbleInteractionSettingsActivity.class.getDeclaredField("actionsRow");field.setAccessible(true);int position=field.getInt(page);
  page.click(position);List<CheckBox> checks=checks(page.dialog.getWindow().getDecorView());assertEquals(Action.values().length-1,checks.size());checks.get(0).toggle();page.dialog.getButton(DialogInterface.BUTTON_NEGATIVE).performClick();Shadows.shadowOf(android.os.Looper.getMainLooper()).idle();assertEquals(BubbleMenuConfig.defaults(),BubbleMenuConfig.actions(activity));
  page.click(position);checks(page.dialog.getWindow().getDecorView()).get(0).toggle();page.dialog.getButton(DialogInterface.BUTTON_POSITIVE).performClick();Shadows.shadowOf(android.os.Looper.getMainLooper()).idle();assertFalse(BubbleMenuConfig.actions(activity).contains(Action.REPLY));
  page.click(position);page.dialog.getButton(DialogInterface.BUTTON_NEUTRAL).performClick();Shadows.shadowOf(android.os.Looper.getMainLooper()).idle();assertEquals(BubbleMenuConfig.defaults(),BubbleMenuConfig.actions(activity));
 }
 @Test public void reactionsStayAboveReadableViewportAndMenuBelowEvenOnShortWindows(){
  for(int style=0;style<4;style++)for(int available:new int[]{280,440,800})for(int height:new int[]{24,200,6000}){
   var panel=panel(style,EnumSet.allOf(Action.class),BubbleMenuConfig.defaults());int menu=Math.min(panel.getMeasuredHeight(),available-72-32);int chrome=72+menu;
   var placement=ContextPreviewPlacement.fit(600,height,100,100+available,chrome,72,8);
   float bubbleTop=600+height*(1-placement.scale)*.5f+placement.offsetY,bubbleBottom=bubbleTop+placement.viewportHeight;
   assertTrue(bubbleTop>=placement.popupY+64+8);assertTrue(bubbleBottom<=placement.popupY+72+placement.gapHeight+.01f);
   assertTrue(placement.popupY+Math.min(available,chrome+placement.gapHeight)<=100+available);
  }
 }
}
