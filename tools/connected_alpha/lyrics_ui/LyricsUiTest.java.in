package app.exteraless.player;
import android.app.*;import android.graphics.*;import android.os.*;import android.view.*;import android.widget.*;import java.lang.reflect.*;import java.io.*;import java.time.Duration;
import org.junit.*;import org.junit.runner.RunWith;import org.robolectric.*;import org.robolectric.annotation.*;import org.telegram.messenger.*;import org.telegram.messenger.MediaController;import org.telegram.ui.ActionBar.Theme;import org.telegram.ui.Components.RecyclerListView;import static org.junit.Assert.*;
@RunWith(RobolectricTestRunner.class) @Config(manifest=Config.NONE,sdk=35) @GraphicsMode(GraphicsMode.Mode.NATIVE)
public class LyricsUiTest{
 Activity activity;FrameLayout root;LyricsView view;long clock;
 @Before public void setup(){activity=Robolectric.buildActivity(Activity.class).setup().get();root=new FrameLayout(activity);activity.setContentView(root);view=new LyricsView(activity);root.addView(view,new FrameLayout.LayoutParams(360,600));Theme.dark=false;MediaController.getInstance().paused=false;view.setColors(PlayerColors.fromSeed(0,false));view.setPositionProvider(()->clock);size();}
 void size(){root.measure(View.MeasureSpec.makeMeasureSpec(360,View.MeasureSpec.EXACTLY),View.MeasureSpec.makeMeasureSpec(680,View.MeasureSpec.EXACTLY));root.layout(0,0,360,680);}
 Object field(Object o,String name)throws Exception{Field f=o.getClass().getDeclaredField(name);f.setAccessible(true);return f.get(o);}
 Lyrics lines(){return Lyrics.parse("[00:00.00]I am so alone\n[00:02.00]Nothing feels like home\n[00:04.00]I am so alone\n[00:06.00]Trying to find my way",Lyrics.SOURCE_FILE);}
 void render(){size();view.draw(new Canvas(Bitmap.createBitmap(360,600,Bitmap.Config.ARGB_8888)));}
 @After public void cleanup(){root.removeAllViews();}
 @Test public void actualClockSeeksForwardBackwardAndPausedWithoutEstimatingVerseTiming()throws Exception{view.setLyrics(lines(),0);render();assertEquals(0,field(view,"active"));clock=4300;Shadows.shadowOf(Looper.getMainLooper()).idleFor(Duration.ofMillis(180));assertEquals(2,field(view,"active"));clock=2100;view.setPosition(clock);assertEquals(1,field(view,"active"));MediaController.getInstance().paused=true;clock=6500;view.setPosition(clock);assertEquals(3,field(view,"active"));}
 @Test public void timedVerseClickSeeksButPlainTextCannotPretendToBeSynced()throws Exception{long[] sought={-1};view.setDelegate(new LyricsView.Delegate(){public void onAction(int state){}public void onSeek(long ms){sought[0]=ms;}});view.setLyrics(lines(),0);render();RecyclerListView list=(RecyclerListView)field(view,"list");list.click.onItemClick(view,2);assertEquals(4000,sought[0]);view.setLyrics(Lyrics.parse("Plain words\nWithout timestamps",Lyrics.SOURCE_FILE),0);list.click.onItemClick(view,1);assertEquals(4000,sought[0]);view.setPosition(9000);assertEquals(-1,field(view,"active"));}
 @Test public void manualReadingWaitsForFollowAndVerseViewsAreReadableWithoutBlur()throws Exception{view.setLyrics(lines(),0);render();RecyclerListView list=(RecyclerListView)field(view,"list");list.simulateScrollState(androidx.recyclerview.widget.RecyclerView.SCROLL_STATE_DRAGGING);clock=6500;view.setPosition(clock);list.simulateScrollState(androidx.recyclerview.widget.RecyclerView.SCROLL_STATE_IDLE);Shadows.shadowOf(Looper.getMainLooper()).idleFor(Duration.ofSeconds(8));assertNotEquals(0L,field(view,"userScrollAt"));TextView follow=(TextView)field(view,"followButton");assertEquals(View.VISIBLE,follow.getVisibility());follow.performClick();assertEquals(0L,field(view,"userScrollAt"));assertEquals(View.GONE,follow.getVisibility());
 }
 @Test public void rendersActualVerseRowsWithAccentsInLightAndDarkAndDetachesClock()throws Exception{
  for(boolean dark:new boolean[]{false,true}){Theme.dark=dark;view.setColors(PlayerColors.fromSeed(0,dark));clock=2300;view.setLyrics(lines(),clock);Shadows.shadowOf(Looper.getMainLooper()).idleFor(Duration.ofMillis(20));render();RecyclerListView list=(RecyclerListView)field(view,"list");assertTrue(list.getChildCount()>0);for(int i=0;i<list.getChildCount();i++)assertEquals(0f,((Number)field(list.getChildAt(i),"blur")).floatValue(),0);Bitmap image=Bitmap.createBitmap(360,600,Bitmap.Config.ARGB_8888);image.eraseColor(dark?0xff11151c:0xfff7f8fa);view.draw(new Canvas(image));try(FileOutputStream out=new FileOutputStream(new File(System.getProperty("probe.root"),dark?"lyrics-dark.png":"lyrics-light.png"))){image.compress(Bitmap.CompressFormat.PNG,100,out);}}
  Object tick=field(view,"positionTick");root.removeView(view);clock=7000;Shadows.shadowOf(Looper.getMainLooper()).idleFor(Duration.ofSeconds(2));assertFalse(view.isAttachedToWindow());
 }
}
