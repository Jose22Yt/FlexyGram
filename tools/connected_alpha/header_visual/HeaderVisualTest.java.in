/* Native Android controller/views + extracted production avatar geometry methods.
 * ActionBar/navigation/theme/image decoding are explicit doubles. Not full chat/Poco acceptance. */
import android.app.Activity;import android.content.*;import android.content.res.*;import android.graphics.*;import android.os.*;import android.util.DisplayMetrics;import android.view.*;import android.widget.*;
import app.flexygram.header.*;import org.telegram.messenger.*;import org.telegram.ui.ActionBar.*;import org.telegram.ui.Components.ChatAvatarContainer;
import org.junit.*;import org.junit.runner.RunWith;import org.robolectric.*;import org.robolectric.annotation.*;import static org.junit.Assert.*;
@RunWith(RobolectricTestRunner.class) @Config(manifest=Config.NONE,sdk=35) @GraphicsMode(GraphicsMode.Mode.NATIVE)
public class HeaderVisualTest {
 private Activity activity;private FrameLayout root;
 @Before public void setup()throws Exception{activity=Robolectric.buildActivity(Activity.class).setup().get();root=new FrameLayout(activity);activity.setContentView(root);ApplicationLoader.applicationContext=activity;activity.getSharedPreferences("flexygram_header",0).edit().clear().commit();activity.getSharedPreferences("appearance",0).edit().clear().commit();HeaderConfig.load();AndroidUtilities.density=1;LocaleController.isRTL=false;Theme.dark=false;}
 private Context context(float font)throws Exception{AssetManager assets=AssetManager.class.getDeclaredConstructor().newInstance();assertTrue((Integer)AssetManager.class.getMethod("addAssetPath",String.class).invoke(assets,System.getProperty("probe.root")+"/resources.ap_")>0);DisplayMetrics m=new DisplayMetrics();m.density=1;m.densityDpi=160;m.scaledDensity=font;Configuration config=new Configuration();config.fontScale=font;Resources r=new Resources(assets,m,config);R.drawable.ic_ab_back=r.getIdentifier("ic_ab_back","drawable","app.flexygram.visualprobe");R.drawable.ic_ab_other=r.getIdentifier("ic_ab_other","drawable","app.flexygram.visualprobe");R.drawable.msg_callback=r.getIdentifier("msg_callback","drawable","app.flexygram.visualprobe");assertTrue(R.drawable.ic_ab_back!=0&&R.drawable.ic_ab_other!=0&&R.drawable.msg_callback!=0);return new ContextWrapper(activity){@Override public Resources getResources(){return r;}};}
 private void size(View view,int width){view.measure(View.MeasureSpec.makeMeasureSpec(width,View.MeasureSpec.EXACTLY),View.MeasureSpec.makeMeasureSpec(0,View.MeasureSpec.UNSPECIFIED));view.layout(0,0,width,view.getMeasuredHeight());}
 private Object field(Object target,String name)throws Exception{var f=target.getClass().getDeclaredField(name);f.setAccessible(true);return f.get(target);}
 private void tap(View parent,float x,float y){MotionEvent down=MotionEvent.obtain(0,0,MotionEvent.ACTION_DOWN,x,y,0),up=MotionEvent.obtain(0,1,MotionEvent.ACTION_UP,x,y,0);parent.dispatchTouchEvent(down);parent.dispatchTouchEvent(up);down.recycle();up.recycle();org.robolectric.Shadows.shadowOf(android.os.Looper.getMainLooper()).idle();}
 @Test public void nativeMeasuredPiecesAreEqualAndTitleCenterIsWindowCenter()throws Exception{
  for(float font:new float[]{1,1.5f,2,3})for(int width:new int[]{240,320,401,600})for(boolean rtl:new boolean[]{false,true}){
   LocaleController.isRTL=rtl;Context c=context(font);ActionBar bar=new ActionBar(c);ChatAvatarContainer avatar=new ChatAvatarContainer(c);bar.addView(avatar,0,new FrameLayout.LayoutParams(-1,-1));SignatureChatHeader header=new SignatureChatHeader(bar,avatar,null);bar.setSignatureHeader(header);avatar.setSignatureHeader(header);header.setCount(12345);size(bar,width);
   HeaderGeometry g=header.geometry;assertEquals(g.back.height(),g.title.height(),.001f);assertEquals(g.title.height(),g.avatar.height(),.001f);assertEquals(width/2f,g.title.centerX(),.001f);
   View title=(View)field(avatar,"titleTextView");View status=(View)field(avatar,"subtitleTextView");
   assertEquals(0,title.getPaddingTop());assertEquals(0,title.getPaddingBottom());
   assertTrue("title above surface: width="+width+" font="+font+" top="+title.getTop()+" surface="+g.title,title.getTop()>=g.title.top-.5f);
   assertTrue("status below surface: width="+width+" font="+font+" bottom="+status.getBottom()+" surface="+g.title,status.getBottom()<=g.title.bottom+.5f);
   assertTrue("text lines overlap",title.getBottom()<=status.getTop());
   assertEquals(width/2f,title.getLeft()+title.getWidth()/2f,.5f);assertTrue(bar.backButtonImageView.getHeight()>=48);assertEquals(g.back.centerY(),bar.backButtonImageView.getTop()+bar.backButtonImageView.getHeight()/2f,.5f);
   assertTrue(g.back.left>=0&&g.avatar.left>=0);assertTrue(g.back.right<=width&&g.avatar.right<=width);header.detach();
  }
 }
 @Test public void counterTextDoesNotStealBackTapsAndMenuAndProfileStayIndependent()throws Exception{
  Context c=context(1);ActionBar bar=new ActionBar(c);ChatAvatarContainer avatar=new ChatAvatarContainer(c);bar.addView(avatar,0,new FrameLayout.LayoutParams(-1,-1));SignatureChatHeader header=new SignatureChatHeader(bar,avatar,null);bar.setSignatureHeader(header);avatar.setSignatureHeader(header);header.setCount(3);root.addView(bar);size(bar,401);
  assertFalse(header.geometry.countVisible);assertEquals(2,bar.getChildCount());float x=header.geometry.back.right-4,y=header.geometry.back.centerY();for(int n=0;n<100;n++)tap(bar,x,y);assertEquals(100,bar.backs);assertEquals(0,avatar.profiles);
  tap(bar,header.geometry.avatar.centerX(),header.geometry.avatar.centerY());assertEquals(1,avatar.menus);assertEquals(0,avatar.profiles);
  tap(bar,header.geometry.title.centerX(),header.geometry.title.centerY());assertEquals(1,avatar.profiles);assertEquals(1,avatar.menus);
  header.setCount(-1);size(bar,401);assertFalse(header.geometry.countVisible);assertFalse(bar.backButtonImageView.getContentDescription().toString().contains("Unread"));
  bar.search=true;size(bar,401);assertFalse(header.active());assertEquals(2,bar.getChildCount());bar.search=false;bar.selection=true;size(bar,401);assertFalse(header.active());header.detach();header.detach();
 }
 @Test public void preferencesPreserveLegacyChoicesAndOnlyWriteTheirOwnFile(){
  var old=activity.getSharedPreferences("appearance",0);var prefs=activity.getSharedPreferences("flexygram_header",0);assertTrue(HeaderConfig.signature());
  old.edit().putBoolean("OEAppearanceIosChatHeader",false).commit();HeaderConfig.load();assertFalse(HeaderConfig.signature());
  old.edit().putBoolean("OEAppearanceIosChatHeaderAuto",true).commit();HeaderConfig.load();assertTrue(HeaderConfig.signature());
  var original=old.getAll();HeaderConfig.style(false);HeaderConfig.counter(false);HeaderConfig.compact(true);HeaderConfig.opacity(1000);HeaderConfig.load();assertFalse(HeaderConfig.signature());assertFalse(HeaderConfig.counter());assertTrue(HeaderConfig.compact());assertEquals(100,HeaderConfig.opacity());assertEquals(original,old.getAll());
  HeaderConfig.opacity(-20);assertEquals(0,HeaderConfig.opacity());prefs.edit().putString("opacity","corrupt").putString("style","corrupt").commit();HeaderConfig.load();assertEquals(85,HeaderConfig.opacity());assertTrue(HeaderConfig.signature());
 }
 @Test public void importedCounterOptionsCannotChangeTheThreePiecePreview()throws Exception{
  HeaderConfig.style(true);
  for(boolean rtl:new boolean[]{false,true})for(float font:new float[]{1,2,3}){
   LocaleController.isRTL=rtl;
   HeaderConfig.counterMode(0);HeaderPreviewView preview=new HeaderPreviewView(context(font));size(preview,320);
   Bitmap before=Bitmap.createBitmap(320,preview.getMeasuredHeight(),Bitmap.Config.ARGB_8888);preview.draw(new Canvas(before));
   for(int mode:new int[]{1,2}){
    HeaderConfig.counterMode(mode);preview.settingsChanged();size(preview,320);
    Bitmap after=Bitmap.createBitmap(320,preview.getMeasuredHeight(),Bitmap.Config.ARGB_8888);preview.draw(new Canvas(after));
    assertTrue("legacy counter must not change preview pixels",before.sameAs(after));after.recycle();
   }
   before.recycle();
  }
 }
 @Test public void renderSyntheticPreviewLightDarkAndOpacityChangesOnlySurface()throws Exception{
  Bitmap image=Bitmap.createBitmap(401,400,Bitmap.Config.ARGB_8888);Canvas canvas=new Canvas(image);
  for(int i=0;i<2;i++){Theme.dark=i==1;HeaderPreviewView preview=new HeaderPreviewView(context(1));size(preview,401);canvas.save();canvas.translate(0,i*200);preview.draw(canvas);canvas.restore();assertTrue(preview.getContentDescription().toString().contains("Alex"));HeaderConfig.opacity(0);preview.invalidate();preview.draw(new Canvas(Bitmap.createBitmap(401,200,Bitmap.Config.ARGB_8888)));HeaderConfig.opacity(85);}
  try(var file=new java.io.FileOutputStream(new java.io.File(System.getProperty("probe.root"),"signature-header-synthetic.png"))){assertTrue(image.compress(Bitmap.CompressFormat.PNG,100,file));}
 }
 @Test public void optionalFusionUsesNativeSizedPartsRoutesActionsAndRestoresAdaptive()throws Exception{
  HeaderConfig.style(2);Context c=context(1);ActionBar bar=new ActionBar(c);ChatAvatarContainer avatar=new ChatAvatarContainer(c);avatar.callable=true;bar.addView(avatar,0,new FrameLayout.LayoutParams(-1,-1));SignatureChatHeader header=new SignatureChatHeader(bar,avatar,null);bar.setSignatureHeader(header);avatar.setSignatureHeader(header);root.addView(bar);size(bar,401);
  assertTrue(header.fusionActive());var g=header.fusionGeometry();assertEquals(50,g.center.height(),.01f);assertEquals(46,g.back.height(),.01f);assertEquals(96,g.actions.width(),.01f);assertEquals(46,g.actions.height(),.01f);
  float backLeft=g.back.left,moreRight=g.more.right;tap(bar,g.back.centerX(),g.back.centerY()+header.fusionTop);assertEquals(1,bar.backs);
  tap(bar,g.call.centerX(),g.call.centerY()+header.fusionTop);assertEquals(1,avatar.calls);
  tap(bar,g.more.centerX(),g.more.centerY()+header.fusionTop);assertEquals(1,avatar.menus);
  tap(bar,g.text.centerX(),g.text.centerY()+header.fusionTop);assertEquals(1,avatar.profiles);
  tap(bar,g.portrait.centerX(),g.portrait.centerY()+header.fusionTop);assertEquals(2,avatar.profiles);
  ((TextView)field(avatar,"titleTextView")).setText("Extremely long native name that must stay inside its pill");size(bar,401);assertEquals(backLeft,g.back.left,.01f);assertEquals(moreRight,g.more.right,.01f);
  avatar.callable=false;header.changed();size(bar,401);assertEquals(48,g.actions.width(),.01f);assertEquals(View.GONE,((View)field(avatar,"signatureCall")).getVisibility());
  HeaderConfig.style(0);header.changed();size(bar,401);assertFalse(header.fusionActive());assertEquals(View.GONE,((View)field(avatar,"signatureMore")).getVisibility());assertEquals(header.geometry.avatar.height(),header.geometry.back.height(),.01f);
 }
 @Test public void fusionFallsBackForLargeFontsAndNarrowWindowsWithoutOverlappingControls()throws Exception{
  HeaderConfig.style(2);for(boolean rtl:new boolean[]{false,true})for(float font:new float[]{1,2,3})for(int width:new int[]{240,320,401}){
   LocaleController.isRTL=rtl;Context c=context(font);ActionBar bar=new ActionBar(c);ChatAvatarContainer avatar=new ChatAvatarContainer(c);avatar.callable=true;bar.addView(avatar,0,new FrameLayout.LayoutParams(-1,-1));SignatureChatHeader header=new SignatureChatHeader(bar,avatar,null);bar.setSignatureHeader(header);avatar.setSignatureHeader(header);size(bar,width);
   if(width==240||font>1)assertFalse(header.fusionActive());
   if(header.fusionActive()){var g=header.fusionGeometry();assertTrue(g.fits);assertTrue(g.text.width()>=48);assertEquals(50,header.height,.01f);}
   else{assertTrue(header.geometry.title.left>=0);assertTrue(header.geometry.title.right<=width);}
  }
 }
 @Test public void nativeHeaderCancelReleasesPressWithoutOpeningProfile()throws Exception{
  ChatAvatarContainer avatar=new ChatAvatarContainer(context(1));avatar.searchingAllowed=true;
  long t=SystemClock.uptimeMillis();MotionEvent down=MotionEvent.obtain(t,t,MotionEvent.ACTION_DOWN,100,40,0),cancel=MotionEvent.obtain(t,t+10,MotionEvent.ACTION_CANCEL,100,40,0);
  avatar.onTouchEvent(down);avatar.onTouchEvent(cancel);assertEquals(0,avatar.profiles);assertFalse(avatar.pressed);down.recycle();cancel.recycle();
 }
 @Test public void realAlphaMaskIsBoundedReusesShaderAndDoesNotFadeTextOrSurfaces()throws Exception{
  var mask=new app.flexygram.header.fusion.SignatureFusionAvatarMask();Bitmap image=Bitmap.createBitmap(100,60,Bitmap.Config.ARGB_8888);Canvas canvas=new Canvas(image);Paint paint=new Paint(3);paint.setColor(Color.BLUE);
  for(boolean rtl:new boolean[]{false,true}){
   image.eraseColor(Color.TRANSPARENT);mask.prepare(40,70,rtl);Object shader=field(mask,"gradient");
   int save=mask.begin(canvas,0,0,73,50);canvas.drawRect(0,0,73,50,paint);mask.finish(canvas,save,73,50,40,70,rtl);
   assertTrue(Color.alpha(image.getPixel(rtl?71:5,25))>240);assertTrue(Color.alpha(image.getPixel(rtl?5:71,25))<15);assertEquals(0,Color.alpha(image.getPixel(90,25)));
   for(int i=0;i<1000;i++)mask.prepare(40,70,rtl);assertSame(shader,field(mask,"gradient"));
  }
  image.recycle();
 }
 @Test public void extendedNativeMaskReachesNameAgainstRealLightAndDarkSurfaces()throws Exception{
  for(boolean rtl:new boolean[]{false,true})for(float density:new float[]{1,2,3})for(int width:new int[]{320,393,600}){
   var g=app.flexygram.header.fusion.SignatureFusionGeometry.calculate(width*density,density,rtl,true);if(!g.fits)continue;
   int w=Math.round(g.portrait.width()),h=Math.round(g.portrait.height());
   float start=g.fadeStartX-g.portrait.left,end=g.fadeEndX-g.portrait.left;
   int name=Math.round((rtl?g.text.right:g.text.left)-g.portrait.left);
   for(int background:new int[]{0xfff7f8fa,0xff11151c})for(int photo:new int[]{Color.BLACK,Color.WHITE,0xff2288cc}){
    Bitmap image=Bitmap.createBitmap(w,h,Bitmap.Config.ARGB_8888);Canvas c=new Canvas(image);c.drawColor(background);var mask=new app.flexygram.header.fusion.SignatureFusionAvatarMask();mask.prepare(start,end,rtl);Object shader=field(mask,"gradient");int save=mask.begin(c,0,0,w,h);Paint p=new Paint();p.setColor(photo);c.drawRect(0,0,w,h,p);mask.finish(c,save,w,h,start,end,rtl);
    int color=image.getPixel(Math.max(0,Math.min(w-1,name)),h/2);assertTrue(Math.abs(Color.red(color)-Color.red(background))<=16);assertTrue(Math.abs(Color.green(color)-Color.green(background))<=16);assertTrue(Math.abs(Color.blue(color)-Color.blue(background))<=16);
    assertEquals(photo,image.getPixel(rtl?w-Math.round(15*density):Math.round(15*density),h/2));for(int i=0;i<1000;i++)mask.prepare(start,end,rtl);assertSame(shader,field(mask,"gradient"));image.recycle();
   }
  }
 }
 @Test public void defaultAdaptiveAllocatesNoFusionControllerOrControls()throws Exception{
  HeaderConfig.style(0);ActionBar bar=new ActionBar(context(1));ChatAvatarContainer avatar=new ChatAvatarContainer(bar.getContext());bar.addView(avatar,0,new FrameLayout.LayoutParams(-1,-1));SignatureChatHeader header=new SignatureChatHeader(bar,avatar,null);bar.setSignatureHeader(header);avatar.setSignatureHeader(header);size(bar,401);assertNull(field(header,"fusion"));assertNull(field(avatar,"signatureCall"));assertNull(field(avatar,"signaturePhotoMask"));
 }

 @Test public void liveFusionCompositesOnlyExistingPortraitAndPreviewDrawsTheSameGeometry()throws Exception{
  HeaderConfig.style(2);Bitmap evidence=Bitmap.createBitmap(802,400,Bitmap.Config.ARGB_8888);Canvas output=new Canvas(evidence);
  for(boolean rtl:new boolean[]{false,true}){
   LocaleController.isRTL=rtl;Theme.dark=rtl;Context c=context(1);ActionBar bar=new ActionBar(c);ChatAvatarContainer avatar=new ChatAvatarContainer(c);avatar.callable=true;bar.addView(avatar,0,new FrameLayout.LayoutParams(-1,-1));SignatureChatHeader header=new SignatureChatHeader(bar,avatar,null);bar.setSignatureHeader(header);avatar.setSignatureHeader(header);size(bar,401);assertTrue(header.fusionActive());
   Bitmap live=Bitmap.createBitmap(401,bar.getMeasuredHeight(),Bitmap.Config.ARGB_8888);bar.draw(new Canvas(live));var g=header.fusionGeometry();int y=Math.round(g.portrait.centerY()+header.fusionTop);
   int opaqueX=Math.round(rtl?g.portrait.right-20:g.portrait.left+20),fadedX=Math.round(rtl?g.portrait.left+1:g.portrait.right-2);
   assertEquals("existing avatar stays opaque before fade",0xff2288cc,live.getPixel(opaqueX,y));assertNotEquals("native portrait fades into surface",0xff2288cc,live.getPixel(fadedX,y));assertTrue(Color.alpha(live.getPixel(fadedX,y))>=200);
   output.drawBitmap(live,rtl?401:0,0,null);HeaderPreviewView preview=new HeaderPreviewView(c);size(preview,401);int save=output.save();output.translate(rtl?401:0,140);preview.draw(output);output.restoreToCount(save);live.recycle();header.detach();
  }
  try(var file=new java.io.FileOutputStream(new java.io.File(System.getProperty("probe.root"),"signature-header-fusion-synthetic.png"))){assertTrue(evidence.compress(Bitmap.CompressFormat.PNG,100,file));}evidence.recycle();
 }

}
