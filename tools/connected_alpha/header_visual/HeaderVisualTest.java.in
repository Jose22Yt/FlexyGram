/* Native Android controller/views + extracted production avatar geometry methods.
 * ActionBar/navigation/theme/image decoding are explicit doubles. Not full chat/Poco acceptance. */
import android.app.Activity;import android.content.*;import android.content.res.*;import android.graphics.*;import android.os.*;import android.util.DisplayMetrics;import android.view.*;import android.widget.*;
import app.flexygram.header.*;import org.telegram.messenger.*;import org.telegram.ui.ActionBar.*;import org.telegram.ui.Components.ChatAvatarContainer;
import org.junit.*;import org.junit.runner.RunWith;import org.robolectric.*;import org.robolectric.annotation.*;import static org.junit.Assert.*;
@RunWith(RobolectricTestRunner.class) @Config(manifest=Config.NONE,sdk=35) @GraphicsMode(GraphicsMode.Mode.NATIVE)
public class HeaderVisualTest {
 private Activity activity;private FrameLayout root;
 @Before public void setup()throws Exception{activity=Robolectric.buildActivity(Activity.class).setup().get();root=new FrameLayout(activity);activity.setContentView(root);ApplicationLoader.applicationContext=activity;activity.getSharedPreferences("flexygram_header",0).edit().clear().commit();activity.getSharedPreferences("appearance",0).edit().clear().commit();HeaderConfig.load();AndroidUtilities.density=1;LocaleController.isRTL=false;Theme.dark=false;}
 private Context context(float font)throws Exception{AssetManager assets=AssetManager.class.getDeclaredConstructor().newInstance();assertTrue((Integer)AssetManager.class.getMethod("addAssetPath",String.class).invoke(assets,System.getProperty("probe.root")+"/resources.ap_")>0);DisplayMetrics m=new DisplayMetrics();m.density=1;m.densityDpi=160;m.scaledDensity=font;Configuration config=new Configuration();config.fontScale=font;Resources r=new Resources(assets,m,config);R.drawable.ic_ab_back=r.getIdentifier("ic_ab_back","drawable","app.flexygram.visualprobe");R.drawable.ic_ab_other=r.getIdentifier("ic_ab_other","drawable","app.flexygram.visualprobe");assertTrue(R.drawable.ic_ab_back!=0&&R.drawable.ic_ab_other!=0);return new ContextWrapper(activity){@Override public Resources getResources(){return r;}};}
 private void size(View view,int width){view.measure(View.MeasureSpec.makeMeasureSpec(width,View.MeasureSpec.EXACTLY),View.MeasureSpec.makeMeasureSpec(0,View.MeasureSpec.UNSPECIFIED));view.layout(0,0,width,view.getMeasuredHeight());}
 private Object field(Object target,String name)throws Exception{var f=target.getClass().getDeclaredField(name);f.setAccessible(true);return f.get(target);}
 private void tap(View parent,float x,float y){MotionEvent down=MotionEvent.obtain(0,0,MotionEvent.ACTION_DOWN,x,y,0),up=MotionEvent.obtain(0,1,MotionEvent.ACTION_UP,x,y,0);parent.dispatchTouchEvent(down);parent.dispatchTouchEvent(up);down.recycle();up.recycle();org.robolectric.Shadows.shadowOf(android.os.Looper.getMainLooper()).idle();}
 @Test public void nativeMeasuredPiecesAreEqualAndTitleCenterIsWindowCenter()throws Exception{
  for(float font:new float[]{1,1.5f,2,3})for(int width:new int[]{240,320,401,600})for(boolean rtl:new boolean[]{false,true}){
   LocaleController.isRTL=rtl;Context c=context(font);ActionBar bar=new ActionBar(c);ChatAvatarContainer avatar=new ChatAvatarContainer(c);bar.addView(avatar,0,new FrameLayout.LayoutParams(-1,-1));SignatureChatHeader header=new SignatureChatHeader(bar,avatar,null);bar.setSignatureHeader(header);avatar.setSignatureHeader(header);header.setCount(12345);size(bar,width);
   HeaderGeometry g=header.geometry;assertEquals(g.back.height(),g.title.height(),.001f);assertEquals(g.title.height(),g.avatar.height(),.001f);assertEquals(width/2f,g.title.centerX(),.001f);
   View title=(View)field(avatar,"titleTextView");View status=(View)field(avatar,"subtitleTextView");
   assertEquals(0,title.getPaddingTop());assertEquals(0,title.getPaddingBottom());
   assertTrue("title above surface",title.getTop()>=g.title.top-.5f);
   assertTrue("status below surface",status.getBottom()<=g.title.bottom+.5f);
   assertTrue("text lines overlap",title.getBottom()<=status.getTop());
   assertEquals(width/2f,title.getLeft()+title.getWidth()/2f,.5f);assertEquals(Math.round(header.height),bar.backButtonImageView.getHeight());
   assertTrue(g.back.left>=0&&g.avatar.left>=0);assertTrue(g.back.right<=width&&g.avatar.right<=width);header.detach();
  }
 }
 @Test public void counterTextDoesNotStealBackTapsAndMenuAndProfileStayIndependent()throws Exception{
  Context c=context(1);ActionBar bar=new ActionBar(c);ChatAvatarContainer avatar=new ChatAvatarContainer(c);bar.addView(avatar,0,new FrameLayout.LayoutParams(-1,-1));SignatureChatHeader header=new SignatureChatHeader(bar,avatar,null);bar.setSignatureHeader(header);avatar.setSignatureHeader(header);header.setCount(3);root.addView(bar);size(bar,401);
  assertTrue(header.geometry.countVisible);assertFalse(((View)field(header,"countView")).isClickable());float x=header.geometry.back.right-4,y=header.geometry.back.centerY();for(int n=0;n<100;n++)tap(bar,x,y);assertEquals(100,bar.backs);assertEquals(0,avatar.profiles);
  View menu=(View)field(avatar,"signatureMore");tap(bar,menu.getLeft()+menu.getWidth()/2f,menu.getTop()+menu.getHeight()/2f);assertEquals(1,avatar.menus);assertEquals(0,avatar.profiles);
  tap(bar,header.geometry.avatar.centerX(),header.geometry.avatar.centerY());assertEquals(1,avatar.profiles);assertEquals(1,avatar.menus);
  header.setCount(-1);size(bar,401);assertFalse(header.geometry.countVisible);assertFalse(bar.backButtonImageView.getContentDescription().toString().contains("Unread"));
  bar.search=true;size(bar,401);assertFalse(header.active());assertEquals(View.GONE,((View)field(header,"countView")).getVisibility());bar.search=false;bar.selection=true;size(bar,401);assertFalse(header.active());header.detach();header.detach();
 }
 @Test public void preferencesPreserveLegacyChoicesAndOnlyWriteTheirOwnFile(){
  var old=activity.getSharedPreferences("appearance",0);var prefs=activity.getSharedPreferences("flexygram_header",0);assertTrue(HeaderConfig.signature());
  old.edit().putBoolean("OEAppearanceIosChatHeader",false).commit();HeaderConfig.load();assertFalse(HeaderConfig.signature());
  old.edit().putBoolean("OEAppearanceIosChatHeaderAuto",true).commit();HeaderConfig.load();assertTrue(HeaderConfig.signature());
  var original=old.getAll();HeaderConfig.style(false);HeaderConfig.counter(false);HeaderConfig.compact(true);HeaderConfig.opacity(1000);HeaderConfig.load();assertFalse(HeaderConfig.signature());assertFalse(HeaderConfig.counter());assertTrue(HeaderConfig.compact());assertEquals(100,HeaderConfig.opacity());assertEquals(original,old.getAll());
  HeaderConfig.opacity(-20);assertEquals(0,HeaderConfig.opacity());prefs.edit().putString("opacity","corrupt").putString("style","corrupt").commit();HeaderConfig.load();assertEquals(85,HeaderConfig.opacity());assertTrue(HeaderConfig.signature());
 }
 @Test public void renderSyntheticPreviewLightDarkAndOpacityChangesOnlySurface()throws Exception{
  Bitmap image=Bitmap.createBitmap(401,400,Bitmap.Config.ARGB_8888);Canvas canvas=new Canvas(image);
  for(int i=0;i<2;i++){Theme.dark=i==1;HeaderPreviewView preview=new HeaderPreviewView(context(1));size(preview,401);canvas.save();canvas.translate(0,i*200);preview.draw(canvas);canvas.restore();assertTrue(preview.getContentDescription().toString().contains("Alex"));HeaderConfig.opacity(0);preview.invalidate();preview.draw(new Canvas(Bitmap.createBitmap(401,200,Bitmap.Config.ARGB_8888)));HeaderConfig.opacity(85);}
  try(var file=new java.io.FileOutputStream(new java.io.File(System.getProperty("probe.root"),"signature-header-synthetic.png"))){assertTrue(image.compress(Bitmap.CompressFormat.PNG,100,file));}
 }
}
