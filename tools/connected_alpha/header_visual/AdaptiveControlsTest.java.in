import android.app.Activity;import android.view.*;import android.widget.*;import org.junit.*;import org.junit.runner.RunWith;import org.robolectric.*;import org.robolectric.annotation.*;import static org.junit.Assert.*;
import app.flexygram.composer.FlexyComposerConfig;import org.telegram.ui.Components.chat.layouts.ChatActivityChannelButtonsLayout;import org.telegram.ui.Components.blur3.BlurredBackgroundDrawableViewFactory;
/** Actual native layout/buttons + original Bool/FactorAnimator; blur, service and press decorator doubles. */
@RunWith(RobolectricTestRunner.class) @Config(manifest=Config.NONE,sdk=35) @GraphicsMode(GraphicsMode.Mode.NATIVE)
public class AdaptiveControlsTest {
 @Before public void init(){org.telegram.messenger.AndroidUtilities.density=1;org.telegram.messenger.ApplicationLoader.applicationContext=RuntimeEnvironment.getApplication();FlexyComposerConfig.setStyle(FlexyComposerConfig.COMPACT_IOS);FlexyComposerConfig.setGlass(false);FlexyComposerConfig.setPosition(0);org.telegram.messenger.LocaleController.isRTL=false;}
 static void layout(View v,int width){v.measure(View.MeasureSpec.makeMeasureSpec(width,View.MeasureSpec.EXACTLY),View.MeasureSpec.makeMeasureSpec(300,View.MeasureSpec.AT_MOST));v.layout(0,0,v.getMeasuredWidth(),v.getMeasuredHeight());}
 @Test public void channelActionsRemainIndependentAndSearchMovesToOtherSide(){
  for(boolean rtl:new boolean[]{false,true}){
   org.telegram.messenger.LocaleController.isRTL=rtl;var v=new ChatActivityChannelButtonsLayout(RuntimeEnvironment.getApplication(),null,null,new BlurredBackgroundDrawableViewFactory());v.setTotalVisibilityFactor(1);
   int[] calls={0,0,0};for(int id=0;id<3;id++){final int i=id;v.setButtonOnClickListener(id,x->calls[i]++);v.showButton(id,true,false);}layout(v,400);
   assertEquals(4,v.getChildCount());View search=v.getChildAt(1),gift=v.getChildAt(2),direct=v.getChildAt(3);
   assertTrue(rtl?search.getX()<gift.getX():search.getX()>gift.getX());assertTrue(rtl?direct.getX()>gift.getX():direct.getX()<gift.getX());
   assertEquals(48,search.getMeasuredWidth());assertTrue(v.getContainer().getWidth()>=112);
   search.performClick();gift.performClick();direct.performClick();assertArrayEquals(new int[]{1,1,1},calls);
  }
 }
 @Test public void channelMissingActionsCollapseWithoutEmptySlots(){var v=new ChatActivityChannelButtonsLayout(RuntimeEnvironment.getApplication(),null,null,new BlurredBackgroundDrawableViewFactory());v.setTotalVisibilityFactor(1);v.showButton(0,true,false);layout(v,360);int without=v.getContainer().getWidth();v.showButton(1,true,false);layout(v,360);assertTrue(v.getContainer().getWidth()<without);v.showButton(1,false,false);layout(v,360);assertEquals(without,v.getContainer().getWidth());}
 @Test public void secondaryBotMenuRetainsActionTextAndEditableIdentity(){
  Activity a=Robolectric.buildActivity(Activity.class).setup().get();var v=new AdaptiveBotProbe(a);a.setContentView(v);v.text.setText("draft with lines\nsecond line");v.text.requestFocus();v.text.setSelection(5);var text=v.text.getText();View menu=v.botCommandsMenuButton;
  for(int i=0;i<20;i++){v.flexyCompactRequested=i%2==0;layout(v,360);assertSame(text,v.text.getText());assertEquals(5,v.text.getSelectionStart());assertTrue(v.text.hasFocus());assertSame(menu,v.botCommandsMenuButton);assertSame(v.flexyCompactRequested?v.textFieldContainer:v.messageEditTextContainer,menu.getParent());menu.performClick();}
  assertEquals(20,v.clicks);
 }
 @Test public void botWithoutMenuDoesNotReserveSecondaryRow(){var v=new AdaptiveBotProbe(RuntimeEnvironment.getApplication());v.botMenuButtonType=AdaptiveBotProbe.BotMenuButtonType.NO_BUTTON;layout(v,360);assertFalse(v.flexyBotRow);assertEquals(0,((ViewGroup.MarginLayoutParams)v.messageEditTextContainer.getLayoutParams()).topMargin);}
}
