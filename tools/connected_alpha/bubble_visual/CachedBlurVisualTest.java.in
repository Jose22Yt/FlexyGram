/* Production asynchronous cache/kernel + native graphics. Queue/UI services are explicit doubles;
 * source images are generated here. Not a frame-time or owner-device benchmark. */
import android.content.res.Resources;
import android.graphics.*;
import android.graphics.drawable.*;
import android.view.View;
import org.junit.*;
import org.junit.runner.RunWith;
import org.robolectric.*;
import org.robolectric.annotation.*;
import org.telegram.messenger.*;
import app.flexygram.bubbles.*;
import static org.junit.Assert.*;
@RunWith(RobolectricTestRunner.class) @Config(manifest=Config.NONE,sdk=35) @GraphicsMode(GraphicsMode.Mode.NATIVE) @LooperMode(LooperMode.Mode.PAUSED)
public class CachedBlurVisualTest {
 private final java.util.ArrayList<View> views=new java.util.ArrayList<>();
 private View keep(View v){views.add(v);return v;}
 private final java.util.ArrayList<SignatureWallpaperBlur.Owner> owners=new java.util.ArrayList<>();
 @Before public void setup(){SignatureWallpaperBlur.trimMemory(80);ApplicationLoader.applicationContext=RuntimeEnvironment.getApplication();ApplicationLoader.applicationContext.getSharedPreferences(BubbleConfig.FILE,0).edit().clear().commit();BuildConfig.CONNECTED_ALPHA=true;AndroidUtilities.density=1;SharedConfig.bubbleRadius=20;org.telegram.ui.ActionBar.Theme.dark=false;app.exteraless.chats.ChatsConfig.removeMessageTail.value=false;BubbleConfig.load();BubbleConfig.setBackgroundBlur(true);}
 @After public void close(){for(var owner:owners)owner.close();AndroidUtilities.drainMain();org.robolectric.Shadows.shadowOf(android.os.Looper.getMainLooper()).idle();BubbleConfig.setBackgroundBlur(false);SignatureWallpaperBlur.trimMemory(80);}
 private SignatureWallpaperBlur.Owner owner(View target){views.add(target);var owner=new SignatureWallpaperBlur.Owner(target);owners.add(owner);return owner;}
 private BitmapDrawable image(int width,int height,int seed){Bitmap b=Bitmap.createBitmap(width,height,Bitmap.Config.ARGB_8888);int[] row=new int[width];for(int y=0;y<height;y++){for(int x=0;x<width;x++)row[x]=((x+y+seed)%2==0)?Color.BLACK:Color.WHITE;b.setPixels(row,0,width,0,y,width,1);}BitmapDrawable d=new BitmapDrawable(Resources.getSystem(),b);d.setBounds(0,0,width,height);return d;}
 private void complete()throws Exception{Utilities.globalQueue.runAllOnWorker();AndroidUtilities.drainMain();org.robolectric.Shadows.shadowOf(android.os.Looper.getMainLooper()).idle();}
 private Object entry(SignatureWallpaperBlur.Owner owner)throws Exception{var f=owner.getClass().getDeclaredField("entry");f.setAccessible(true);return f.get(owner);}
 private Bitmap cached(SignatureWallpaperBlur.Owner owner)throws Exception{Object e=entry(owner);var f=e.getClass().getDeclaredField("bitmap");f.setAccessible(true);return (Bitmap)f.get(e);}
 @Test public void oneSharedBoundedImagePreparedOffUiAndSampledWithoutNewJobs()throws Exception{
  View target=keep(new View(ApplicationLoader.applicationContext));var a=owner(target);var b=owner(target);BitmapDrawable source=image(1600,1200,0);
  a.prepare(source,false,0xffeeeeee);b.prepare(source,false,0xffeeeeee);assertFalse(a.isReady());assertEquals(1,Utilities.globalQueue.pending());assertSame(entry(a),entry(b));
  complete();assertTrue(a.isReady());assertTrue(b.isReady());assertSame(cached(a),cached(b));assertTrue(cached(a).getWidth()<=384&&cached(a).getHeight()<=384);assertTrue(cached(a).getAllocationByteCount()<=384*384*4);
  Bitmap result=Bitmap.createBitmap(1600,1200,Bitmap.Config.ARGB_8888);Canvas canvas=new Canvas(result);Path shape=new Path();shape.addRect(0,0,1600,1200,Path.Direction.CW);
  assertTrue(a.draw(canvas,shape,0,0));assertTrue(Color.red(result.getPixel(800,600))>90&&Color.red(result.getPixel(800,600))<165);
  Bitmap same=cached(a);long matrices=SignatureWallpaperBlur.diagnostics()[6];for(int n=0;n<100;n++)assertTrue(a.draw(canvas,shape,0,0));assertEquals(matrices,SignatureWallpaperBlur.diagnostics()[6]);assertSame(same,cached(a));assertEquals(0,Utilities.globalQueue.pending());
  org.telegram.ui.ActionBar.MessageDrawable bubble=new org.telegram.ui.ActionBar.MessageDrawable(org.telegram.ui.ActionBar.MessageDrawable.TYPE_TEXT,true,false);
  bubble.setBounds(0,0,120,70);bubble.setTop(0,1600,1200,false,false);int[] samples={0};bubble.setFlexyGlassSource((c,p)->{samples[0]++;return b.draw(c,p,0,0);});BubbleConfig.setTransparency(100);
  Bitmap cell=Bitmap.createBitmap(120,70,Bitmap.Config.ARGB_8888);bubble.draw(new Canvas(cell));assertTrue(Color.alpha(cell.getPixel(50,35))>0);
  int sampled=samples[0];for(int alpha:new int[]{0,64,128,254}){bubble.setAlpha(alpha);cell.eraseColor(Color.TRANSPARENT);bubble.draw(new Canvas(cell));assertEquals(0,Color.alpha(cell.getPixel(50,35)));assertEquals(sampled,samples[0]);}bubble.setAlpha(255);
  BubbleConfig.setBackgroundBlur(false);cell.eraseColor(Color.TRANSPARENT);bubble.draw(new Canvas(cell));assertEquals(0,Color.alpha(cell.getPixel(50,35)));BubbleConfig.setBackgroundBlur(true);
  a.close();assertTrue(b.isReady());assertFalse(same.isRecycled());b.close();assertFalse(same.isRecycled());assertFalse(source.getBitmap().isRecycled());
 }
 @Test public void cellScrollCoordinatesTrackWallpaperAndUnsupportedMotionKeepsMatte()throws Exception{
  View target=keep(new View(ApplicationLoader.applicationContext));var a=owner(target);BitmapDrawable source=image(128,256,0);for(int y=0;y<256;y++)for(int x=0;x<128;x++)source.getBitmap().setPixel(x,y,Color.rgb(x*2,y,(x+y)%256));a.prepare(source,false,0xffcccccc);complete();
  Bitmap expected=Bitmap.createBitmap(128,256,Bitmap.Config.ARGB_8888);Path whole=new Path();whole.addRect(0,0,128,256,Path.Direction.CW);a.draw(new Canvas(expected),whole,0,0);
  Path local=new Path();local.addRect(0,0,64,48,Path.Direction.CW);
  for(int top:new int[]{0,21,100,160}){Bitmap sample=Bitmap.createBitmap(64,48,Bitmap.Config.ARGB_8888);assertTrue(a.draw(new Canvas(sample),local,12,top));assertEquals(expected.getPixel(32,top+24),sample.getPixel(20,24));}
  a.prepare(source,true,0xffcccccc);assertFalse(a.isReady());assertFalse(a.isSupported());assertFalse(a.draw(new Canvas(expected),whole,0,0));assertEquals(0,Utilities.globalQueue.pending());
 }
 @Test public void capturedMappingSurvivesSharedDrawableBoundsAndPartialAlphaDoesNotToggleMatte()throws Exception{
  var a=owner(keep(new View(ApplicationLoader.applicationContext)));BitmapDrawable source=image(128,256,0);
  for(int y=0;y<256;y++)for(int x=0;x<128;x++)source.getBitmap().setPixel(x,y,Color.rgb(x*2,y,80));
  a.prepare(source,false,0xffcccccc);complete();Bitmap prepared=cached(a);
  Path shape=new Path();shape.addRect(0,0,64,48,Path.Direction.CW);
  Bitmap full=Bitmap.createBitmap(64,48,Bitmap.Config.ARGB_8888);assertTrue(a.draw(new Canvas(full),shape,12,100));
  // Another view drawing the same Drawable must not rewrite this conversation's sampling transform.
  source.setBounds(0,0,1024,2048);
  Bitmap sample=Bitmap.createBitmap(64,48,Bitmap.Config.ARGB_8888);assertTrue(a.draw(new Canvas(sample),shape,12,100));assertEquals(full.getPixel(20,24),sample.getPixel(20,24));
  for(int alpha:new int[]{0,64,128,254,255}){sample.eraseColor(Color.TRANSPARENT);assertTrue(a.draw(new Canvas(sample),shape,12,100,alpha));assertEquals(alpha,Color.alpha(sample.getPixel(20,24)));assertSame(prepared,cached(a));}
  assertEquals(0,Utilities.globalQueue.pending());
 }
 @Test public void nativeIncomingAndOutgoingStayOnOneCacheAcrossRecycledScrollDraws()throws Exception{
  var a=owner(keep(new View(ApplicationLoader.applicationContext)));BitmapDrawable source=image(320,640,0);
  for(int y=0;y<640;y++)for(int x=0;x<320;x++)source.getBitmap().setPixel(x,y,Color.rgb(x*255/320,y*255/640,80));
  a.prepare(source,false,0xffcccccc);complete();Bitmap prepared=cached(a);
  Path whole=new Path();whole.addRect(0,0,320,640,Path.Direction.CW);
  Bitmap expected=Bitmap.createBitmap(320,640,Bitmap.Config.ARGB_8888);a.draw(new Canvas(expected),whole,0,0);
  BubbleConfig.setTransparency(100);BubbleConfig.setOutlineEnabled(false);
  for(boolean outgoing:new boolean[]{false,true}){
   var bubble=new org.telegram.ui.ActionBar.MessageDrawable(org.telegram.ui.ActionBar.MessageDrawable.TYPE_TEXT,outgoing,false);
   bubble.setBounds(0,0,100,64);int[] root={0,0};
   bubble.setFlexyGlassSource(new org.telegram.ui.ActionBar.MessageDrawable.GlassSource(){
    public boolean draw(Canvas c,Path p){return draw(c,p,255);}
    public boolean draw(Canvas c,Path p,int alpha){return a.draw(c,p,root[0],root[1],alpha);}
   });
   Bitmap cell=Bitmap.createBitmap(100,64,Bitmap.Config.ARGB_8888);Canvas canvas=new Canvas(cell);
   for(int n=0;n<240;n++){
    root[0]=outgoing?200:12;root[1]=(n*37)%560;
    a.prepare(source,false,0xffcccccc);bubble.setTop(root[1],320,640,false,false);
    cell.eraseColor(Color.TRANSPARENT);bubble.draw(canvas);
    assertEquals("wallpaper sample outgoing="+outgoing+" step="+n,expected.getPixel(root[0]+40,root[1]+30),cell.getPixel(40,30));
    assertSame(prepared,cached(a));assertEquals(0,Utilities.globalQueue.pending());
   }
   bubble.setFlexyGlassSource(null);cell.recycle();
  }
  expected.recycle();
 }
 @Test public void sourceAvailabilityNotifiesOnceAndIdleScrollDoesNotInvalidateCells()throws Exception{
  int[] changed={0};var a=new SignatureWallpaperBlur.Owner(keep(new View(ApplicationLoader.applicationContext)),()->changed[0]++);owners.add(a);
  BitmapDrawable source=image(128,256,0);a.prepare(source,false,0xffcccccc);complete();
  int ready=changed[0];assertTrue(ready>0);
  for(int n=0;n<200;n++)a.prepare(source,false,0xffcccccc);
  assertEquals(ready,changed[0]);assertEquals(0,Utilities.globalQueue.pending());
  a.prepare(source,true,0xffcccccc);assertEquals(ready+1,changed[0]);assertFalse(a.isReady());
  a.prepare(source,true,0xffcccccc);assertEquals(ready+1,changed[0]);
  a.close();assertEquals(ready+1,changed[0]);
 }
 @Test public void parentDrawPolicyUpdatesBothDirectionsAndLeavesOtherEmbeddersNative(){
  for(boolean out:new boolean[]{false,true})for(boolean allowed:new boolean[]{false,true})for(boolean gradient:new boolean[]{false,true}){
   NativeParentPolicy cell=new NativeParentPolicy();cell.canDrawBackgroundInParent=allowed;cell.currentMessageObject=new NativeParentPolicy.Message(out);cell.gradient=gradient;
   assertEquals(allowed&&out&&gradient,cell.drawBackgroundInParent());
   cell.delegate=()->true;assertEquals(allowed,cell.drawBackgroundInParent());
   cell.delegate=()->false;assertEquals(allowed&&out&&gradient,cell.drawBackgroundInParent());
   cell.currentMessageObject=null;assertFalse(cell.drawBackgroundInParent());
  }
 }
 @Test public void cancellationLateResultsCapacityAndGenerationAreControlled()throws Exception{
  class Counter extends View{int changes;Counter(){super(ApplicationLoader.applicationContext);}@Override public void invalidate(){super.invalidate();changes++;}}
  Counter target=new Counter();var a=owner(target);var b=owner(target);var c=owner(target);
  BitmapDrawable first=image(80,90,0),second=image(81,90,1),third=image(82,90,2);
  a.prepare(first,false,0xffeeeeee);b.prepare(second,false,0xffeeeeee);c.prepare(third,false,0xffeeeeee);assertEquals(2,Utilities.globalQueue.pending());assertNull(entry(c));
  a.close();assertEquals(2,Utilities.globalQueue.pending());assertNotNull(entry(c));complete();assertTrue(b.isReady());assertTrue(c.isReady());
  Bitmap previous=cached(c);third.getBitmap().eraseColor(Color.RED);c.prepare(third,false,0xffeeeeee);assertFalse(previous.isRecycled());assertFalse(c.isReady());complete();assertTrue(c.isReady());assertEquals(Color.RED,cached(c).getPixel(20,20));
  var late=owner(target);b.close();late.prepare(first,false,0xffeeeeee);Utilities.globalQueue.runAllOnWorker();int before=target.changes;late.close();AndroidUtilities.drainMain();org.robolectric.Shadows.shadowOf(android.os.Looper.getMainLooper()).idle();assertEquals(before,target.changes);assertFalse(late.isReady());
 }
 @Test public void warmReopenAndSharedWallpaperNeedZeroNewJobsAndAreReadyBeforeFirstDraw()throws Exception{
  BitmapDrawable source=image(1600,1200,0);var a=owner(keep(new View(ApplicationLoader.applicationContext)));
  long[] before=SignatureWallpaperBlur.diagnostics();a.prepare(source,false,0xffeeeeee);complete();
  Bitmap ready=cached(a);a.close();long[] prepared=SignatureWallpaperBlur.diagnostics();
  for(int n=0;n<50;n++){
   var b=owner(keep(new View(ApplicationLoader.applicationContext)));b.prepare(source,false,0xffeeeeee);
   assertTrue("ready synchronously on reopen "+n,b.isReady());assertSame(ready,cached(b));
   assertEquals(0,Utilities.globalQueue.pending());b.close();
  }
  long[] after=SignatureWallpaperBlur.diagnostics();
  assertEquals(1,after[2]-before[2]);assertEquals(50,after[0]-prepared[0]);
  assertEquals(prepared[1],after[1]);assertTrue(after[5]<=2);
  System.out.println("InstantBlur measured lifecycle: 51 openings, 1 render, 50 synchronous hits, 0 warm jobs; device frame latency NOT_MEASURED");
 }
 @Test public void lruEvictionTrimAndGenerationNeverRecyclePublishedDrawResources()throws Exception{
  BitmapDrawable first=image(384,384,0),second=image(384,384,1),third=image(384,384,2);
  var a=owner(keep(new View(ApplicationLoader.applicationContext)));a.prepare(first,false,1);complete();Bitmap one=cached(a);a.close();
  var b=owner(keep(new View(ApplicationLoader.applicationContext)));b.prepare(second,false,1);complete();b.close();
  var hit=owner(keep(new View(ApplicationLoader.applicationContext)));hit.prepare(first,false,1);assertSame(one,cached(hit));hit.close();
  var c=owner(keep(new View(ApplicationLoader.applicationContext)));c.prepare(third,false,1);complete();
  assertEquals(2,SignatureWallpaperBlur.diagnostics()[5]);assertFalse(one.isRecycled());
  SignatureWallpaperBlur.trimMemory(80);assertTrue(c.isReady());assertEquals(1,SignatureWallpaperBlur.diagnostics()[5]);
  c.close();SignatureWallpaperBlur.trimMemory(80);assertEquals(0,SignatureWallpaperBlur.diagnostics()[5]);assertFalse(one.isRecycled());
  var again=owner(keep(new View(ApplicationLoader.applicationContext)));again.prepare(first,false,1);assertFalse(again.isReady());complete();
  first.getBitmap().eraseColor(Color.RED);again.prepare(first,false,1);assertFalse(again.isReady());complete();assertEquals(Color.RED,cached(again).getPixel(100,100));
 }
 @Test public void coldNotificationIsSingleAndDeadWorkNeverReachesClosedView()throws Exception{
  int[] changes={0};var a=new SignatureWallpaperBlur.Owner(keep(new View(ApplicationLoader.applicationContext)),()->changes[0]++);owners.add(a);
  a.prepare(image(100,200,0),false,1);assertEquals("no visual change yet",0,changes[0]);complete();assertEquals(1,changes[0]);
  a.close();SignatureWallpaperBlur.trimMemory(80);
  var b=new SignatureWallpaperBlur.Owner(keep(new View(ApplicationLoader.applicationContext)),()->changes[0]++);owners.add(b);
  b.prepare(image(100,200,1),false,1);Utilities.globalQueue.runAllOnWorker();b.close();AndroidUtilities.drainMain();org.robolectric.Shadows.shadowOf(android.os.Looper.getMainLooper()).idle();assertEquals(1,changes[0]);assertFalse(b.isReady());
 }
 @Test public void genuinelyColdVisibleSourceUsesNativeFadeAndCloseCancels()throws Exception{
  org.robolectric.shadows.ShadowChoreographer.setPaused(true);org.robolectric.shadows.ShadowChoreographer.setFrameDelay(java.time.Duration.ofMillis(16));
  var controller=Robolectric.buildActivity(android.app.Activity.class).setup().visible();var activity=controller.get();View view=new View(activity);activity.setContentView(view);
  view.layout(0,0,100,200);org.robolectric.Shadows.shadowOf(android.os.Looper.getMainLooper()).idleFor(java.time.Duration.ofMillis(32));
  org.robolectric.util.ReflectionHelpers.setField(org.robolectric.util.ReflectionHelpers.getField(view,"mAttachInfo"),"mWindowVisibility",View.VISIBLE);
  var a=owner(view);BitmapDrawable source=image(100,200,0);
  a.prepare(source,false,1);Path path=new Path();path.addRect(0,0,100,200,Path.Direction.CW);Bitmap pixels=Bitmap.createBitmap(100,200,Bitmap.Config.ARGB_8888);Canvas canvas=new Canvas(pixels);
  assertTrue("blur enabled",BubbleConfig.backgroundBlur());
  assertTrue("static source supported",a.isSupported());
  assertFalse("cold draw must use fallback before worker",a.draw(canvas,path,0,0));
  complete();
  // Worker and UI service queues are explicit deterministic doubles. Native
  // bitmap rendering stays on the worker, publication runs on the real main Looper.
  assertTrue("worker publication must complete",a.isReady());
  var mappingField=a.getClass().getDeclaredField("mapping");mappingField.setAccessible(true);
  assertTrue("ready draw supported="+a.isSupported()+" mapping="+mappingField.get(a)+" generation="+source.getBitmap().getGenerationId()+" enabled="+BubbleConfig.backgroundBlur(),a.draw(canvas,path,0,0));
  assertEquals("first cold reveal stays transparent",0,Color.alpha(pixels.getPixel(40,40)));
  var fadeField=a.getClass().getDeclaredField("revealMotion");fadeField.setAccessible(true);var fade=(android.animation.ValueAnimator)fadeField.get(a);assertNotNull(fade);assertEquals(120,fade.getDuration());
  // Deterministic native animator sampling: this is not a physical frame-clock measurement.
  fade.setCurrentPlayTime(64);pixels.eraseColor(Color.TRANSPARENT);assertTrue(a.draw(canvas,path,0,0));int alpha=Color.alpha(pixels.getPixel(40,40));assertTrue("controlled reveal "+alpha,alpha>0&&alpha<255);
  fade.end();pixels.eraseColor(Color.TRANSPARENT);a.draw(canvas,path,0,0);assertEquals(255,Color.alpha(pixels.getPixel(40,40)));
  a.close();assertNull(fadeField.get(a));assertFalse(fade.isStarted());controller.pause().stop().destroy();
 }

 @Test public void exactAlpha1279BaselineRecomputesEveryReopenUnderSameWorkload()throws Exception{
  BitmapDrawable source=image(1600,1200,0);int jobs=0;
  for(int n=0;n<51;n++){
   var old=new Alpha1279WallpaperBlur.Owner(keep(new View(ApplicationLoader.applicationContext)));
   old.prepare(source,false,0xffeeeeee);assertFalse(old.isReady());assertEquals(1,Utilities.globalQueue.pending());jobs++;complete();assertTrue(old.isReady());old.close();
  }
  assertEquals(51,jobs);
  System.out.println("Alpha1279 measured lifecycle, same source/size/queue: 51 openings, 51 render jobs, 0 synchronous reopens; NOT a device benchmark");
 }

 @Test public void availabilityCallbackCanCloseAllOwnersWithoutMutatingPublicationTraversal()throws Exception{
  SignatureWallpaperBlur.Owner[] a={null},b={null};int[] callbacks={0};
  a[0]=new SignatureWallpaperBlur.Owner(keep(new View(ApplicationLoader.applicationContext)),()->{callbacks[0]++;a[0].close();b[0].close();});owners.add(a[0]);
  b[0]=owner(keep(new View(ApplicationLoader.applicationContext)));BitmapDrawable source=image(80,90,0);
  a[0].prepare(source,false,1);b[0].prepare(source,false,1);complete();
  assertEquals(1,callbacks[0]);assertFalse(a[0].isReady());assertFalse(b[0].isReady());
  var warm=owner(keep(new View(ApplicationLoader.applicationContext)));warm.prepare(source,false,1);assertTrue(warm.isReady());assertEquals(0,Utilities.globalQueue.pending());
  warm.close();SignatureWallpaperBlur.trimMemory(android.content.ComponentCallbacks2.TRIM_MEMORY_UI_HIDDEN);
  var resumed=owner(keep(new View(ApplicationLoader.applicationContext)));resumed.prepare(source,false,1);assertTrue(resumed.isReady());
 }
 @Test public void distinctThemeSurfaceKeysAndCanceledColdRevealRemainSafe()throws Exception{
  BitmapDrawable source=image(80,90,0);var a=owner(keep(new View(ApplicationLoader.applicationContext)));a.prepare(source,false,0xffeeeeee);complete();Bitmap light=cached(a);a.close();
  var b=owner(keep(new View(ApplicationLoader.applicationContext)));b.prepare(source,false,0xff111111);assertFalse(b.isReady());complete();assertNotSame(light,cached(b));
  var c=owner(keep(new View(ApplicationLoader.applicationContext)));c.prepare(source,true,0xff111111);assertFalse(c.isReady());assertFalse(c.isSupported());c.close();assertTrue(b.isReady());
 }

}
