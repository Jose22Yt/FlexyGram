import android.graphics.*;
import org.junit.Test;
import org.junit.runner.RunWith;
import org.robolectric.RobolectricTestRunner;
import org.robolectric.annotation.*;
import static org.junit.Assert.*;

@RunWith(RobolectricTestRunner.class) @Config(manifest=Config.NONE,sdk=35)
@GraphicsMode(GraphicsMode.Mode.NATIVE)
public class ComposerSurfaceTest {
    @Test public void selectedFoldersKeepTheBackdropVisibleAndSolidModeStaysOpaque() {
        var painter=new app.flexygram.home.SignatureHomePainter();
        for(boolean dark:new boolean[]{false,true})for(float selection:new float[]{0,.25f,.5f,1})
            for(int accent:new int[]{Color.RED,Color.WHITE,Color.BLACK,0xff258ce6}) {
                org.telegram.messenger.SharedConfig.blur=true;
                int[] pixels=new int[2];int i=0;
                for(int background:new int[]{Color.BLUE,Color.GREEN}){
                    Bitmap b=Bitmap.createBitmap(120,36,Bitmap.Config.ARGB_8888);Canvas c=new Canvas(b);c.drawColor(background);
                    painter.category(c,120,36,1,dark,true,selection,accent);pixels[i++]=b.getPixel(60,18);b.recycle();
                }
                assertNotEquals("selected tint must not hide the native blur",pixels[0],pixels[1]);
                org.telegram.messenger.SharedConfig.blur=false;
                Bitmap b=Bitmap.createBitmap(120,36,Bitmap.Config.ARGB_8888);Canvas c=new Canvas(b);b.eraseColor(0);
                painter.category(c,120,36,1,dark,false,selection,accent);
                assertEquals("solid fallback remains opaque",255,Color.alpha(b.getPixel(60,18)));b.recycle();
            }
        org.telegram.messenger.SharedConfig.blur=true;
    }
    @Test public void folderInkUsesTheCompositedGlassAccentAndRefreshesAcrossThemes() {
        var colors=new app.flexygram.home.SignatureFolderAccent();
        for(int base:new int[]{Color.WHITE,0xff242424})for(int accent:new int[]{Color.RED,Color.WHITE,Color.BLACK,0xff258ce6}){
            int tint=app.flexygram.home.SignatureHomeStyle.glassSelectionTint(accent);
            assertTrue(Color.alpha(tint)<=102);
            colors.update(tint,Color.WHITE,base);
            assertTrue(app.flexygram.home.SignatureFolderAccent.luminance(colors.color)>=0);
            int pixel=androidx.core.graphics.ColorUtils.compositeColors(tint,base);
            // Native integer compositing truncates; the cached palette rounds nearest.
            for(int shift:new int[]{0,8,16})assertTrue(Math.abs(((pixel>>>shift)&255)-((colors.color>>>shift)&255))<=1);
            assertTrue("resolved ink contrast",androidx.core.graphics.ColorUtils.calculateContrast(colors.ink,pixel)>=4.5);
        }
    }
    @Test public void inputUsesTheNativeMaterialWithoutAnAdditionalWash() {
        for(int theme:new int[]{Color.WHITE,0xff303236})for(int backdrop:new int[]{Color.BLACK,Color.WHITE,0xffffb43b}) {
            SurfaceProbe p=new SurfaceProbe();p.flexyComposer.color=theme;p.emptySource=true;
            Bitmap actual=Bitmap.createBitmap(284,44,Bitmap.Config.ARGB_8888),expected=Bitmap.createBitmap(284,44,Bitmap.Config.ARGB_8888);
            Canvas a=new Canvas(actual),e=new Canvas(expected);a.drawColor(backdrop);e.drawColor(backdrop);
            p.draw(a);p.drawNativeMaterial(e,p.flexyPill,20);
            assertEquals("composer must not add another tint over the native material",expected.getPixel(140,22),actual.getPixel(140,22));
            assertEquals(3,p.sourceDraws);actual.recycle();expected.recycle();
        }
    }
    @Test public void sourceChangesCannotLeavePillOrButtonsTransparent() {
        for(int theme:new int[]{Color.WHITE,0xff303236})
            for(int wallpaper:new int[]{0xffffb43b,Color.WHITE,Color.BLACK}) {
                SurfaceProbe p=new SurfaceProbe();p.flexyComposer.color=theme;
                for(int i=0;i<20;i++) {
                    p.emptySource=i%2==0;
                    Bitmap image=Bitmap.createBitmap(284,44,Bitmap.Config.ARGB_8888);
                    Canvas canvas=new Canvas(image);canvas.drawColor(wallpaper);p.draw(canvas);
                    int expected=(theme&0xffffff)|0xff000000;
                    int middle=image.getPixel(140,22),attachment=image.getPixel(22,22),voice=image.getPixel(260,22);
                    if(wallpaper!=expected) {
                        assertNotEquals("pill has a stable surface even with empty capture",wallpaper,middle);
                        assertNotEquals("attachment has a stable surface",wallpaper,attachment);
                        assertNotEquals("microphone has a stable surface",wallpaper,voice);
                    }
                    assertEquals(255,Color.alpha(middle));assertTrue(p.flexyComposer.backdrop);
                    assertEquals("outer background remains untouched",wallpaper,image.getPixel(46,22));
                    image.recycle();
                }
            }
    }
    @Test public void hideAnimationAndHiddenButtonsLeaveNoPaintedGhosts() {
        SurfaceProbe p=new SurfaceProbe();p.blurredBackgroundDrawable.alpha=0;
        Bitmap image=Bitmap.createBitmap(284,44,Bitmap.Config.ARGB_8888);Canvas canvas=new Canvas(image);canvas.drawColor(Color.RED);
        p.draw(canvas);assertEquals(Color.RED,image.getPixel(140,22));assertEquals(Color.RED,image.getPixel(260,22));
        p.blurredBackgroundDrawable.alpha=255;p.flexyComposer.voice=false;p.flexyComposer.send=false;
        image.eraseColor(Color.RED);p.draw(canvas);
        assertNotEquals(Color.RED,image.getPixel(140,22));assertEquals(Color.RED,image.getPixel(260,22));
        p.flexyComposer.send=true;image.eraseColor(Color.RED);p.draw(canvas);
        assertNotEquals(Color.RED,image.getPixel(260,22));assertTrue(p.flexySendDrawn);assertFalse(p.flexyVoiceDrawn);
        image.recycle();
    }
}
