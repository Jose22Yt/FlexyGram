import android.animation.*;
import android.app.Activity;
import android.view.*;
import android.view.animation.*;
import app.flexygram.animation.*;
import org.telegram.messenger.ApplicationLoader;
import org.junit.*;
import org.junit.runner.RunWith;
import org.robolectric.*;
import org.robolectric.annotation.*;
import static org.junit.Assert.*;

@RunWith(RobolectricTestRunner.class) @Config(manifest=Config.NONE,sdk=35)
@LooperMode(LooperMode.Mode.PAUSED)
public class FastMotionRestoreTest {
    Activity activity;
    @Before public void setup() {
        activity=Robolectric.buildActivity(Activity.class).setup().get();
        ApplicationLoader.applicationContext=activity;
        FastMotionConfig.setEnabled(true);
    }
    @After public void cleanup() { FastMotionConfig.setEnabled(false);activity.finish(); }

    @Test public void disablingRestoresCachedPropertyAnimatorWithoutAnotherHookOrRestart() {
        ViewPropertyAnimator animator=new View(activity).animate().setDuration(420).setStartDelay(80);
        FastMotion.viewAnimator(animator);
        assertEquals(4,animator.getDuration());assertEquals(1,animator.getStartDelay());
        FastMotionConfig.setEnabled(false);
        assertEquals(420,animator.getDuration());assertEquals(80,animator.getStartDelay());
        assertFalse(FastMotionConfig.isEnabled());
        for(int i=0;i<25;i++) {
            FastMotionConfig.setEnabled(true);FastMotion.viewAnimator(animator);
            assertEquals(4,animator.getDuration());
            FastMotionConfig.setEnabled(false);
            assertEquals(420,animator.getDuration());assertEquals(80,animator.getStartDelay());
        }
    }
    @Test public void disablingRestoresRunningSetsChildrenAndTheirOwnStartDelays() {
        ValueAnimator a=ValueAnimator.ofFloat(0,1),b=ValueAnimator.ofFloat(0,1);
        a.setDuration(90);b.setDuration(500);b.setStartDelay(70);
        AnimatorSet nested=new AnimatorSet();nested.playTogether(a,b);
        AnimatorSet outer=new AnimatorSet();outer.playTogether(nested);outer.setDuration(360);outer.setStartDelay(90);
        FastMotion.start(outer);
        FastMotionConfig.setEnabled(false);
        assertEquals(360,outer.getDuration());assertEquals(90,outer.getStartDelay());
        assertEquals(360,nested.getDuration());assertEquals(360,a.getDuration());assertEquals(360,b.getDuration());
        assertEquals(70,b.getStartDelay());outer.end();
    }
    @Test public void finishedAnimatorAndCloneRetainNativeDurationsAndListeners() {
        ValueAnimator animator=ValueAnimator.ofFloat(0,1);animator.setDuration(450);animator.setStartDelay(60);
        int[] ended={0};animator.addListener(new AnimatorListenerAdapter(){
            @Override public void onAnimationEnd(Animator a){ended[0]++;}
        });
        for(int i=0;i<3;i++) {
            FastMotion.start(animator);assertTrue(animator.getDuration()<10);animator.end();
            assertEquals(450,animator.getDuration());assertEquals(60,animator.getStartDelay());
            assertEquals(450,animator.clone().getDuration());
        }
        assertEquals(3,ended[0]);
        animator.removeAllListeners();FastMotion.start(animator);animator.end();
        assertEquals("cleanup survives app removeAllListeners/reuse",450,animator.getDuration());
    }
    @Test public void reverseAlsoUsesCurrentPolicyAfterPreviousAnimationHasEnded() {
        ValueAnimator animator=ValueAnimator.ofFloat(0,1);animator.setDuration(400);
        FastMotion.start(animator);animator.end();assertEquals(400,animator.getDuration());
        FastMotion.reverse(animator);assertEquals(4,animator.getDuration());animator.end();
        FastMotionConfig.setEnabled(false);FastMotion.reverse(animator);
        assertEquals(400,animator.getDuration());animator.end();
        AnimatorSet set=new AnimatorSet();set.playTogether(ValueAnimator.ofFloat(0,1));set.setDuration(500);
        FastMotionConfig.setEnabled(true);FastMotion.reverse(set);assertEquals(5,set.getDuration());set.end();
        FastMotionConfig.setEnabled(false);FastMotion.reverse(set);assertEquals(500,set.getDuration());set.end();
    }
    @Test public void offDoesNotOverwriteNewNativeValuesOrScaleFreshAnimations() {
        ValueAnimator animator=ValueAnimator.ofFloat(0,1);animator.setDuration(300);
        FastMotion.start(animator);animator.setDuration(777);
        FastMotionConfig.setEnabled(false);assertEquals(777,animator.getDuration());animator.end();
        ValueAnimator fresh=ValueAnimator.ofFloat(0,1);fresh.setDuration(250);fresh.setStartDelay(75);
        FastMotion.start(fresh);assertEquals(250,fresh.getDuration());assertEquals(75,fresh.getStartDelay());fresh.end();
    }
    @Test public void legacyAnimationAndPreferenceReloadRestoreWithoutRelaunch() {
        AlphaAnimation animation=new AlphaAnimation(0,1);animation.setDuration(600);animation.setStartOffset(120);
        FastMotion.startAnimation(new View(activity),animation);
        assertEquals(6,animation.getDuration());assertEquals(1,animation.getStartOffset());
        activity.getSharedPreferences(FastMotionConfig.FILE,0).edit().putBoolean(FastMotionConfig.KEY,false).commit();
        FastMotionConfig.load();assertFalse(FastMotionConfig.isEnabled());
        assertEquals(600,animation.getDuration());assertEquals(120,animation.getStartOffset());
    }
}
