import android.animation.*;import android.view.View;import org.junit.*;import org.junit.runner.RunWith;import org.robolectric.*;import org.robolectric.annotation.*;import static org.junit.Assert.*;
import org.telegram.ui.Components.ButtonBounce;import org.telegram.ui.Components.ScaleStateListAnimator;
/** Real native controls and Android animators. No Activity stack/account/physical claim. */
@RunWith(RobolectricTestRunner.class) @Config(manifest=Config.NONE,sdk=35) @LooperMode(LooperMode.Mode.PAUSED)
public class NativeMotionRestoreTest {
 ValueAnimator animation(ButtonBounce b,String field)throws Exception{var f=ButtonBounce.class.getDeclaredField(field);f.setAccessible(true);return (ValueAnimator)f.get(b);}
 @Test public void pressAndReleaseUseOriginalTimelines()throws Exception{var b=new ButtonBounce(new View(RuntimeEnvironment.getApplication()));b.setPressed(true);var press=animation(b,"animator");assertEquals(60,press.getDuration());press.end();assertEquals(1,b.isPressedProgress(),0);assertEquals(.9f,b.getScale(.1f),.0001f);b.setPressed(false);var release=animation(b,"animator");assertEquals(350,release.getDuration());release.end();assertFalse(b.isPressed());assertEquals(1,b.getScale(.1f),0);assertNull(animation(b,"animator"));}
 @Test public void repeatedTargetDoesNotCreateAnotherAnimator()throws Exception{var b=new ButtonBounce(null);b.setPressed(true);var first=animation(b,"animator");for(int i=0;i<100;i++)b.setPressed(true);assertSame(first,animation(b,"animator"));first.end();b.setPressed(false);animation(b,"animator").end();}
 @Test public void reverseKeepsCurrentPressProgress()throws Exception{var b=new ButtonBounce(null);b.setPressed(true);animation(b,"animator").setCurrentFraction(.4f);float p=b.isPressedProgress();b.setPressed(false);assertEquals(p,b.isPressedProgress(),.0001f);animation(b,"animator").end();assertEquals(0,b.isPressedProgress(),0);}
 @Test public void nativeBounceCanBeInterruptedAndCompletes()throws Exception{var b=new ButtonBounce(null);b.bounce();var first=animation(b,"bounceAnimator");b.bounce();assertNotSame(first,animation(b,"bounceAnimator"));animation(b,"bounceAnimator").end();assertEquals(1,b.getScale(.2f),0);assertNull(animation(b,"bounceAnimator"));}
 @Test public void nativeStateAnimatorIsInstalledAndReset(){var v=new View(RuntimeEnvironment.getApplication());ScaleStateListAnimator.apply(v,.05f,1.2f);assertNotNull(v.getStateListAnimator());ScaleStateListAnimator.reset(v);assertNull(v.getStateListAnimator());ScaleStateListAnimator.apply(null);}
 @Test public void invalidationCallbackAndReleaseDelayArePreserved()throws Exception{int[] n={0};var b=new ButtonBounce(null).setReleaseDelay(25);b.setAdditionalInvalidate(()->n[0]++);b.setPressed(true);animation(b,"animator").end();b.setPressed(false);assertEquals(25,animation(b,"animator").getStartDelay());animation(b,"animator").end();assertTrue(n[0]>0);}
}
