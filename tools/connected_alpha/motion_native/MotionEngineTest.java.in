 @Test public void openingGestureRespectsNativeVetoModalCustomImeAndUnknownOwners(){
  for(int blocked=0;blocked<13;blocked++){
   GestureOpeningProbe p=gestureOpening();if(blocked==0)p.fragmentsStack.set(1,new GestureOpeningProbe.UnsupportedScreen());p.startOpening(blocked==1);if(blocked==2)p.currentAnimation=new android.animation.AnimatorSet();if(blocked==3)p.containerView.isKeyboardVisible=true;if(blocked==4)p.getLastFragment().dialog=new GestureOpeningProbe.Dialog(true);if(blocked==5)p.getLastFragment().sheet=true;if(blocked==6)GestureOpeningProbe.NaConfig.style=GestureOpeningProbe.BACK_ANIMATION_PREDICTIVE;if(blocked==7)GestureOpeningProbe.NaConfig.style=GestureOpeningProbe.BACK_ANIMATION_SLIDE;if(blocked==8)p.inPreviewMode=true;if(blocked==9)p.waitingForKeyboardCloseRunnable=()->{};if(blocked==10)p.getLastFragment().allowBack=false;if(blocked==11)p.getLastFragment().slideAllowed=false;if(blocked==12)p.layout(0,0,0,600);
   assertFalse("blocked route "+blocked,p.onBackStarted(4,180));assertFalse(p.instantGestureActive);assertFalse(p.instantGesturePending);assertFalse(p.instantBackSeed);assertFalse(p.predictiveInput);assertEquals(0,p.slideCompletions);p.drain();assertEquals(0,FlexyFrameMotion.activeCount());
  }
 }
