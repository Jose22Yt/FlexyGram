 SwipeHandoffProbe swipe(){SwipeHandoffProbe p=new SwipeHandoffProbe(activity);activity.setContentView(p);advance(32);p.measure(View.MeasureSpec.makeMeasureSpec(300,View.MeasureSpec.EXACTLY),View.MeasureSpec.makeMeasureSpec(600,View.MeasureSpec.EXACTLY));p.layout(0,0,300,600);return p;}
 void swipeEvent(SwipeHandoffProbe p,int action,float x,float y,long time){MotionEvent event=MotionEvent.obtain(10,time,action,x,y,0);p.dispatchTouchEvent(event);event.recycle();}
 @Test public void releasedSwipeTransfersOriginalDownUpAfterExactNativeSlideCommit(){
  for(FlexyMotionProfile profile:new FlexyMotionProfile[]{FlexyMotionProfile.FLOW,FlexyMotionProfile.SIGNATURE})for(float progress:new float[]{.35f,.5f,.8f}){
   FlexyMotionSettings.setProfile(activity,profile);SwipeHandoffProbe p=swipe();p.stageReleasedSwipe(progress,false,0);app.flexygram.motion.SpringAnimation old=p.currentSpringAnimation;assertTrue(p.instantSwipeSettlingClosing);assertTrue(old.canContinue());assertEquals(2,p.fragmentsStack.size());
   swipeEvent(p,MotionEvent.ACTION_DOWN,30,240,10);assertEquals(1,p.commits);assertEquals(1,p.fragmentsStack.size());assertSame(p.destination,p.getLastFragment());assertEquals(1,p.outgoing.destroys);assertEquals(1,p.destination.resumes);assertFalse(p.animationInProgress);assertFalse(p.startedTracking);assertFalse(old.isRunning());assertNull(p.currentSpringAnimation);assertEquals(0,FlexyFrameMotion.activeCount());assertEquals(1,p.downs);assertEquals(10,p.downTime);
   swipeEvent(p,MotionEvent.ACTION_UP,30,240,27);advance(16);assertEquals(1,p.ups);assertEquals(27,p.upTime);assertEquals(1,p.clicks);frames(30);assertEquals(1,p.clicks);assertEquals(1,p.commits);assertEquals(org.telegram.ui.ActionBar.FlexyInstantNavigationCoordinator.State.IDLE,p.instantNavigation.state());
  }
 }
