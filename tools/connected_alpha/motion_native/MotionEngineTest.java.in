 void frames(int count){for(int i=0;i<count;i++)advance(16);}
 @Test public void ordinaryBackReversesFromExactPositionVelocityAndNativeGeometry(){
  for(FlexyMotionProfile profile:new FlexyMotionProfile[]{FlexyMotionProfile.FLOW,FlexyMotionProfile.SIGNATURE})for(float speed:new float[]{.5f,1,2})for(int ticks:new int[]{1,2,3}){
   FlexyMotionSettings.setProfile(activity,profile);if(profile==FlexyMotionProfile.SIGNATURE)FlexyMotionSettings.tune(activity,speed,200,.55f,.94f);
   OpeningBackProbe p=openingBack();p.startOpening(false);frames(ticks);app.flexygram.motion.SpringAnimation old=p.currentSpringAnimation;assertTrue(old.canContinue());float value=old.continuationValue(),velocity=old.continuationVelocity();
   View chat=p.containerView,home=p.containerViewBack;float x=chat.getTranslationX(),scale=chat.getScaleX(),homeX=home.getTranslationX(),inner=p.inner;
   p.onBackPressed();assertEquals(1,p.closeRequests);assertFalse(old.isRunning());assertSame(chat,p.containerViewBack);assertSame(home,p.containerView);assertTrue(p.currentSpringAnimation.canContinue());
   assertEquals(1000-value,p.currentSpringAnimation.continuationValue(),.0001f);assertEquals(-velocity,p.currentSpringAnimation.continuationVelocity(),.001f);
   assertEquals(x,chat.getTranslationX(),.0001f);assertEquals(scale,chat.getScaleX(),.0001f);assertEquals(scale,chat.getScaleY(),.0001f);assertEquals(homeX,home.getTranslationX(),.0001f);assertEquals(inner,p.inner,.0001f);assertFalse(p.instantBackSeed);assertEquals(1,FlexyFrameMotion.activeCount());
   frames(150);assertEquals(1,p.fragmentsStack.size());assertEquals(0,FlexyFrameMotion.activeCount());
  }
 }
 @Test public void signatureOvershootReversesWithoutClampingOrGeometryJump(){
  FlexyMotionSettings.setProfile(activity,FlexyMotionProfile.SIGNATURE);FlexyMotionSettings.tune(activity,1,200,.55f,.94f);OpeningBackProbe p=openingBack();p.startOpening(false);
  for(int i=0;i<30&&p.currentSpringAnimation.continuationValue()<=1000;i++)frames(1);
  float value=p.currentSpringAnimation.continuationValue();assertTrue(value>1000&&value<1250);View chat=p.containerView;float scale=chat.getScaleX(),x=chat.getTranslationX();p.onBackPressed();assertTrue(p.currentSpringAnimation.continuationValue()<0);assertEquals(1000-value,p.currentSpringAnimation.continuationValue(),.0001f);assertEquals(x,chat.getTranslationX(),.0001f);assertEquals(scale,chat.getScaleX(),.0001f);frames(150);assertEquals(0,FlexyFrameMotion.activeCount());
 }
 @Test public void timedImeAndVetoCannotLeakSeedToAnotherNativeTransaction(){
  for(int mode=0;mode<3;mode++){
   OpeningBackProbe p=openingBack();p.startOpening(mode==0);frames(2);if(mode==1)p.containerView.isKeyboardVisible=true;if(mode==2)p.getLastFragment().allowBack=false;p.onBackPressed();assertFalse(p.instantBackSeed);
   if(mode==2){assertEquals(0,p.closeRequests);p.getLastFragment().allowBack=true;p.onBackPressed();assertEquals(1,p.closeRequests);}else assertEquals(1,p.closeRequests);
   assertEquals(0,p.currentSpringAnimation.continuationValue(),0);p.drain();assertEquals(0,FlexyFrameMotion.activeCount());
  }
 }
