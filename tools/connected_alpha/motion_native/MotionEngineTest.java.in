 @Test public void timedM3AndSlideTakeOverTheActualTimedOpeningWithoutFirstFrameJump(){
  for(int style:new int[]{2,3})for(FlexyMotionProfile profile:new FlexyMotionProfile[]{FlexyMotionProfile.FLOW,FlexyMotionProfile.SIGNATURE})for(boolean cancel:new boolean[]{false,true}){
   FlexyMotionSettings.setProfile(activity,profile);GestureOpeningProbe p=gestureOpening();p.startTimedOpening(style);frames(2);var old=p.currentSpringAnimation;assertTrue(old.canCaptureTimed());float x=p.containerView.getTranslationX(),alpha=p.containerView.getAlpha();assertTrue(alpha>0&&alpha<1);assertTrue(p.onBackStarted(4,180));assertTrue(p.instantGestureActive);assertFalse(old.isRunning());assertEquals(style,p.instantGestureStyle);assertEquals(0,FlexyFrameMotion.activeCount());
   if(style==2){RectF rect=new RectF();p.predictiveBackAnimation.getClosingRect(rect);assertEquals(x,rect.left,.0001f);assertEquals(1,p.predictiveBackAnimation.getClosingScale(),.0001f);p.predictiveBackAnimation.getEnteringRect(rect);assertEquals(new RectF(0,0,300,600),rect);assertEquals(0,p.containerView.getTranslationX(),0);assertTrue(p.predictiveBackHasProgress);assertEquals(0,p.predictiveBackAnimation.getScrimAlpha(false));}else assertEquals(x,p.containerView.getTranslationX(),.0001f);
   assertEquals(alpha,p.containerView.getAlpha(),.0001f);p.onBackProgress(.35f,210);alpha=p.containerView.getAlpha();x=p.containerView.getTranslationX();RectF rect=new RectF();p.predictiveBackAnimation.getClosingRect(rect);if(cancel)p.onBackCancelled();else p.onBackInvoked();assertNotNull(p.backAnimator);assertEquals(org.telegram.ui.ActionBar.FlexyInstantNavigationCoordinator.State.SETTLING,p.instantNavigation.state());assertEquals(alpha,p.containerView.getAlpha(),.0001f);if(style==2){RectF after=new RectF();p.predictiveBackAnimation.getClosingRect(after);assertEquals(rect,after);}else assertEquals(x,p.containerView.getTranslationX(),.0001f);
   frames(160);assertEquals(cancel?2:1,p.fragmentsStack.size());assertEquals(1,p.slideCompletions);assertEquals(cancel,p.slideCancelled);assertFalse(p.instantGestureActive);assertFalse(p.animationInProgress);assertNull(p.backAnimator);assertEquals(1,p.containerView.getAlpha(),0);assertEquals(org.telegram.ui.ActionBar.FlexyInstantNavigationCoordinator.State.IDLE,p.instantNavigation.state());assertEquals(0,FlexyFrameMotion.activeCount());
  }
 }
