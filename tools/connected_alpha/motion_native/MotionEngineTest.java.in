 @Test public void analyticBridgeSnapshotUsesPhysicalVelocityAndRefusesInactiveRoutes(){
  FlexyMotionSettings.setProfile(activity,FlexyMotionProfile.SIGNATURE);FlexyMotionSettings.tune(activity,.5f,200,.55f,.94f);
  var a=new app.flexygram.motion.SpringAnimation(button,new androidx.dynamicanimation.animation.FloatValueHolder(300)).setSpring(new androidx.dynamicanimation.animation.SpringForce(1000)).setStartVelocity(-120).setRenderInitialValue(true);int[] updates={0};a.addUpdateListener((x,v,w)->{if(updates[0]++==0){assertEquals(300,v,0);assertEquals(-120,w,.001f);}});assertFalse(a.canContinue());a.start();assertTrue(a.canContinue());assertEquals(300,a.continuationValue(),0);assertEquals(-120,a.continuationVelocity(),.001f);a.cancel();assertFalse(a.canContinue());
  var timed=new app.flexygram.motion.SpringAnimation(button,new androidx.dynamicanimation.animation.FloatValueHolder(0)).setSpring(new androidx.dynamicanimation.animation.SpringForce(1000)).setDuration(2000);timed.start();assertFalse(timed.canContinue());timed.cancel();
  FlexyMotionSettings.setReduceMotion(activity,true);a.start();assertFalse(a.canContinue());a.cancel();assertEquals(0,FlexyFrameMotion.activeCount());
