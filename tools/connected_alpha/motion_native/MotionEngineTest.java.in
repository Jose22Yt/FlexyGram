 @Test public void predictiveInputTakesOrdinarySpringOpeningAtExactGeometryAndSettlesNatively(){
  for(FlexyMotionProfile profile:new FlexyMotionProfile[]{FlexyMotionProfile.FLOW,FlexyMotionProfile.SIGNATURE})for(float scale:new float[]{0,.5f,1,2,5})for(boolean cancel:new boolean[]{false,true}){
   org.robolectric.util.ReflectionHelpers.callStaticMethod(android.animation.ValueAnimator.class,"setDurationScale",org.robolectric.util.ReflectionHelpers.ClassParameter.from(float.class,scale));FlexyMotionSettings.setProfile(activity,profile);GestureOpeningProbe p=gestureOpening();p.startOpening(false);frames(2);var opening=p.currentSpringAnimation;float value=opening.continuationValue(),velocity=opening.continuationVelocity();View chat=p.containerView,home=p.containerViewBack;float x=chat.getTranslationX(),homeX=home.getTranslationX(),size=chat.getScaleX(),inner=p.inner;
   assertTrue(p.onBackStarted(4,180));assertFalse(opening.isRunning());assertTrue(p.instantGestureActive);assertFalse(p.instantGesturePending);assertFalse(p.instantBackSeed);assertTrue(p.predictiveInput);assertEquals(1000-value,p.instantGestureValue,.0001f);assertEquals(-velocity,p.instantGestureVelocity,.001f);assertEquals(x,chat.getTranslationX(),.0001f);assertEquals(size,chat.getScaleX(),.0001f);assertEquals(homeX,home.getTranslationX(),.0001f);assertEquals(inner,p.inner,.0001f);assertEquals(org.telegram.ui.ActionBar.FlexyInstantNavigationCoordinator.State.DRAGGING,p.instantNavigation.state());assertEquals(0,FlexyFrameMotion.activeCount());assertEquals(1,p.backgroundRequests);assertNotNull(p.springRouteBackgroundDrawable);
   advance(16);p.onBackProgress(.2f,200);float fingerValue=p.instantGestureValue,fingerVelocity=p.instantGestureVelocity;assertTrue(Float.isFinite(fingerVelocity));assertTrue(fingerVelocity>0);assertEquals(fingerValue/1000*300,chat.getTranslationX(),.0001f);assertEquals(1-.15f*fingerValue/1000,chat.getScaleX(),.0001f);assertEquals(0,FlexyFrameMotion.activeCount());
   if(cancel)p.onBackCancelled();else p.onBackInvoked();assertEquals(org.telegram.ui.ActionBar.FlexyInstantNavigationCoordinator.State.SETTLING,p.instantNavigation.state());assertFalse(p.predictiveInput);assertEquals(fingerValue,p.currentSpringAnimation.continuationValue(),.0001f);assertEquals(fingerVelocity,p.currentSpringAnimation.continuationVelocity(),.01f);assertEquals(1,FlexyFrameMotion.activeCount());frames(160);assertEquals(cancel?2:1,p.fragmentsStack.size());assertEquals(1,p.slideCompletions);assertEquals(cancel,p.slideCancelled);assertFalse(p.instantGestureActive);assertFalse(p.predictiveBackInProgress);assertFalse(p.startedTracking);assertFalse(p.animationInProgress);assertEquals(org.telegram.ui.ActionBar.FlexyInstantNavigationCoordinator.State.IDLE,p.instantNavigation.state());assertNull(p.currentSpringAnimation);assertNull(p.springRouteBackgroundDrawable);assertEquals(0,FlexyFrameMotion.activeCount());p.onBackCancelled();p.onBackProgress(.9f);assertEquals(1,p.slideCompletions);
  }
 }
