 @Test public void folderColorLegacyVariantKeepsNativeGraph(){org.telegram.messenger.BuildConfig.CONNECTED_ALPHA=false;try{FolderMotionProbe p=new FolderMotionProbe(activity);activity.setContentView(p);advance(32);p.animateColorsTo(11,12,13,14,15);assertTrue(p.colorChangeAnimator instanceof android.animation.AnimatorSet);p.colorChangeAnimator.cancel();}finally{org.telegram.messenger.BuildConfig.CONNECTED_ALPHA=true;}}

 // Android ViewGroup dispatch probe: real DOWN/UP stream, no synthetic replay.
 // This is an isolated widget test of the P1 handoff protocol; full
 // ActionBarLayout/Telegram fragment lifecycle remains device acceptance.
 static class HandoffTouchRoot extends android.widget.FrameLayout {
  final android.widget.FrameLayout exposed;
  final android.widget.Button row;
  final View outgoing;
  boolean closing=true, blocked=false;
  int completed;
  HandoffTouchRoot(android.content.Context ctx){
   super(ctx);
   exposed=new android.widget.FrameLayout(ctx);
   row=new android.widget.Button(ctx);
   row.setText("Chat B");
   exposed.addView(row,new android.widget.FrameLayout.LayoutParams(190,110));
   addView(exposed,new android.widget.FrameLayout.LayoutParams(400,800));
   outgoing=new View(ctx);
   outgoing.setBackgroundColor(android.graphics.Color.BLACK);
   addView(outgoing,new android.widget.FrameLayout.LayoutParams(400,800));
   outgoing.setTranslationX(220);
  }
  @Override public boolean onInterceptTouchEvent(MotionEvent e) {
   boolean allow=e.getActionMasked()==MotionEvent.ACTION_DOWN &&
     org.telegram.ui.ActionBar.FlexyNavigationHandoffPolicy.canHandoffClosingDown(
       closing,blocked,outgoing.getVisibility()==View.VISIBLE,
       exposed.getVisibility()==View.VISIBLE && exposed.getChildCount()>0,
       e.getX(),e.getY(),outgoing.getTranslationX(),
       getWidth(),getHeight(),16);
   if(allow){
    completed++;
    closing=false;
    outgoing.setVisibility(View.GONE);
    return false; // framework must give the same original DOWN to B
   }
   return closing || super.onInterceptTouchEvent(e);
  }
 }
 @Test public void actualAndroidDispatchTransfersOriginalDownUpToExposedChatOnce(){
  HandoffTouchRoot root=new HandoffTouchRoot(activity);
  int[] clicks={0};
  java.util.ArrayList<Integer> actions=new java.util.ArrayList<>();
  java.util.ArrayList<Long> times=new java.util.ArrayList<>();
  root.row.setOnTouchListener((v,e)->{actions.add(e.getActionMasked());times.add(e.getEventTime());return false;});
  root.row.setOnClickListener(v->clicks[0]++);
  activity.setContentView(root);
  root.measure(View.MeasureSpec.makeMeasureSpec(400,View.MeasureSpec.EXACTLY),
     View.MeasureSpec.makeMeasureSpec(800,View.MeasureSpec.EXACTLY));
  root.layout(0,0,400,800);
  advance(32);
  MotionEvent down=MotionEvent.obtain(100,100,MotionEvent.ACTION_DOWN,80,40,0);
  MotionEvent up=MotionEvent.obtain(100,140,MotionEvent.ACTION_UP,80,40,0);
  try{
   assertTrue(root.dispatchTouchEvent(down));
   assertEquals(1,root.completed);
   assertTrue(root.dispatchTouchEvent(up));
   assertEquals(java.util.Arrays.asList(MotionEvent.ACTION_DOWN,MotionEvent.ACTION_UP),actions);
   assertEquals(java.util.Arrays.asList(100L,140L),times);
   // View.post delivers the click on a subsequent virtual UI frame.
   // This is queue execution, not a physical latency measurement.
   advance(16);
   assertEquals(1,clicks[0]);
   assertEquals(View.GONE,root.outgoing.getVisibility());
   assertFalse(root.closing);
   advance(100);
   assertEquals(1,clicks[0]);
  }finally{down.recycle();up.recycle();}
 }
 @Test public void androidDispatchDoesNotGhostClickCoveredOrBlockedChat(){
  for(boolean blocked:new boolean[]{false,true}){
   HandoffTouchRoot root=new HandoffTouchRoot(activity);
   root.blocked=blocked;
   int[] clicks={0};
   root.row.setOnClickListener(v->clicks[0]++);
   activity.setContentView(root);
   root.measure(View.MeasureSpec.makeMeasureSpec(400,View.MeasureSpec.EXACTLY),
      View.MeasureSpec.makeMeasureSpec(800,View.MeasureSpec.EXACTLY));
   root.layout(0,0,400,800);
   advance(32);
   // Blocked exposed region (modal) or still covered (x=250).
   float x=blocked?80:250;
   MotionEvent down=MotionEvent.obtain(100,100,MotionEvent.ACTION_DOWN,x,40,0);
   MotionEvent up=MotionEvent.obtain(100,140,MotionEvent.ACTION_UP,x,40,0);
   try{root.dispatchTouchEvent(down);root.dispatchTouchEvent(up);}finally{
    down.recycle();up.recycle();
   }
   assertEquals(0,clicks[0]);
   assertEquals(0,root.completed);
   assertTrue(root.closing);
  }
 }
}
