 android.window.BackEvent backEvent(float progress){return new android.window.BackEvent(4,180,progress,android.window.BackEvent.EDGE_LEFT);}
 @Test public void actualLauncherCallbackForwardsLazyStartAndBalancesNotifications(){
  for(boolean cancel:new boolean[]{false,true}){GestureOpeningProbe p=gestureOpening();p.startOpening(false);frames(2);GestureDispatchProbe d=new GestureDispatchProbe(p);var opening=p.currentSpringAnimation;d.callback.onBackStarted(backEvent(0));d.callback.onBackProgressed(backEvent(.01f));assertFalse(p.instantGestureActive);assertTrue(opening.isRunning());assertEquals(0,d.locks);d.callback.onBackProgressed(backEvent(.2f));assertTrue(p.instantGestureActive);assertFalse(opening.isRunning());assertEquals(1,d.locks);assertEquals(0,d.unlocks);float fraction=(.2f-.015f)/(1-.015f),expected=(p.instantGestureOrigin+(1-p.instantGestureOrigin)*org.telegram.ui.Components.CubicBezierInterpolator.StandardDecelerate.getInterpolation(fraction))*1000;assertEquals(expected,p.instantGestureValue,.001f);assertEquals(0,FlexyFrameMotion.activeCount());if(cancel)d.callback.onBackCancelled();else d.callback.onBackInvoked();assertEquals(1,d.unlocks);frames(160);assertEquals(cancel?2:1,p.fragmentsStack.size());assertEquals(1,p.slideCompletions);assertFalse(p.instantGestureActive);assertEquals(0,FlexyFrameMotion.activeCount());}
 }
