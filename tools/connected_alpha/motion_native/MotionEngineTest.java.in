 }
 @Test public void m3HelperResidualIsFiniteBoundedAndResetDoesNotContaminateNativeGeometry(){
  var h=new app.exteraless.utils.PredictiveBackAnimationHelper();var reference=new app.exteraless.utils.PredictiveBackAnimationHelper();for(boolean left:new boolean[]{false,true}){h.start(300,600,180,left,16);h.continueOpening(37,.24f);h.update(.3f,210);h.prepareCommit();RectF before=new RectF(),after=new RectF();h.getClosingRect(before);float alpha=h.getClosingAlpha(),radius=h.getCornerRadius();h.updateCommitProgress(0);assertEquals(radius,h.getCornerRadius(),0);h.getClosingRect(after);assertEquals(before,after);assertEquals(alpha,h.getClosingAlpha(),0);h.updateCommitProgress(1);assertEquals(0,h.getClosingAlpha(),0);h.reset();h.start(300,600,180,left,16);reference.start(300,600,180,left,16);for(float t:new float[]{0,.1f,.5f,1}){h.update(t,210);reference.update(t,210);h.getClosingRect(before);reference.getClosingRect(after);assertEquals(after,before);h.getEnteringRect(before);reference.getEnteringRect(after);assertEquals(after,before);assertEquals(reference.getScrimAlpha(false),h.getScrimAlpha(false));assertEquals(1,h.getClosingAlpha(),0);}}
 }
 @Test public void timedSnapshotRejectsHiddenInstantAndAnalyticActors(){
  var a=new app.flexygram.motion.SpringAnimation(button,new androidx.dynamicanimation.animation.FloatValueHolder(0)).setSpring(new androidx.dynamicanimation.animation.SpringForce(1));a.start();assertFalse(a.canCaptureTimed());a.cancel();a=new app.flexygram.motion.SpringAnimation(button,new androidx.dynamicanimation.animation.FloatValueHolder(0)).setSpring(new androidx.dynamicanimation.animation.SpringForce(1)).setDuration(2000);a.start();assertTrue(a.canCaptureTimed());button.setVisibility(View.INVISIBLE);assertFalse(a.canCaptureTimed());button.setVisibility(View.VISIBLE);FlexyMotionSettings.setReduceMotion(activity,true);assertFalse(a.canCaptureTimed());a.cancel();assertEquals(0,FlexyFrameMotion.activeCount());
 }

 @Test public void m3AndSlideRejectModalImeCustomAndInvalidTimedGeometry(){
  for(int style:new int[]{2,3})for(int blocked=0;blocked<8;blocked++){GestureOpeningProbe p=gestureOpening();p.startTimedOpening(style);frames(1);if(blocked==0)p.getLastFragment().overrideSlide=true;if(blocked==1)p.containerView.isKeyboardVisible=true;if(blocked==2)p.getLastFragment().dialog=new GestureOpeningProbe.Dialog(true);if(blocked==3)p.containerView.setScaleX(.8f);if(blocked==4)p.containerViewBack.setAlpha(.5f);if(blocked==5)p.fragmentsStack.set(1,new GestureOpeningProbe.UnsupportedScreen());if(blocked==6)p.inPreviewMode=true;if(blocked==7)p.getLastFragment().allowBack=false;assertFalse("blocked timed route "+style+"/"+blocked,p.onBackStarted(4,180));assertFalse(p.instantGestureActive);assertFalse(p.instantGesturePending);assertFalse(p.predictiveInput);assertEquals(0,p.slideCompletions);p.drain();assertEquals(0,FlexyFrameMotion.activeCount());}
 }
 @Test public void nativeSlideZeroDurationCannotResurrectFinishedAnimationFlags(){
  for(boolean cancel:new boolean[]{false,true}){GestureOpeningProbe p=gestureOpening();p.startTimedOpening(3);frames(1);assertTrue(p.onBackStarted(4,180));p.onBackProgress(.2f);org.robolectric.util.ReflectionHelpers.callStaticMethod(android.animation.ValueAnimator.class,"setDurationScale",org.robolectric.util.ReflectionHelpers.ClassParameter.from(float.class,0f));if(cancel)p.onBackCancelled();else p.onBackInvoked();frames(3);assertEquals(1,p.slideCompletions);assertFalse(p.animationInProgress);assertFalse(p.instantGestureActive);assertNull(p.backAnimator);assertEquals(cancel?2:1,p.fragmentsStack.size());assertEquals(org.telegram.ui.ActionBar.FlexyInstantNavigationCoordinator.State.IDLE,p.instantNavigation.state());}
 }
 @Test public void m3AndSlideDetachedSettlementReleasesTheOldOwner(){
  for(int style:new int[]{2,3}){GestureOpeningProbe p=gestureOpening();p.startTimedOpening(style);frames(1);assertTrue(p.onBackStarted(4,180));p.onBackProgress(.2f);activity.setContentView(new View(activity));p.onBackCancelled();frames(160);assertEquals(1,p.slideCompletions);assertTrue(p.slideCancelled);assertEquals(2,p.fragmentsStack.size());assertFalse(p.instantGestureActive);assertNull(p.backAnimator);assertEquals(0,FlexyFrameMotion.activeCount());}
 }
}
