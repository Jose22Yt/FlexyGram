 @Test public void seededFirstRenderCancellationAndRestartCannotStartStaleFrameOwner(){
  for(boolean restart:new boolean[]{false,true}){
   int[] renders={0},ends={0};var a=new app.flexygram.motion.SpringAnimation(button,new androidx.dynamicanimation.animation.FloatValueHolder(300)).setSpring(new androidx.dynamicanimation.animation.SpringForce(1000)).setRenderInitialValue(true);
   a.addEndListener((x,c,v,w)->ends[0]++);a.addUpdateListener((x,v,w)->{if(renders[0]++==0){x.cancel();if(restart)x.start();}});a.start();assertEquals(1,ends[0]);assertEquals(restart?1:0,FlexyFrameMotion.activeCount());if(restart){assertTrue(a.isRunning());frames(150);assertEquals(2,ends[0]);}assertEquals(0,FlexyFrameMotion.activeCount());
  }
 }

