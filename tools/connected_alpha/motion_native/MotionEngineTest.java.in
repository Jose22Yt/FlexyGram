  p.predictiveBackAnimation.start(300,600,200,true,16);p.predictiveBackAnimation.update(.4f,240);p.predictive(true);android.animation.Animator newer=p.backAnimator;float progress=p.predictiveBackAnimation.getProgress();old.cancel();assertSame(newer,p.backAnimator);assertEquals(progress,p.predictiveBackAnimation.getProgress(),0);assertEquals(0,p.slideCompletions);assertTrue(p.animationInProgress);frames(150);assertEquals(1,p.slideCompletions);assertNull(p.backAnimator);assertEquals(0,FlexyFrameMotion.activeCount());
