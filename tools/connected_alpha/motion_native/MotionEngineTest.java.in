   p.afterSlide=()->{p.afterSlide=null;p.predictiveBackAnimation.start(300,600,200,true,16);p.predictiveBackAnimation.update(.4f,240);p.predictiveBackY=240;p.predictive(true);};
   if(cancel)old.cancel();else old.end();assertNotNull(p.backAnimator);assertNotSame(old,p.backAnimator);assertTrue(p.animationInProgress);assertEquals(1,p.slideCompletions);frames(150);assertEquals(2,p.slideCompletions);assertNull(p.backAnimator);assertEquals(0,FlexyFrameMotion.activeCount());
