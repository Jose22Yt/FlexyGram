import app.flexygram.motion.*;
import android.app.Activity;
import android.graphics.*;
import android.os.Looper;
import android.view.*;
import android.widget.Button;
import java.time.Duration;
import org.junit.*;
import org.junit.runner.RunWith;
import static org.junit.Assert.*;
import org.robolectric.*;
import org.robolectric.annotation.*;
import org.robolectric.shadows.ShadowValueAnimator;

@RunWith(RobolectricTestRunner.class)
@Config(sdk=35,manifest=Config.NONE,instrumentedPackages={"app.flexygram.motion"})
@LooperMode(LooperMode.Mode.PAUSED)
public class MotionEngineTest {
 Activity activity;Button button;
 void advance(int ms){Shadows.shadowOf(Looper.getMainLooper()).idleFor(Duration.ofMillis(ms));}
 @Before public void setup(){org.robolectric.util.ReflectionHelpers.callStaticMethod(android.animation.ValueAnimator.class,"setDurationScale",org.robolectric.util.ReflectionHelpers.ClassParameter.from(float.class,1f));org.robolectric.shadows.ShadowChoreographer.setPaused(true);org.robolectric.shadows.ShadowChoreographer.setFrameDelay(Duration.ofMillis(16));activity=Robolectric.buildActivity(Activity.class).setup().visible().get();button=new Button(activity);activity.setContentView(button);button.layout(0,0,200,100);advance(32);org.robolectric.util.ReflectionHelpers.setField(org.robolectric.util.ReflectionHelpers.getField(button,"mAttachInfo"),"mWindowVisibility",View.VISIBLE);assertTrue("attached",button.isAttachedToWindow());assertTrue("shown",button.isShown());assertEquals("window visibility",View.VISIBLE,button.getWindowVisibility());FlexyMotionSettings.setProfile(activity,FlexyMotionProfile.FLOW);FlexyMotionSettings.setReduceMotion(activity,false);}
 @After public void finish(){activity.setContentView(new View(activity));activity.finish();advance(32);assertEquals(0,FlexyFrameMotion.activeCount());}
 @Test public void scalesDoNotControlMigratedClock(){
  for(FlexyMotionProfile profile:FlexyMotionProfile.values()){FlexyMotionSettings.setProfile(activity,profile);float reference=0;
  for(float scale:new float[]{0,.5f,1,2,5}){
   org.robolectric.util.ReflectionHelpers.callStaticMethod(android.animation.ValueAnimator.class,"setDurationScale",org.robolectric.util.ReflectionHelpers.ClassParameter.from(float.class,scale));
   final float[] value={0};FlexyFrameMotion m=new FlexyFrameMotion(button,0,v->value[0]=v);m.animateTo(1);if(profile!=FlexyMotionProfile.FLASH)assertEquals(0,value[0],0);else assertEquals(1,value[0],0);advance(100);
   assertTrue(value[0]>0);if(scale==0)reference=value[0];else assertEquals(reference,value[0],.04f);
   m.dispose();
  }}
 }
 @Test public void retargetDoesNotJumpOrDuplicateClock(){final float[] value={0};FlexyFrameMotion m=new FlexyFrameMotion(button,0,v->value[0]=v);m.animateTo(1);advance(80);float before=value[0];m.animateTo(0);assertEquals(before,value[0],0);assertEquals(1,FlexyFrameMotion.activeCount());advance(1500);assertEquals(0,value[0],.001f);assertFalse(m.isRunning());m.dispose();}
 @Test public void flashAndReducedFinishImmediately(){int[] complete={0};FlexyFrameMotion m=new FlexyFrameMotion(button,0,v->{});FlexyMotionSettings.setProfile(activity,FlexyMotionProfile.FLASH);m.animateTo(1,()->complete[0]++);assertEquals(1,m.current(),0);assertEquals(1,complete[0]);assertEquals(0,FlexyFrameMotion.activeCount());FlexyMotionSettings.setProfile(activity,FlexyMotionProfile.SIGNATURE);m.animateTo(0,()->complete[0]++);FlexyMotionSettings.setReduceMotion(activity,true);assertEquals(0,m.current(),0);assertEquals(2,complete[0]);m.dispose();}
 @Test public void cancelNeverCompletesAndDetachStops(){int[] complete={0};FlexyFrameMotion m=new FlexyFrameMotion(button,0,v->{});m.animateTo(1,()->complete[0]++);m.cancel();advance(1500);assertEquals(0,complete[0]);m.animateTo(1,()->complete[0]++);activity.setContentView(new View(activity));advance(1500);assertFalse(m.isRunning());assertEquals(0,complete[0]);m.dispose();}
 @Test public void touchNeverChangesHitTransformOrAccumulatesScale(){FlexyTouchFeedback touch=new FlexyTouchFeedback(button);int width=button.getWidth();for(int i=0;i<50;i++){MotionEvent down=MotionEvent.obtain(0,0,0,80,40,0);touch.onTouch(down);advance(30);MotionEvent up=MotionEvent.obtain(0,30,1,80,40,0);touch.onTouch(up);down.recycle();up.recycle();assertEquals(1,button.getScaleX(),0);assertEquals(1,button.getScaleY(),0);assertEquals(width,button.getWidth());}advance(1500);assertEquals(1,touch.factor(),.001f);touch.dispose();}
 @Test public void reducedResetsHeldOrSettledPress(){FlexyTouchFeedback touch=new FlexyTouchFeedback(button);MotionEvent down=MotionEvent.obtain(0,0,0,80,40,0);touch.onTouch(down);advance(1500);assertTrue(touch.factor()<1);FlexyMotionSettings.setReduceMotion(activity,true);assertEquals(1,touch.factor(),0);assertEquals(0,FlexyFrameMotion.activeCount());down.recycle();touch.dispose();}
 @Test public void canvasCompressionDoesNotMutatePivotOrViewMatrix(){FlexyTouchFeedback touch=new FlexyTouchFeedback(button);MotionEvent down=MotionEvent.obtain(0,0,0,80,40,0);touch.onTouch(down);advance(80);Canvas c=new Canvas(Bitmap.createBitmap(200,100,Bitmap.Config.ARGB_8888));int save=c.save();touch.transform(c);assertEquals(1,button.getScaleX(),0);c.restoreToCount(save);touch.reset();assertEquals(1,touch.factor(),0);down.recycle();touch.dispose();}
 @Test public void settingsHaveSafeLimits(){FlexyMotionSettings.tune(activity,999,Float.NaN,-20,-1);FlexyMotionSettings.State s=FlexyMotionSettings.state(activity);assertEquals(2,s.speed,0);assertEquals(560,s.stiffness,0);assertEquals(.55f,s.damping,0);assertEquals(.94f,s.pressedScale,0);FlexyMotionSettings.setProfile(activity,FlexyMotionProfile.SIGNATURE);assertEquals(.945f,FlexyMotionSettings.state(activity).pressedScale,0);}
 @Test public void nativeNavigationRowNeverConsumesOrChangesHitBounds(){
  app.flexygram.settings.SignatureNavigationCell cell=new app.flexygram.settings.SignatureNavigationCell(activity,null);activity.setContentView(cell);cell.layout(0,0,300,60);int[] clicks={0};cell.setOnClickListener(v->clicks[0]++);
  MotionEvent down=MotionEvent.obtain(0,0,0,80,30,0),up=MotionEvent.obtain(0,50,1,80,30,0);assertTrue(cell.dispatchTouchEvent(down));advance(50);cell.dispatchTouchEvent(up);advance(50);assertEquals(1,clicks[0]);assertEquals(1,cell.getScaleX(),0);cell.bind("recycled",1,false);assertEquals(0,FlexyFrameMotion.activeCount());down.recycle();up.recycle();
 }
 @Test public void profilePageControlsMutateCentralStateWithoutRestart() throws Exception {
  app.flexygram.settings.SignatureMatteSettingsActivity.host=activity;FlexyMotionActivity page=new FlexyMotionActivity();java.lang.reflect.Method rows=FlexyMotionActivity.class.getDeclaredMethod("updateRows");rows.setAccessible(true);rows.invoke(page);java.lang.reflect.Method tap=FlexyMotionActivity.class.getDeclaredMethod("onItemClick",View.class,int.class,float.class,float.class);tap.setAccessible(true);
  java.lang.reflect.Field signature=FlexyMotionActivity.class.getDeclaredField("signature");signature.setAccessible(true);tap.invoke(page,button,signature.getInt(page),0f,0f);assertEquals(FlexyMotionProfile.SIGNATURE,FlexyMotionSettings.profile(activity));
  java.lang.reflect.Field reduced=FlexyMotionActivity.class.getDeclaredField("reduced");reduced.setAccessible(true);tap.invoke(page,button,reduced.getInt(page),0f,0f);assertTrue(FlexyMotionSettings.reduceMotion(activity));
 }
 @Test public void manualSnapDiscardsOldCompletion(){int[] completed={0};FlexyFrameMotion m=new FlexyFrameMotion(button,0,v->{});m.animateTo(1,()->completed[0]++);advance(32);m.snapTo(.5f);advance(1500);assertEquals(0,completed[0]);assertEquals(.5f,m.current(),0);m.dispose();}
 @Test public void hiddenOwnerStopsAtNextFrame(){FlexyFrameMotion m=new FlexyFrameMotion(button,0,v->{});m.animateTo(1);button.setVisibility(View.GONE);advance(32);assertFalse(m.isRunning());assertEquals(0,FlexyFrameMotion.activeCount());m.dispose();}
 @Test public void cancelAnotherOwnerDuringCallbackDoesNotSkipCleanup(){final FlexyFrameMotion[] other={null};FlexyFrameMotion first=new FlexyFrameMotion(button,0,v->{if(other[0]!=null)other[0].cancel();});other[0]=new FlexyFrameMotion(button,0,v->{});first.animateTo(1);other[0].animateTo(1);advance(100);assertFalse(other[0].isRunning());first.dispose();other[0].dispose();}
 @Test public void multipleOwnersShareClockAndReleaseAll(){FlexyFrameMotion a=new FlexyFrameMotion(button,0,v->{}),b=new FlexyFrameMotion(button,1,v->{});a.animateTo(1);b.animateTo(0);assertEquals(2,FlexyFrameMotion.activeCount());advance(1500);assertEquals(0,FlexyFrameMotion.activeCount());a.dispose();b.dispose();}
 PopupMotionProbe popup(){
  android.widget.FrameLayout content=new android.widget.FrameLayout(activity);content.addView(new PopupMotionProbe.ActionBarPopupWindowLayout(activity),new android.widget.FrameLayout.LayoutParams(300,100));
  PopupMotionProbe p=new PopupMotionProbe(content);p.setAnimationStyle(0);p.setFlexyMotionEnabled(true);p.showAtLocation(button,Gravity.TOP|Gravity.LEFT,0,0);advance(32);
  org.robolectric.util.ReflectionHelpers.setField(org.robolectric.util.ReflectionHelpers.getField(content,"mAttachInfo"),"mWindowVisibility",View.VISIBLE);
  assertTrue(content.isAttachedToWindow());assertTrue(content.isShown());return p;
 }
 @Test public void optedInPopupHasOnlyOneOwnerAndForcedCloseReleasesExactlyOnce(){
  PopupMotionProbe p=popup();p.dismiss(true);Object owner=p.current();assertNotNull(owner);assertTrue(p.notificationsLocker.held);assertNull(org.robolectric.util.ReflectionHelpers.getField(p,"windowAnimatorSet"));
  for(int i=0;i<50;i++)p.dismiss(true);assertSame(owner,p.current());assertEquals(1,p.notificationsLocker.locks);advance(64);assertTrue(p.isShowing());
  p.dismiss(false);assertFalse(p.isShowing());assertNull(p.current());assertEquals(1,p.notificationsLocker.releases);assertEquals(1,p.unregisters);advance(500);assertEquals(1,p.unregisters);
 }
 @Test public void optedInPopupCompletesNativeDismissAndUnlocks(){PopupMotionProbe p=popup();p.dismiss(true);advance(500);assertFalse(p.isShowing());assertNull(p.current());assertEquals(1,p.unregisters);assertEquals(p.notificationsLocker.locks,p.notificationsLocker.releases);assertEquals(0,FlexyFrameMotion.activeCount());}
 @Test public void popupClockIsIndependentForEveryProfileAndAndroidScale(){
  for(FlexyMotionProfile profile:FlexyMotionProfile.values())for(float scale:new float[]{0,.5f,1,2,5}){
   org.robolectric.util.ReflectionHelpers.callStaticMethod(android.animation.ValueAnimator.class,"setDurationScale",org.robolectric.util.ReflectionHelpers.ClassParameter.from(float.class,scale));
   FlexyMotionSettings.setProfile(activity,profile);PopupMotionProbe p=popup();p.dismiss(true);
   if(profile==FlexyMotionProfile.FLASH)assertFalse(p.isShowing());else{assertTrue(p.isShowing());advance(64);assertTrue(p.isShowing());advance(500);assertFalse(p.isShowing());}
   assertEquals(1,p.unregisters);assertEquals(1,p.notificationsLocker.releases);
  }
 }
 @Test public void reduceMotionFinishesPopupWithoutStaleCompletion(){PopupMotionProbe p=popup();p.dismiss(true);advance(32);FlexyMotionSettings.setReduceMotion(activity,true);assertFalse(p.isShowing());assertEquals(1,p.unregisters);advance(500);assertEquals(1,p.unregisters);assertEquals(1,p.notificationsLocker.releases);}
 @Test public void popupDetachStillReleasesNativeWindowAndNotifications(){PopupMotionProbe p=popup();p.dismiss(true);View content=p.getContentView();((android.view.ViewGroup)content.getParent()).removeView(content);advance(32);assertFalse(p.isShowing());assertEquals(1,p.notificationsLocker.releases);assertNull(p.current());}
 @Test public void adapterPauseSeekResumeAndCancelPreserveListenerContract(){
  int[] events={0,0,0,0,0};float[] value={0};FlexyMotionAnimator a=new FlexyMotionAnimator(button,0,1,v->value[0]=v);a.setDuration(240);
  a.addListener(new android.animation.AnimatorListenerAdapter(){public void onAnimationStart(android.animation.Animator x){events[0]++;}public void onAnimationCancel(android.animation.Animator x){events[1]++;}public void onAnimationEnd(android.animation.Animator x){events[2]++;}});
  a.addPauseListener(new android.animation.Animator.AnimatorPauseListener(){public void onAnimationPause(android.animation.Animator x){events[3]++;}public void onAnimationResume(android.animation.Animator x){events[4]++;}});
  a.start();advance(32);a.setCurrentFraction(.4f);float before=value[0];assertTrue(a.isPaused());advance(100);assertEquals(before,value[0],0);a.resume();advance(32);assertTrue(value[0]>=before);a.cancel();advance(500);assertEquals(1,events[0]);assertEquals(1,events[1]);assertEquals(1,events[2]);assertEquals(1,events[3]);assertEquals(1,events[4]);assertEquals(0,FlexyFrameMotion.activeCount());
 }

 @Test public void unoptedPopupRetainsNativeAnimator(){PopupMotionProbe p=popup();p.setFlexyMotionEnabled(false);p.dismiss(true);assertNull(p.current());assertNotNull(org.robolectric.util.ReflectionHelpers.getField(p,"windowAnimatorSet"));p.dismiss(false);advance(500);assertFalse(p.isShowing());assertEquals(p.notificationsLocker.locks,p.notificationsLocker.releases);}
 @Test public void cancelRemovesDeferredDetachCompletion(){int[] ends={0};FlexyMotionAnimator a=new FlexyMotionAnimator(button,0,1,v->{});a.addListener(new android.animation.AnimatorListenerAdapter(){public void onAnimationEnd(android.animation.Animator x){ends[0]++;}});a.start();activity.setContentView(new View(activity));assertEquals(0,ends[0]);assertEquals(0,FlexyFrameMotion.activeCount());a.cancel();assertEquals(1,ends[0]);advance(500);assertEquals(1,ends[0]);}

 @Test public void unchangedReducedMotionIsNotRedispatchedRecursively(){FlexyMotionSettings.setReduceMotion(activity,true);int[] callbacks={0};FlexyFrameMotion m=new FlexyFrameMotion(button,0,v->{callbacks[0]++;if(v==1)FlexyMotionSettings.setReduceMotion(activity,true);});m.animateTo(1);assertEquals(1,callbacks[0]);assertEquals(0,FlexyFrameMotion.activeCount());m.dispose();}


 MainTabsLayout tabs(){
  MainTabsLayout tabs=new MainTabsLayout(activity);activity.setContentView(tabs);advance(32);
  for(int i=0;i<3;i++){MainTabsLayout.GlassTabView child=new MainTabsLayout.GlassTabView(activity);tabs.addView(child,new android.widget.FrameLayout.LayoutParams(100,50));}
  tabs.measure(View.MeasureSpec.makeMeasureSpec(300,View.MeasureSpec.EXACTLY),View.MeasureSpec.makeMeasureSpec(50,View.MeasureSpec.EXACTLY));tabs.layout(0,0,300,50);
  for(int i=0;i<3;i++)tabs.getChildAt(i).layout(i*100,0,(i+1)*100,50);
  tabs.setTabSelected(tabs.getChildAt(0),false);return tabs;
 }
 @Test public void tabFingerWritesRemainAuthoritativeAcrossRetargetAndSettings(){
  MainTabsLayout t=tabs();FlexyMotionSettings.setProfile(activity,FlexyMotionProfile.SIGNATURE);
  t.begin(50);t.move(210);assertEquals(210,t.center(),0);advance(32);assertEquals(210,t.center(),0);
  FlexyMotionSettings.setProfile(activity,FlexyMotionProfile.FLOW);assertEquals(210,t.center(),0);t.finish(210);advance(1500);assertEquals(250,t.center(),0);assertFalse(t.custom());
 }
 @Test public void tabDetachCancelsLongPressWithoutCommittingNavigation(){
  MainTabsLayout t=tabs();int[] clicks={0};for(int i=0;i<3;i++)t.getChildAt(i).setOnClickListener(v->clicks[0]++);
  t.begin(50);t.move(210);activity.setContentView(new View(activity));advance(1500);
  assertEquals(0,clicks[0]);assertFalse(t.custom());assertEquals(1,t.getScaleX(),0);assertEquals(1,t.getScaleY(),0);assertEquals(0,FlexyFrameMotion.activeCount());
 }
 @Test public void tabProfilesRespectEveryAndroidScaleAndKeepClickImmediate(){
  for(FlexyMotionProfile p:FlexyMotionProfile.values())for(float scale:new float[]{0,.5f,1,2,5}){
   org.robolectric.util.ReflectionHelpers.callStaticMethod(android.animation.ValueAnimator.class,"setDurationScale",org.robolectric.util.ReflectionHelpers.ClassParameter.from(float.class,scale));
   FlexyMotionSettings.setProfile(activity,p);MainTabsLayout t=tabs();int[] clicks={0};t.getChildAt(2).setOnClickListener(v->clicks[0]++);
   t.begin(50);t.move(210);t.finish(210);assertEquals(1,clicks[0]);
   if(p==FlexyMotionProfile.FLASH){assertEquals(250,t.center(),0);assertFalse(t.custom());assertEquals(1,t.getScaleX(),0);}else{advance(32);assertTrue(t.center()!=250);advance(1500);assertEquals(250,t.center(),0);assertFalse(t.custom());}
   activity.setContentView(new View(activity));advance(32);assertEquals(0,FlexyFrameMotion.activeCount());
  }
 }
 @Test public void tabReduceMotionDuringDragKeepsFingerPositionAndClearsPulse(){MainTabsLayout t=tabs();t.begin(50);t.move(190);advance(64);FlexyMotionSettings.setReduceMotion(activity,true);assertEquals(190,t.center(),0);assertEquals(1,t.getScaleX(),0);t.finish(190);assertEquals(150,t.center(),0);assertFalse(t.custom());}
 @Test public void pixelSpringSettlesExactlyAndDisposesWithoutIdleFrames(){float[] p={0};FlexyBoundSpring s=new FlexyBoundSpring(button,()->p[0],v->p[0]=v);s.animateToFinalPosition(100);advance(1500);assertEquals(100,p[0],0);assertEquals(0,FlexyFrameMotion.activeCount());p[0]=80;s.animateToFinalPosition(20);advance(32);assertTrue(p[0]>20&&p[0]<80);s.dispose();advance(1000);assertEquals(0,FlexyFrameMotion.activeCount());}

 @Test public void flashDuringTabReturnRestoresSelectorImmediately(){MainTabsLayout t=tabs();t.begin(50);t.move(210);t.finish(210);assertTrue(t.custom());FlexyMotionSettings.setProfile(activity,FlexyMotionProfile.FLASH);assertFalse(t.custom());assertEquals(250,t.center(),0);assertEquals(1,t.getScaleX(),0);}
 @Test public void hidingTabWindowCancelsWithoutSelectionAndCanReattach(){MainTabsLayout t=tabs();int[] clicks={0};t.getChildAt(2).setOnClickListener(v->clicks[0]++);t.begin(50);t.move(210);t.onWindowVisibilityChanged(View.INVISIBLE);advance(1000);assertEquals(0,clicks[0]);assertFalse(t.custom());assertEquals(0,FlexyFrameMotion.activeCount());t.onWindowVisibilityChanged(View.VISIBLE);t.begin(50);t.move(210);t.finish(210);assertEquals(1,clicks[0]);}

 @Test public void settingsCallbackCanDisposeWithoutWritingDestroyedView(){int[] writes={0};FlexyFrameMotion m=new FlexyFrameMotion(button,0,v->writes[0]++);m.setOnSettingsChanged(m::dispose);FlexyMotionSettings.setProfile(activity,FlexyMotionProfile.FLASH);assertEquals(0,writes[0]);assertEquals(0,FlexyFrameMotion.activeCount());}

 @Test public void nativeBounceUsesProfilesAcrossAllAndroidScalesWithoutViewTransforms(){
  for(FlexyMotionProfile p:FlexyMotionProfile.values())for(float scale:new float[]{0,.5f,1,2,5}){
   org.robolectric.util.ReflectionHelpers.callStaticMethod(android.animation.ValueAnimator.class,"setDurationScale",org.robolectric.util.ReflectionHelpers.ClassParameter.from(float.class,scale));
   FlexyMotionSettings.setProfile(activity,p);org.telegram.ui.Components.ButtonBounce b=new org.telegram.ui.Components.ButtonBounce(button);
   b.setPressed(true);advance(32);assertTrue(b.isPressed());assertEquals(1,button.getScaleX(),0);assertEquals(1,button.getScaleY(),0);
   assertNull(org.robolectric.util.ReflectionHelpers.getField(b,"animator"));
   if(p==FlexyMotionProfile.FLASH)assertEquals(1,b.getScale(.1f),0);else assertTrue(b.getScale(.1f)<1);
   b.setPressed(false);advance(2000);assertFalse(b.isPressed());assertEquals(1,b.getScale(.1f),.00001f);assertEquals(0,FlexyFrameMotion.activeCount());b.setView(null);
  }
 }
 @Test public void bounceRapidReversalsAndReduceMotionKeepNativePressedState(){org.telegram.ui.Components.ButtonBounce b=new org.telegram.ui.Components.ButtonBounce(button);for(int i=0;i<100;i++){b.setPressed(true);advance(16);b.setPressed(false);advance(16);}b.setPressed(true);advance(32);FlexyMotionSettings.setReduceMotion(activity,true);assertTrue(b.isPressed());assertEquals(1,b.getScale(.2f),0);assertEquals(0,b.isPressedProgress(),0);assertEquals(0,FlexyFrameMotion.activeCount());b.setView(null);}
 @Test public void bounceDetachCancelsDeferredReleaseAndRebindDoesNotCompressNewOwner(){org.telegram.ui.Components.ButtonBounce b=new org.telegram.ui.Components.ButtonBounce(button);b.setReleaseDelay(1000);b.setPressed(true);advance(64);b.setPressed(false);activity.setContentView(new View(activity));advance(1500);assertEquals(0,FlexyFrameMotion.activeCount());assertEquals(1,b.getScale(.1f),0);Button other=new Button(activity);activity.setContentView(other);advance(32);b.setView(other);assertEquals(1,b.getScale(.1f),0);b.setPressed(true);advance(32);assertTrue(b.getScale(.1f)<1);b.setView(null);assertEquals(0,FlexyFrameMotion.activeCount());}
 @Test public void bouncePulseSharesClockAndWindowHideResetsHeldTransform(){org.telegram.ui.Components.ButtonBounce b=new org.telegram.ui.Components.ButtonBounce(button);b.setPressed(true);b.bounce();advance(32);assertTrue(b.getScale(.1f)<1);app.flexygram.motion.FlexyButtonBounce helper=org.robolectric.util.ReflectionHelpers.getField(b,"signatureMotion");helper.onWindowVisibilityChanged(View.INVISIBLE);assertEquals(1,b.getScale(.1f),0);assertEquals(0,FlexyFrameMotion.activeCount());b.setView(null);}
 @Test public void nonConnectedBounceRetainsNativeAnimatorAndNullOwnerFallback(){org.telegram.messenger.BuildConfig.CONNECTED_ALPHA=false;try{org.telegram.ui.Components.ButtonBounce b=new org.telegram.ui.Components.ButtonBounce(button);b.setPressed(true);assertNotNull(org.robolectric.util.ReflectionHelpers.getField(b,"animator"));assertNull(org.robolectric.util.ReflectionHelpers.getField(b,"signatureMotion"));b.setPressed(false);advance(2000);}finally{org.telegram.messenger.BuildConfig.CONNECTED_ALPHA=true;}org.telegram.ui.Components.ButtonBounce b=new org.telegram.ui.Components.ButtonBounce(null);b.setPressed(true);assertNotNull(org.robolectric.util.ReflectionHelpers.getField(b,"animator"));b.setView(button);b.setPressed(false);assertNull(org.robolectric.util.ReflectionHelpers.getField(b,"animator"));b.setView(null);}

 @Test public void tabColorLogicalSelectionChangesBeforeAnimationAndReversesContinuously(){float[] value={0};FlexyBooleanMotion m=new FlexyBooleanMotion(button,300,new android.view.animation.LinearInterpolator(),v->value[0]=v);m.setValue(true,true);assertTrue(m.getValue());assertEquals(0,value[0],0);advance(64);float before=value[0];assertTrue(before>0&&before<1);m.setValue(false,true);assertFalse(m.getValue());assertEquals(before,value[0],0);advance(500);assertEquals(0,value[0],0);m.disposeFrames();}
 @Test public void tabColorProfilesAreBoundedAndIndependentOfAndroidScale(){for(FlexyMotionProfile profile:FlexyMotionProfile.values())for(float scale:new float[]{0,.5f,1,2,5}){org.robolectric.util.ReflectionHelpers.callStaticMethod(android.animation.ValueAnimator.class,"setDurationScale",org.robolectric.util.ReflectionHelpers.ClassParameter.from(float.class,scale));FlexyMotionSettings.setProfile(activity,profile);FlexyBooleanMotion m=new FlexyBooleanMotion(button,300,new android.view.animation.OvershootInterpolator(3),v->{assertTrue(v>=0&&v<=1);});m.setValue(true,true);assertTrue(m.getValue());if(profile==FlexyMotionProfile.FLASH)assertEquals(1,m.getFloatValue(),0);else{advance(32);assertTrue(m.getFloatValue()>0);advance(500);assertEquals(1,m.getFloatValue(),0);}m.disposeFrames();}}
 @Test public void tabColorInstantForcedValuesAndLiveReduceHaveNoIdleCallbacks(){FlexyBooleanMotion m=new FlexyBooleanMotion(button,300,null,v->{});m.setValue(true,false);assertEquals(1,m.getFloatValue(),0);assertEquals(0,FlexyFrameMotion.activeCount());m.setValue(false,true);advance(32);FlexyMotionSettings.setReduceMotion(activity,true);assertEquals(0,m.getFloatValue(),0);assertEquals(0,FlexyFrameMotion.activeCount());m.disposeFrames();}

 PlayerMotionProbe player(){PlayerMotionProbe p=new PlayerMotionProbe(activity);activity.setContentView(p);advance(32);return p;}
 @Test public void playerMorphRetargetCancelsOldCompletionAndPreservesCurrentValue(){PlayerMotionProbe p=player();int[] ends={0,0};p.morph(0,1,400,()->ends[0]++);advance(80);float before=p.morphProgress;assertTrue(before>0&&before<1);p.morph(before,0,200,()->ends[1]++);assertEquals(before,p.morphProgress,0);advance(500);assertEquals(0,p.morphProgress,0);assertArrayEquals(new int[]{0,1},ends);p.detachProtocol();}
 @Test public void playerMorphAndLyricsAreIndependentOfEveryAndroidScale(){for(FlexyMotionProfile profile:FlexyMotionProfile.values())for(float scale:new float[]{0,.5f,1,2,5}){org.robolectric.util.ReflectionHelpers.callStaticMethod(android.animation.ValueAnimator.class,"setDurationScale",org.robolectric.util.ReflectionHelpers.ClassParameter.from(float.class,scale));FlexyMotionSettings.setProfile(activity,profile);PlayerMotionProbe p=player();int[] ends={0};p.morph(0,1,420,()->ends[0]++);p.lyrics(true,true);assertTrue(p.lyricsMode);if(profile==FlexyMotionProfile.FLASH){assertEquals(1,p.morphProgress,0);assertEquals(1,p.lyricsFraction,0);}else{advance(32);assertTrue(p.morphProgress>0&&p.morphProgress<1);advance(800);assertEquals(1,p.morphProgress,0);assertEquals(1,p.lyricsFraction,0);}assertEquals(1,ends[0]);p.detachProtocol();}}
