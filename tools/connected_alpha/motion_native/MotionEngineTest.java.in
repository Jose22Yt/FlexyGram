 @Test public void predictiveBackMatchesOriginalGeometryAtEquivalentTimelineFractions(){for(boolean revert:new boolean[]{true,false})for(float fraction:new float[]{0,.1f,.5f,.9f,1}){NavigationMotionProbe legacy=navigation();legacy.predictiveBackAnimation.start(300,600,200,true,16);legacy.predictiveBackAnimation.update(.6f,260);legacy.predictiveBackY=260;legacy.containerView.setAlpha(.8f);android.animation.Animator old;org.telegram.messenger.BuildConfig.CONNECTED_ALPHA=false;try{old=legacy.predictiveTimeline(revert);}finally{org.telegram.messenger.BuildConfig.CONNECTED_ALPHA=true;}android.animation.ValueAnimator nativeValue=(android.animation.ValueAnimator)((android.animation.AnimatorSet)old).getChildAnimations().get(0);nativeValue.setCurrentFraction(fraction);NavigationMotionProbe next=navigation();next.predictiveBackAnimation.start(300,600,200,true,16);next.predictiveBackAnimation.update(.6f,260);next.predictiveBackY=260;next.containerView.setAlpha(.8f);FlexyMotionAnimator shared=(FlexyMotionAnimator)next.predictiveTimeline(revert);shared.start();shared.setCurrentFraction(fraction);android.graphics.RectF before=new android.graphics.RectF(),after=new android.graphics.RectF();legacy.predictiveBackAnimation.getClosingRect(before);next.predictiveBackAnimation.getClosingRect(after);assertEquals(before.left,after.left,.0001f);assertEquals(before.top,after.top,.0001f);assertEquals(before.right,after.right,.0001f);assertEquals(before.bottom,after.bottom,.0001f);assertEquals(legacy.predictiveBackAnimation.getCornerRadius(),next.predictiveBackAnimation.getCornerRadius(),.0001f);assertEquals(legacy.predictiveBackAnimation.getScrimAlpha(true),next.predictiveBackAnimation.getScrimAlpha(true));assertEquals(legacy.containerView.getAlpha(),next.containerView.getAlpha(),.0001f);assertEquals(legacy.inner,next.inner,.0001f);shared.cancel();}}
