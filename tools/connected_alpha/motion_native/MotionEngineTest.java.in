 void acceptGestureProbeDestination(GestureOpeningProbe p,GestureOpeningProbe.BaseFragment target){org.robolectric.util.ReflectionHelpers.callInstanceMethod(p,"reportInstantNavigation",org.robolectric.util.ReflectionHelpers.ClassParameter.from(org.telegram.ui.ActionBar.FlexyInstantNavigationCoordinator.State.class,org.telegram.ui.ActionBar.FlexyInstantNavigationCoordinator.State.OPENING),org.robolectric.util.ReflectionHelpers.ClassParameter.from(GestureOpeningProbe.BaseFragment.class,target),org.robolectric.util.ReflectionHelpers.ClassParameter.from(org.telegram.ui.ActionBar.FlexyInstantNavigationCoordinator.Kind.class,org.telegram.ui.ActionBar.FlexyInstantNavigationCoordinator.Kind.OPEN_SCREEN));}
 void installNewGestureProbeActor(GestureOpeningProbe p){p.transitionAnimationInProgress=true;p.onOpenAnimationEndRunnable=()->{};p.currentSpringAnimation=new app.flexygram.motion.SpringAnimation(p,new androidx.dynamicanimation.animation.FloatValueHolder(0)).setSpring(new androidx.dynamicanimation.animation.SpringForce(1000));p.currentSpringAnimation.start();p.containerView.setTranslationX(123);p.inner=123;}
