/* Production preview/layout and extracted production tap routing. Native menu/network are NOT run. */
import org.junit.*;import org.junit.runner.RunWith;import static org.junit.Assert.*;import android.view.*;import android.widget.*;import android.app.Activity;import android.graphics.*;import org.robolectric.*;import org.robolectric.annotation.*;import org.robolectric.util.ReflectionHelpers;import java.time.Duration;import app.flexygram.navigation.*;import app.flexygram.bubbles.interaction.*;import org.telegram.ui.MainTabsLayout;
@RunWith(RobolectricTestRunner.class) @Config(manifest=Config.NONE,sdk=35) @LooperMode(LooperMode.Mode.PAUSED)
public class Interaction2Test{
 Activity a;FrameLayout root;
 @Before public void start(){a=Robolectric.buildActivity(Activity.class).setup().get();org.telegram.messenger.ApplicationLoader.applicationContext=a;root=new FrameLayout(a);a.setContentView(root);a.getSharedPreferences("flexy_liquid_navigation",0).edit().clear().commit();ReflectionHelpers.setStaticField(LiquidNavigationConfig.class,"loaded",false);a.getSharedPreferences("flexy_bubble_interaction",0).edit().clear().commit();ReflectionHelpers.setStaticField(BubbleInteractionSettings.class,"tapPanel",null);}
 @After public void end(){root.removeAllViews();a.finish();}
 @Test public void singleContactRoutesOnceToMenuWithTapOriginAndNeverLongPress(){var cell=new org.telegram.ui.Cells.ChatMessageCell(a);root.addView(cell);cell.arm();Shadows.shadowOf(android.os.Looper.getMainLooper()).idleFor(Duration.ofMillis(80));var e=MotionEvent.obtain(0,80,1,10,10,0);cell.signatureTapEvent(e);e.recycle();assertTrue(cell.isSignatureTap());var host=new TapDispatchProbe();host.click(cell,10,10);assertEquals(1,host.calls);assertTrue(host.single);assertTrue(host.tap);assertFalse(host.longPress);assertFalse(cell.isSignatureTap());}
 @Test public void defaultCompleteInteractionAndExplicitOptOutSurviveReload(){assertTrue(BubbleInteractionSettings.tapPanel(a));BubbleInteractionSettings.tapPanel(a,false);ReflectionHelpers.setStaticField(BubbleInteractionSettings.class,"tapPanel",null);assertFalse(BubbleInteractionSettings.tapPanel(a));BubbleInteractionSettings.resetTap(a);assertTrue(BubbleInteractionSettings.tapPanel(a));}
 @Test public void cancelledMovedMultiPointerAndLongContactsNeverBecomeSignatureTap(){for(int action:new int[]{2,3,5,6}){var c=new org.telegram.ui.Cells.ChatMessageCell(a);c.arm();var e=MotionEvent.obtain(0,10,action,300,300,0);c.signatureTapEvent(e);e.recycle();assertFalse(c.isSignatureTap());}var c=new org.telegram.ui.Cells.ChatMessageCell(a);c.arm();Shadows.shadowOf(android.os.Looper.getMainLooper()).idleFor(Duration.ofMillis(ViewConfiguration.getLongPressTimeout()+1));var e=MotionEvent.obtain(0,900,1,0,0,0);c.signatureTapEvent(e);e.recycle();assertFalse(c.isSignatureTap());}
 @Test public void optOutKeepsAnimationOnlyWithoutMenu(){BubbleInteractionSettings.tapPanel(a,false);var c=new org.telegram.ui.Cells.ChatMessageCell(a);c.arm();var e=MotionEvent.obtain(0,80,1,0,0,0);c.signatureTapEvent(e);e.recycle();var h=new TapDispatchProbe();h.click(c,0,0);assertEquals(0,h.calls);}
 @Test @GraphicsMode(GraphicsMode.Mode.NATIVE) public void previewTwoToSixLightDarkFontScaleAndNativeSelection()throws Exception{
  for(boolean dark:new boolean[]{false,true})for(int count=2;count<=6;count++){
   org.telegram.ui.ActionBar.Theme.dark=dark;int[] order=new int[count];for(int i=0;i<count;i++)order[i]=i;LiquidNavigationConfig.order(order);
   var preview=new LiquidNavigationPreviewView(a);root.addView(preview,new FrameLayout.LayoutParams(360,420));preview.settingsChanged();layout(360,440);
   MainTabsLayout bar=ReflectionHelpers.getField(preview,"bar");org.telegram.ui.Components.glass.GlassTabView[] tabs=ReflectionHelpers.getField(preview,"tabs");int visible=0;int min=999,max=0;
   for(var tab:tabs)if(tab.getVisibility()==View.VISIBLE){visible++;min=Math.min(min,tab.getWidth());max=Math.max(max,tab.getWidth());assertTrue(tab.getWidth()>=48);assertTrue(tab.getX()>=bar.getPaddingLeft()-1);assertTrue(tab.getX()+tab.getWidth()<=bar.getWidth()-bar.getPaddingRight()+1);}
   assertEquals(count,visible);assertTrue(max-min<=1);assertEquals(0,org.telegram.ui.Components.glass.GlassTabView.avatarBinds);
   tabs[count-1].performClick();Shadows.shadowOf(android.os.Looper.getMainLooper()).idleFor(Duration.ofSeconds(1));assertTrue(tabs[count-1].isTabSelected());
   Bitmap b=Bitmap.createBitmap(360,420,Bitmap.Config.ARGB_8888);preview.draw(new Canvas(b));try(var out=new java.io.FileOutputStream("bottom-"+count+"-"+(dark?"dark":"light")+"-isolated.png")){b.compress(Bitmap.CompressFormat.PNG,100,out);}b.recycle();root.removeView(preview);
  }
 }
 @Test public void liveSettingsChangeDimensionsAndSurviveRecreation(){var p=new LiquidNavigationPreviewView(a);root.addView(p);p.settingsChanged();layout(360,440);MainTabsLayout b=ReflectionHelpers.getField(p,"bar");int h=b.getHeight();LiquidNavigationConfig.compaction(3);LiquidNavigationConfig.value(LiquidNavigationConfig.Parameter.HEIGHT,100);p.settingsChanged();layout(360,460);assertTrue(b.getHeight()>h);ReflectionHelpers.setStaticField(LiquidNavigationConfig.class,"loaded",false);assertEquals(80,LiquidNavigationConfig.heightDp());}
 void layout(int w,int h){root.measure(View.MeasureSpec.makeMeasureSpec(w,1073741824),View.MeasureSpec.makeMeasureSpec(h,1073741824));root.layout(0,0,w,h);Shadows.shadowOf(android.os.Looper.getMainLooper()).idleFor(Duration.ofSeconds(1));}
}
