import org.junit.*;import org.junit.runner.RunWith;import static org.junit.Assert.*;import android.view.*;import android.widget.*;import android.app.Activity;import android.graphics.*;import org.robolectric.*;import org.robolectric.annotation.*;import org.robolectric.util.ReflectionHelpers;import java.time.Duration;import app.flexygram.navigation.*;import org.telegram.ui.MainTabsLayout;
@RunWith(RobolectricTestRunner.class) @Config(manifest=Config.NONE,sdk=35) @LooperMode(LooperMode.Mode.PAUSED)
public class Interaction2Test{
 Activity a;FrameLayout root;LiquidNavigationPreviewView preview;
 @Before public void setup(){a=Robolectric.buildActivity(Activity.class).setup().get();LiquidNavigationConfig.reset();LiquidNavigationConfig.enabled(true);root=new FrameLayout(a);a.setContentView(root);preview=new LiquidNavigationPreviewView(a);root.addView(preview,new FrameLayout.LayoutParams(360,-2));layout();}
 void layout(){root.measure(View.MeasureSpec.makeMeasureSpec(360,1073741824),View.MeasureSpec.makeMeasureSpec(600,1073741824));root.layout(0,0,360,600);Shadows.shadowOf(android.os.Looper.getMainLooper()).idleFor(Duration.ofSeconds(2));}
 @After public void end(){root.removeAllViews();a.finish();}
 @Test public void previewNeverBindsAnAccountAvatar(){assertEquals(0,org.telegram.ui.Components.glass.GlassTabView.avatarBinds);assertTrue(preview.getHeight()>300);}
 @Test public void previewShowsAllNineAndUsesProductionBar(){LiquidNavigationConfig.order(new int[]{0,1,2,3,4,5,6,7,8});preview.settingsChanged();layout();MainTabsLayout bar=ReflectionHelpers.getField(preview,"bar");int count=0;for(int i=0;i<bar.getChildCount();i++)if(bar.isViewVisible(bar.getChildAt(i)))count++;assertEquals(9,count);assertTrue(bar.getWidth()<=preview.getWidth());}
 @Test public void rootSettingsAreGroupedInsteadOfAnEndlessSliderList(){var settings=new LiquidNavigationSettingsActivity();ReflectionHelpers.callInstanceMethod(settings,"updateRows");int[] rows=ReflectionHelpers.getField(settings,"sections");assertEquals(4,rows.length);for(int n:rows)assertTrue(n>=0);int[] params=ReflectionHelpers.getField(settings,"parameterRows");for(int n:params)assertEquals(-1,n);}
 @Test public void everyCompactionAndExtremeCustomValueKeepsSafeTargets(){MainTabsLayout bar=ReflectionHelpers.getField(preview,"bar");LiquidNavigationConfig.order(new int[]{0,1,2,3,4,5,6,7,8});for(int mode=0;mode<5;mode++){LiquidNavigationConfig.compaction(mode);for(var p:LiquidNavigationConfig.Parameter.values())LiquidNavigationConfig.value(p,mode%2==0?0:100);preview.settingsChanged();layout();for(int i=0;i<bar.getChildCount();i++)if(bar.isViewVisible(bar.getChildAt(i)))assertTrue(bar.getChildAt(i).getWidth()>=48);}}
 @Test @GraphicsMode(GraphicsMode.Mode.NATIVE) public void renderSyntheticNineTabPreviewLightDarkAndHorizontalExpansion()throws Exception{
  LiquidNavigationConfig.order(new int[]{0,1,2,3,4,5,6,7,8});LiquidNavigationConfig.compaction(3);preview.settingsChanged();layout();
  MainTabsLayout bar=ReflectionHelpers.getField(preview,"bar");
  for(boolean dark:new boolean[]{false,true}){org.telegram.ui.ActionBar.Theme.dark=dark;preview.updateColors();Bitmap b=Bitmap.createBitmap(360,preview.getHeight(),Bitmap.Config.ARGB_8888);Canvas c=new Canvas(b);preview.draw(c);save(b,"preview-nine-"+(dark?"dark":"light")+"-isolated.png");
   var tab=bar.getChildAt(0);float x=tab.getX()+tab.getWidth()/2f;MotionEvent e=MotionEvent.obtain(0,0,0,x,40,0);bar.dispatchTouchEvent(e);e.recycle();Shadows.shadowOf(android.os.Looper.getMainLooper()).idleFor(Duration.ofMillis(280));preview.draw(c);save(b,"preview-expanded-"+(dark?"dark":"light")+"-isolated.png");e=MotionEvent.obtain(0,300,3,x,40,0);bar.dispatchTouchEvent(e);e.recycle();Shadows.shadowOf(android.os.Looper.getMainLooper()).idleFor(Duration.ofSeconds(2));b.recycle();}
 }
 void save(Bitmap b,String name)throws Exception{try(var f=new java.io.FileOutputStream(name)){b.compress(Bitmap.CompressFormat.PNG,100,f);}}
}
