import android.app.Activity;import android.os.Looper;import android.view.*;import android.widget.*;
import org.junit.*;import org.junit.runner.RunWith;import org.robolectric.*;import org.robolectric.annotation.*;
import static org.junit.Assert.*;

@RunWith(RobolectricTestRunner.class) @Config(manifest=Config.NONE,sdk=35)
public class HeaderTouchTest {
 private Activity activity;private FrameLayout root;private ControlOwner owner;
 private void layout(){owner.forceLayout();owner.measure(View.MeasureSpec.makeMeasureSpec(200,View.MeasureSpec.EXACTLY),View.MeasureSpec.makeMeasureSpec(60,View.MeasureSpec.EXACTLY));owner.layout(0,0,200,60);}
 @Before public void setup(){activity=Robolectric.buildActivity(Activity.class).setup().get();root=new FrameLayout(activity);activity.setContentView(root);owner=new ControlOwner(activity);root.addView(owner,new FrameLayout.LayoutParams(200,60));layout();}
 private void send(int action,float x,float y,long time){MotionEvent e=MotionEvent.obtain(0,time,action,x,y,0);assertTrue(owner.dispatchTouchEvent(e));e.recycle();}
 private void clickThroughMeasure(View button){float x=button.getX()+button.getWidth()/2f,y=button.getY()+button.getHeight()/2f;send(MotionEvent.ACTION_DOWN,x,y,0);Shadows.shadowOf(Looper.getMainLooper()).idleFor(java.time.Duration.ofMillis(130));layout();send(MotionEvent.ACTION_UP,x,y,150);Shadows.shadowOf(Looper.getMainLooper()).idle();}
 @Test public void nativePopupOpensAfterIntermediateMeasure(){
  TextView item=new TextView(activity);item.setText("Buscar");PopupWindow popup=new PopupWindow(item,180,100,true);
  owner.signatureMore.setOnClickListener(v->popup.showAsDropDown(v));
  clickThroughMeasure(owner.signatureMore);
  assertTrue("menu popup lost its click during measure",popup.isShowing());assertEquals("Buscar",((TextView)popup.getContentView()).getText());popup.dismiss();
 }
 @Test public void callClickSurvivesIntermediateMeasure(){int[]calls={0};owner.signatureCall.setOnClickListener(v->calls[0]++);clickThroughMeasure(owner.signatureCall);assertEquals("call click lost during measure",1,calls[0]);}
 @Test public void inactiveHeaderHidesCustomControls(){owner.active=false;layout();assertEquals(View.GONE,owner.signatureMore.getVisibility());assertEquals(View.GONE,owner.signatureCall.getVisibility());}
 @Test public void fullHeaderWidthKeepsEdgeButtonsTouchableAfterRootMeasure(){
  for(int width:new int[]{320,400,800})for(boolean nativeAction:new boolean[]{false,true}){
   HeaderHost host=new HeaderHost(activity);host.showAudioCallAsIcon=nativeAction;
   root.addView(host,new FrameLayout.LayoutParams(width,60));
   host.measure(View.MeasureSpec.makeMeasureSpec(width,View.MeasureSpec.EXACTLY),View.MeasureSpec.makeMeasureSpec(60,View.MeasureSpec.EXACTLY));host.layout(0,0,width,60);
   int[] clicks={0,0};TextView row=new TextView(activity);row.setText("Buscar");
   PopupWindow popup=new PopupWindow(row,180,100,true);
   host.more.setOnClickListener(v->{clicks[0]++;popup.showAsDropDown(v);});host.call.setOnClickListener(v->clicks[1]++);
   for(int button=0;button<2;button++){
    float x=width-(button==0?28:80);long now=android.os.SystemClock.uptimeMillis();
    MotionEvent down=MotionEvent.obtain(now,now,MotionEvent.ACTION_DOWN,x,30,0);host.dispatchTouchEvent(down);down.recycle();
    MotionEvent up=MotionEvent.obtain(now,now+20,MotionEvent.ACTION_UP,x,30,0);host.dispatchTouchEvent(up);up.recycle();Shadows.shadowOf(Looper.getMainLooper()).idle();
    if(button==0){assertTrue("visible edge button did not open its popup",popup.isShowing());popup.dismiss();}
   }
   assertEquals("overflow outside parent after chat root measure, width="+width+", nativeAction="+nativeAction,1,clicks[0]);
   assertEquals("call outside parent after chat root measure",1,clicks[1]);
   root.removeView(host);
  }
 }
 @Test public void nativeHeaderRetainsReservedMenuSpace(){
  for(boolean nativeAction:new boolean[]{false,true}){
   HeaderHost host=new HeaderHost(activity);host.signature=false;host.showAudioCallAsIcon=nativeAction;
   host.measure(View.MeasureSpec.makeMeasureSpec(400,View.MeasureSpec.EXACTLY),View.MeasureSpec.makeMeasureSpec(60,View.MeasureSpec.EXACTLY));
   assertEquals(nativeAction?92:52,((FrameLayout.LayoutParams)host.avatarContainer.getLayoutParams()).rightMargin);
  }
 }
}
