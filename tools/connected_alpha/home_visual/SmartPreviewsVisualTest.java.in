/* Actual DialogCell draw methods/native StaticLayout; explicit theme/mode/service doubles. */
import android.graphics.*;import android.text.*;import app.flexygram.home.*;
import org.junit.*;import org.junit.runner.RunWith;import org.robolectric.*;import org.robolectric.annotation.*;
import static org.junit.Assert.*;
@RunWith(RobolectricTestRunner.class) @Config(manifest=Config.NONE,sdk=35) @GraphicsMode(GraphicsMode.Mode.NATIVE)
public class SmartPreviewsVisualTest {
 @Test public void allKindsThemesFontScalesAndRtlStayInsideTheOriginalRow(){
  for(boolean rtl:new boolean[]{false,true})for(float font:new float[]{1,1.3f,1.6f,2})for(int mode=0;mode<3;mode++)for(int kind=1;kind<=9;kind++){
   SignatureSmartPreviews.value=mode;SmartPreviewCellProbe.Theme.surface=rtl?0xff151920:0xfff8f8fa;
   var v=new SmartPreviewCellProbe();v.bind(rtl?"ملف طويل document.pdf":"A very long document name.pdf",kind,rtl,font,320,72,0);
   Bitmap b=v.render(1);int pixels=0;
   for(int y=0;y<72;y++)for(int x=0;x<320;x++)if(Color.alpha(b.getPixel(x,y))>0){pixels++;assertTrue(x>=6&&x<314);assertTrue(y>=24&&y<70);}
   assertTrue("visible capsule",pixels>100);assertEquals(72,v.getHeight());
   assertTrue(SignatureSmartPreviewPalette.contrast(v.smartPreviewPalette.background(),v.smartPreviewPalette.foreground())>=4.5);
   Object paint=v.smartPreviewPaint;Bitmap second=v.render(.5f);assertSame(paint,v.smartPreviewPaint);
   second.recycle();b.recycle();
  }
 }
 @Test public void photoAndVideoKeepNativeThumbnailReservationAndText(){
  for(boolean rtl:new boolean[]{false,true})for(int kind:new int[]{6,7}){
   SignatureSmartPreviews.value=0;var v=new SmartPreviewCellProbe();v.bind("Photo",kind,rtl,1,320,72,1);
   assertTrue(v.messageLayout.getText() instanceof Spanned);
   Spanned text=(Spanned)v.messageLayout.getText();var spans=text.getSpans(0,text.length(),SmartPreviewCellProbe.ThumbnailSpan.class);
   assertEquals(1,spans.length);assertEquals(0,text.getSpanStart(spans[0]));assertTrue(text.toString().contains("Photo"));
   assertEquals(1,text.getSpans(0,text.length(),SignaturePreviewIcon.class).length);
   assertEquals(25,spans[0].getSize(v.messageLayout.getPaint(),text,0,1,null));
   v.render(1).recycle();assertEquals(72,v.getHeight());
  }
 }
 @Test public void recycledNormalRowsAndOffModeNeverRetainACapsule(){
  var v=new SmartPreviewCellProbe();SignatureSmartPreviews.value=0;v.bind("0:23",2,false,1,320,72,0);assertTrue(Color.alpha(v.render(1).getPixel(30,30))>0);
  v.bind("Normal",0,false,1,320,72,0);Bitmap blank=v.render(1);assertEquals(0,blank.getPixel(30,30));blank.recycle();
  v.bind("0:23",2,true,1,320,72,0);SignatureSmartPreviews.value=3;blank=v.render(1);
  for(int y=0;y<72;y++)for(int x=0;x<320;x++)assertEquals(0,blank.getPixel(x,y));blank.recycle();
 }
 @Test public void contextIsBasedOnRowSemanticsNotFolderNumbers(){
  for(int folder:new int[]{0,1,2,7,8,9,100,999}){
   assertTrue("conversation folder "+folder,SignaturePreviewContext.isMessageRow(true,false,false,false,false,false));
   assertTrue("topic folder "+folder,SignaturePreviewContext.isMessageRow(false,true,false,false,false,false));
  }
  assertFalse(SignaturePreviewContext.isMessageRow(true,false,true,false,false,false));
  assertFalse(SignaturePreviewContext.isMessageRow(true,false,false,true,false,false));
  assertFalse(SignaturePreviewContext.isMessageRow(true,false,false,false,true,false));
  assertFalse(SignaturePreviewContext.isMessageRow(true,false,false,false,false,true));
  assertFalse(SignaturePreviewContext.isMessageRow(false,false,false,false,false,false));
 }
 @Test public void nativeIconGeometryIsFixedAndReused(){
  TextPaint paint=new TextPaint(3);paint.setTextSize(12);Bitmap b=Bitmap.createBitmap(32,24,Bitmap.Config.ARGB_8888);Canvas c=new Canvas(b);
  for(int kind=1;kind<=9;kind++){b.eraseColor(0);SignaturePreviewIcon icon=new SignaturePreviewIcon(kind);assertEquals(16,icon.getSize(paint,"x",0,1,null));paint.setColor(Color.BLACK);icon.draw(c,"x",0,1,3,3,16,21,paint);
   int pixels=0;for(int y=0;y<24;y++)for(int x=0;x<32;x++)if(Color.alpha(b.getPixel(x,y))!=0){pixels++;assertTrue(x>=2&&x<=15);assertTrue(y>=4&&y<=20);}assertTrue("kind "+kind,pixels>2);
  }b.recycle();
 }
 @Test public void longFileKeepsIconAndSuffixWhenSpaceAllows(){
  SignatureSmartPreviews.value=0;SmartPreviewCellProbe v=new SmartPreviewCellProbe();v.bind("nagramxf_glass_bubbles_very_long_name.plugin",1,false,1,200,72,0);
  CharSequence text=v.messageLayout.getText();assertTrue(text.toString().startsWith("\ufffc"));assertTrue(text.toString().contains("…"));assertTrue(text.toString().endsWith(".plugin"));
  assertEquals(1,((Spanned)text).getSpans(0,text.length(),SignaturePreviewIcon.class).length);
 }
 @Test public void backgroundDoesNotCoverInlineSenderLtrOrRtl(){
  for(boolean rtl:new boolean[]{false,true}){
   SignatureSmartPreviews.value=0;SmartPreviewCellProbe v=new SmartPreviewCellProbe();v.bindInline(rtl?"أحمد: ":"Ana: ","example.org",rtl,320);
   float a=v.messageLeft+v.messageLayout.getPrimaryHorizontal(0),b=v.messageLeft+v.messageLayout.getPrimaryHorizontal(v.smartPreviewPrefixEnd);
   float e=v.messageLeft+v.messageLayout.getPrimaryHorizontal(v.messageLayout.getLineEnd(0));Bitmap image=v.renderBackground();
   int sender=Math.round((a+b)/2),pill=Math.round((b+e)/2);assertTrue(sender>=0&&sender<320&&pill>=0&&pill<320);
   assertEquals("sender must stay outside pill, rtl="+rtl,0,Color.alpha(image.getPixel(sender,30)));
   assertTrue("eligible content has background, rtl="+rtl,Color.alpha(image.getPixel(pill,30))>0);image.recycle();
  }
 }
 @Test public void forumAccentUsesExistingOpacityAndKeepsFixtureTextLegible(){
  for(boolean dark:new boolean[]{false,true})for(int accent:new int[]{0xff3986dd,0xff3baf77,0xff9970ce})for(int mode=0;mode<4;mode++){
   SignatureSmartPreviews.value=mode;int overlay=SignatureTopicAccent.overlay(accent,dark);assertEquals(accent&0xffffff,overlay&0xffffff);assertEquals(dark?36:26,Color.alpha(overlay));
   Bitmap b=Bitmap.createBitmap(1,1,Bitmap.Config.ARGB_8888);Canvas c=new Canvas(b);c.drawColor(dark?0xff151920:0xfff8f8fa);Paint p=new Paint();p.setColor(overlay);c.drawRect(0,0,1,1,p);
   assertTrue(SignatureSmartPreviewPalette.contrast(b.getPixel(0,0),dark?0xffe9edf3:0xff26313d)>=4.5);b.recycle();
  }
 }
 @Test public void bindTimeMetricsMatchTheActualAlpha1282RendererAfterRebinds(){
  for(boolean rtl:new boolean[]{false,true})for(float scale:new float[]{1,1.3f,2})for(int kind:new int[]{1,2,3,4,6,7}){
   SignatureSmartPreviews.value=0;var v=new SmartPreviewCellProbe();v.bind("long file name.plugin",kind,rtl,scale,320,72,kind==6?1:0);
   Bitmap a=v.renderBackground(),b=v.renderBaselineBackground();assertTrue("exact baseline pixels",a.sameAs(b));a.recycle();b.recycle();
   v.messageLeft+=7;a=v.renderBackground();b=v.renderBaselineBackground();assertTrue("translation remains live",a.sameAs(b));a.recycle();b.recycle();
   v.bindInline(rtl?"أحمد: ":"Ana: ","example.org",rtl,320);a=v.renderBackground();b=v.renderBaselineBackground();assertTrue("new layout invalidates metrics",a.sameAs(b));a.recycle();b.recycle();
  }
 }
 @Test public void generateSyntheticProductionCellMethodGrid()throws Exception{
  String[] names={"entry7555.zip","nagramxf_glass_bubbles.plugin","example.org","0:23","Song title","Photo","Video","Group event","Location","Contact","Topics · blue","Topics · green","Topics · violet"};
  int[] kinds={1,1,4,2,3,6,7,5,8,9,5,5,5};int[] accents={0xff3986dd,0xff3baf77,0xff9970ce};
  Bitmap grid=Bitmap.createBitmap(1200,1050,Bitmap.Config.ARGB_8888);Canvas out=new Canvas(grid);Paint p=new Paint(3);TextPaint label=new TextPaint(3);label.setTextSize(13);
  out.drawColor(0xfff8f8fa);p.setColor(0xff151920);out.drawRect(0,525,1200,1050,p);
  for(int dark=0;dark<2;dark++)for(int i=0;i<names.length;i++){
   int col=i%3,row=i/3+dark*5,x=col*400,y=row*105;int bg=dark==0?0xfff8f8fa:0xff151920,ink=dark==0?0xff26313d:0xffe9edf3;
   p.setColor(bg);out.drawRect(x,y,x+400,y+105,p);p.setColor(dark==0?0xffb6c8d9:0xff42566a);out.drawCircle(x+28,y+35,19,p);
   label.setColor(ink);out.drawText((dark==0?"LIGHT  ":"DARK  ")+names[i],x+58,y+18,label);out.drawText("12:47",x+345,y+18,label);
   SmartPreviewCellProbe.Theme.surface=bg;SmartPreviewCellProbe.Theme.accent=accents[i%3];SignatureSmartPreviews.value=0;
   if(i<10){SmartPreviewCellProbe cell=new SmartPreviewCellProbe();cell.bind(names[i],kinds[i],false,1,320,72,i==5||i==6?1:0);Bitmap rowBitmap=cell.render(1);out.drawBitmap(rowBitmap,x+55,y+24,p);rowBitmap.recycle();}
   p.setColor(dark==0?0xffb7c0c9:0xff637586);out.drawCircle(x+378,y+67,9,p);label.setColor(bg);out.drawText("8",x+374,y+72,label);
   if(i>=10){p.setColor(SignatureTopicAccent.overlay(accents[(i-10)%3],dark!=0));out.drawRoundRect(x+58,y+46,x+208,y+65,9,9,p);label.setColor(ink);out.drawText("General   Off-topic",x+64,y+60,label);}
  }
  try(java.io.FileOutputStream stream=new java.io.FileOutputStream(System.getProperty("probe.root")+"/smart-preview-micro-synthetic.png")){assertTrue(grid.compress(Bitmap.CompressFormat.PNG,100,stream));}grid.recycle();
 }

}
