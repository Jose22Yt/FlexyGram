<?xml version="1.0" ?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>app.flexygram</groupId>
  <artifactId>signature-music-visual-probe</artifactId>
  <version>1.0</version>
  <properties>
    <probe.proxy.host/>
    <probe.proxy.port>80</probe.proxy.port>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
  </properties>
  <dependencies>
    <dependency><groupId>androidx.core</groupId><artifactId>core</artifactId><version>1.17.0</version><type>aar</type><scope>test</scope><exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions></dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.robolectric</groupId>
      <artifactId>robolectric</artifactId>
      <version>4.17</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>local.android</groupId>
      <artifactId>android</artifactId>
      <version>37</version>
      <scope>system</scope>
      <systemPath>${android.sdk.jar}</systemPath>
    </dependency>
  </dependencies>
  <profiles><profile><id>music-compile</id><dependencies><dependency><groupId>local.androidx</groupId><artifactId>core</artifactId><version>1.17.0</version><scope>system</scope><systemPath>${project.basedir}/target/aar/core.jar</systemPath></dependency></dependencies></profile></profiles>
  <repositories>
    <repository>
      <id>central</id>
      <url>https://repo.maven.apache.org/maven2</url>
    </repository>
    <repository>
      <id>google</id>
      <url>https://dl.google.com/dl/android/maven2/</url>
    </repository>
  </repositories>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.5</version>
        <configuration>
          <additionalClasspathElements>
            <additionalClasspathElement>${project.build.directory}/aar/monitor.jar</additionalClasspathElement>
            <additionalClasspathElement>${project.build.directory}/aar/espresso-idling-resource.jar</additionalClasspathElement>
          </additionalClasspathElements>
          <systemPropertyVariables>
            <robolectric.dependency.repo.url>https://repo.maven.apache.org/maven2</robolectric.dependency.repo.url>
            <probe.root>${project.basedir}</probe.root>
            <https.proxyHost>${probe.proxy.host}</https.proxyHost>
            <https.proxyPort>${probe.proxy.port}</https.proxyPort>
            <http.proxyHost>${probe.proxy.host}</http.proxyHost>
            <http.proxyPort>${probe.proxy.port}</http.proxyPort>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
