/* Isolated production Android music widgets; fake playback, art decoder and fragment hosts.
 * No service/background/audio-focus/Telegram/device/performance certification. GPL-3.0-or-later. */
import android.app.*;import android.content.*;import android.content.res.*;import android.graphics.*;import android.os.*;import android.view.*;import android.widget.*;
import org.telegram.messenger.MediaController;import app.exteraless.player.*;import org.telegram.messenger.*;import org.telegram.ui.ActionBar.*;
import org.junit.*;import org.junit.runner.RunWith;import org.robolectric.*;import org.robolectric.annotation.*;
import java.io.*;import java.lang.reflect.*;import static org.junit.Assert.*;
@RunWith(RobolectricTestRunner.class) @Config(manifest=Config.NONE,sdk=35) @GraphicsMode(GraphicsMode.Mode.NATIVE)
public class MusicVisualTest {
 private Activity activity; private FrameLayout root;
 @Before public void setup(){activity=Robolectric.buildActivity(Activity.class).setup().get();root=new FrameLayout(activity);activity.setContentView(root);AndroidUtilities.density=1;BuildConfig.CONNECTED_ALPHA=true;Theme.dark=false;SignatureMusicPresentation.setCompact(false);MediaController mc=MediaController.getInstance();mc.message=new MessageObject();mc.paused=false;mc.nexts=mc.pauses=mc.plays=mc.stops=0;}
 private void size(View v,int w,int h){v.measure(View.MeasureSpec.makeMeasureSpec(w,View.MeasureSpec.EXACTLY),View.MeasureSpec.makeMeasureSpec(h,View.MeasureSpec.EXACTLY));v.layout(0,0,w,h);}
 private Object field(Object o,String n)throws Exception {Field f=o.getClass().getDeclaredField(n);f.setAccessible(true);return f.get(o);}
 @Test public void alphaPaletteIsSharedAndDoesNotEnterMaterialExtraction(){PlayerColors first=PlayerColors.fromSeed(0,false);for(int i=0;i<10000;i++)assertSame(first,PlayerColors.fromSeed(i,false));assertNotSame(first,PlayerColors.fromSeed(0,true));assertEquals(0xff008acb,first.primary);}
 @Test public void primaryControlsNeverResizeOnRapidTaps()throws Exception{ControlsRow row=new ControlsRow(activity);root.addView(row);size(row,320,140);View play=row.play;int left=play.getLeft(),width=play.getWidth();for(int i=0;i<1000;i++){row.play.setPressed(i%2==0);row.setPlaying(i%2==0,true);assertEquals(left,play.getLeft());assertEquals(width,play.getWidth());}assertTrue(row.prev.getRight()<play.getLeft());assertTrue(play.getRight()<row.next.getLeft());assertTrue(row.repeat.getTop()>=play.getBottom());}
 @Test public void seekCommitCancelAndAccessibilityAreNative(){WavySeekBar bar=new WavySeekBar(activity);root.addView(bar);size(bar,300,48);final int[] commits={0};final float[] result={-1};bar.setDelegate(new WavySeekBar.Delegate(){public void onSeekStart(){}public void onSeekMove(float p){}public void onSeekEnd(float p,boolean commit){if(commit)commits[0]++;result[0]=p;}});bar.setProgress(.2f);bar.onTouchEvent(MotionEvent.obtain(0,0,0,150,24,0));bar.onTouchEvent(MotionEvent.obtain(0,1,3,150,24,0));assertEquals(0,commits[0]);assertEquals(.2f,result[0],.001);Bundle b=new Bundle();b.putFloat(android.view.accessibility.AccessibilityNodeInfo.ACTION_ARGUMENT_PROGRESS_VALUE,75);assertTrue(bar.performAccessibilityAction(android.R.id.accessibilityActionSetProgress,b));assertEquals(.75f,result[0],.001);assertEquals(1,commits[0]);bar.setEnabled(false);assertFalse(bar.performAccessibilityAction(android.R.id.accessibilityActionSetProgress,b));}
 @Test public void oneHostCompressesWithoutStoppingAndCleansUp()throws Exception{size(root,360,760);BaseFragment fragment=new BaseFragment(root);final int[] changes={0};SignatureMusicHost[] host={null};host[0]=new SignatureMusicHost(fragment,null,()->{changes[0]++;host[0].update(true);});host[0].attach();host[0].update(true);assertEquals(1,root.getChildCount());View bubble=root.getChildAt(0);assertEquals(View.GONE,bubble.getVisibility());SignatureMusicPresentation.setCompact(true);assertEquals(View.VISIBLE,bubble.getVisibility());assertEquals(0,MediaController.getInstance().stops);size(bubble,56,56);bubble.onTouchEvent(MotionEvent.obtain(0,0,0,10,10,0));bubble.onTouchEvent(MotionEvent.obtain(0,20,2,999,999,0));bubble.onTouchEvent(MotionEvent.obtain(0,40,1,999,999,0));assertTrue(bubble.getX()<=292);assertTrue(bubble.getY()<=592);assertTrue(SignatureMusicPresentation.isCompact());bubble.performClick();assertFalse(SignatureMusicPresentation.isCompact());assertEquals(0,MediaController.getInstance().stops);MediaController.getInstance().message.music=false;SignatureMusicPresentation.setCompact(true);assertEquals(View.GONE,bubble.getVisibility());host[0].detach();assertEquals(0,root.getChildCount());int count=changes[0];SignatureMusicPresentation.setCompact(false);assertEquals(count,changes[0]);}
 @Test public void navigationCanDetachDuringBubbleDrag(){size(root,360,760);SignatureMusicHost host=new SignatureMusicHost(new BaseFragment(root),null,()->{});host.attach();SignatureMusicPresentation.setCompact(true);host.update(true);View bubble=root.getChildAt(0);size(bubble,56,56);bubble.onTouchEvent(MotionEvent.obtain(0,0,0,10,10,0));bubble.onTouchEvent(MotionEvent.obtain(0,20,2,100,100,0));host.detach();assertNull(bubble.getParent());bubble.onTouchEvent(MotionEvent.obtain(0,40,3,100,100,0));assertEquals(0,MediaController.getInstance().stops);}
 @Test public void miniUsesOriginalPlaybackActionsAndBalancedObservers()throws Exception{BaseFragment fragment=new BaseFragment(root);PlayerMiniView mini=new PlayerMiniView(activity,fragment,null);root.addView(mini);mini.update(false);size(root,360,760);size(mini,360,80);View play=(View)field(mini,"playButton"),next=(View)field(mini,"nextButton"),close=(View)field(mini,"closeButton");play.performClick();assertEquals(1,MediaController.getInstance().pauses);play.performClick();assertEquals(1,MediaController.getInstance().plays);next.performClick();assertEquals(1,MediaController.getInstance().nexts);close.performClick();assertTrue(SignatureMusicPresentation.isCompact());assertEquals(0,MediaController.getInstance().stops);root.removeView(mini);assertEquals(0,root.getChildCount());for(int a=0;a<UserConfig.MAX_ACCOUNT_COUNT;a++)assertTrue(NotificationCenter.getInstance(a).registrations.isEmpty());assertTrue(NotificationCenter.getGlobalInstance().registrations.isEmpty());}
 @Test public void shortScreensAndLargeFontsScrollWithoutControlOverlap(){for(float font:new float[]{1,1.5f,2,3})for(int width:new int[]{240,320,600}){Configuration config=new Configuration(activity.getResources().getConfiguration());config.fontScale=font;Context c=activity.createConfigurationContext(config);LayoutFixture f=new LayoutFixture(c,false);size(f,width,480);View[] v=f.ordered;for(int i=1;i<v.length;i++)assertTrue("overlap "+width+" font "+font+" index "+i,v[i].getTop()>=v[i-1].getBottom());assertTrue(f.content.getHeight()>=480);for(int i=0;i<v.length;i++){assertTrue(v[i].getLeft()>=0);assertTrue(v[i].getRight()<=width);}assertTrue(v[1].getWidth()<=Math.round((width-48)*.72f)||v[1].getWidth()==96);}}
 @Test public void lateMetadataOnSameMessageRefreshesBothMinis()throws Exception{PlayerBarView top=new PlayerBarView(activity,null,()->{},()->{});PlayerMiniView bottom=new PlayerMiniView(activity,new BaseFragment(root),null);top.update();bottom.update(false);MessageObject same=MediaController.getInstance().message;same.title="Updated title";same.artist="Updated artist";top.update();bottom.update(false);assertEquals("Updated title",((TextView)field(top,"titleView")).getText().toString());assertEquals("Updated artist",((TextView)field(top,"artistView")).getText().toString());assertEquals("Updated title",((TextView)field(bottom,"titleView")).getText().toString());assertEquals("Updated artist",((TextView)field(bottom,"artistView")).getText().toString());}
 @Test public void narrowMinisKeepAccessibleControlsAndText()throws Exception{for(int width:new int[]{240,320,600}){PlayerBarView top=new PlayerBarView(activity,null,()->{},()->{});top.update();size(top,width,64);View text=(View)field(top,"texts");View next=(View)field(top,"nextButton");assertTrue(text.getWidth()>40);assertEquals(width<320?View.GONE:View.VISIBLE,next.getVisibility());assertEquals(48,((View)field(top,"playButton")).getWidth());assertEquals(48,((View)field(top,"closeButton")).getWidth());PlayerMiniView bottom=new PlayerMiniView(activity,new BaseFragment(root),null);bottom.update(false);size(bottom,width,80);assertEquals(width<320?View.GONE:View.VISIBLE,((View)field(bottom,"nextButton")).getVisibility());}}
 @Test public void renderRealComponentLayoutAndMinisLightDark()throws Exception{Bitmap image=Bitmap.createBitmap(1080,1360,Bitmap.Config.ARGB_8888);Canvas canvas=new Canvas(image);for(int panel=0;panel<2;panel++){boolean dark=panel==1;Theme.dark=dark;LayoutFixture f=new LayoutFixture(activity,dark);root.addView(f);size(f,360,780);for(int step=0;step<20;step++){org.robolectric.shadows.ShadowSystemClock.advanceBy(java.time.Duration.ofMillis(33));f.draw(new Canvas(Bitmap.createBitmap(360,780,Bitmap.Config.ARGB_8888)));}canvas.save();canvas.translate(panel*540,0);canvas.scale(1.5f,1.5f);f.draw(canvas);canvas.restore();PlayerBarView bar=new PlayerBarView(activity,null,()->{},()->{});bar.update();size(bar,344,64);canvas.save();canvas.translate(panel*540+12,1210);canvas.scale(1.5f,1.5f);bar.draw(canvas);canvas.restore();root.removeView(f);}try(FileOutputStream out=new FileOutputStream(new File(System.getProperty("probe.root"),"android-music-isolated.png"))){assertTrue(image.compress(Bitmap.CompressFormat.PNG,100,out));}}
}
