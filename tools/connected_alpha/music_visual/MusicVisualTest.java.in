/* Isolated production Android music widgets; fake playback, art decoder and fragment hosts.
 * No service/background/audio-focus/Telegram/device/performance certification. GPL-3.0-or-later. */
import android.app.*;import android.content.*;import android.content.res.*;import android.graphics.*;import android.os.*;import android.view.*;import android.widget.*;
import org.telegram.messenger.MediaController;import app.exteraless.player.*;import org.telegram.messenger.*;import org.telegram.ui.ActionBar.*;
import org.junit.*;import org.junit.runner.RunWith;import org.robolectric.*;import org.robolectric.annotation.*;
import java.io.*;import java.lang.reflect.*;import static org.junit.Assert.*;
@RunWith(RobolectricTestRunner.class) @Config(manifest=Config.NONE,sdk=35) @GraphicsMode(GraphicsMode.Mode.NATIVE)
public class MusicVisualTest {
 private Activity activity; private FrameLayout root;
 @Before public void setup(){activity=Robolectric.buildActivity(Activity.class).setup().get();root=new FrameLayout(activity);activity.setContentView(root);AndroidUtilities.density=1;BuildConfig.CONNECTED_ALPHA=true;Theme.dark=false;SignatureMusicPresentation.setCompact(false);MediaController mc=MediaController.getInstance();mc.message=new MessageObject();mc.paused=false;mc.nexts=mc.pauses=mc.plays=mc.stops=0;}
 private void size(View v,int w,int h){v.measure(View.MeasureSpec.makeMeasureSpec(w,View.MeasureSpec.EXACTLY),View.MeasureSpec.makeMeasureSpec(h,View.MeasureSpec.EXACTLY));v.layout(0,0,w,h);}
 private Object field(Object o,String n)throws Exception {Field f=o.getClass().getDeclaredField(n);f.setAccessible(true);return f.get(o);}
 @Test public void alphaPaletteIsSharedAndDoesNotEnterMaterialExtraction(){PlayerColors first=PlayerColors.fromSeed(0,false);for(int i=0;i<10000;i++)assertSame(first,PlayerColors.fromSeed(i,false));assertNotSame(first,PlayerColors.fromSeed(0,true));assertEquals(0xff008acb,first.primary);}
 @Test public void primaryControlsNeverResizeOnRapidTaps()throws Exception{ControlsRow row=new ControlsRow(activity);root.addView(row);size(row,320,140);View play=row.play;int left=play.getLeft(),width=play.getWidth();for(int i=0;i<1000;i++){row.play.setPressed(i%2==0);row.setPlaying(i%2==0,true);assertEquals(left,play.getLeft());assertEquals(width,play.getWidth());}assertTrue(row.prev.getRight()<play.getLeft());assertTrue(play.getRight()<row.next.getLeft());assertTrue(row.shuffle.getRight()<=row.prev.getLeft());assertTrue(row.next.getRight()<=row.repeat.getLeft());assertEquals(row.shuffle.getTop(),row.repeat.getTop());}
 @Test public void seekCommitCancelAndAccessibilityAreNative(){WavySeekBar bar=new WavySeekBar(activity);root.addView(bar);size(bar,300,48);final int[] commits={0};final float[] result={-1};bar.setDelegate(new WavySeekBar.Delegate(){public void onSeekStart(){}public void onSeekMove(float p){}public void onSeekEnd(float p,boolean commit){if(commit)commits[0]++;result[0]=p;}});bar.setProgress(.2f);bar.onTouchEvent(MotionEvent.obtain(0,0,0,150,24,0));bar.onTouchEvent(MotionEvent.obtain(0,1,3,150,24,0));assertEquals(0,commits[0]);assertEquals(.2f,result[0],.001);Bundle b=new Bundle();b.putFloat(android.view.accessibility.AccessibilityNodeInfo.ACTION_ARGUMENT_PROGRESS_VALUE,75);assertTrue(bar.performAccessibilityAction(android.R.id.accessibilityActionSetProgress,b));assertEquals(.75f,result[0],.001);assertEquals(1,commits[0]);bar.setEnabled(false);assertFalse(bar.performAccessibilityAction(android.R.id.accessibilityActionSetProgress,b));}
 @Test public void oneHostCompressesWithoutStoppingAndCleansUp()throws Exception{size(root,360,760);BaseFragment fragment=new BaseFragment(root);final int[] changes={0};SignatureMusicHost[] host={null};host[0]=new SignatureMusicHost(fragment,null,()->{changes[0]++;host[0].update(true);});host[0].attach();host[0].update(true);assertEquals(1,root.getChildCount());View bubble=root.getChildAt(0);assertEquals(View.GONE,bubble.getVisibility());SignatureMusicPresentation.setCompact(true);assertEquals(View.VISIBLE,bubble.getVisibility());assertEquals(0,MediaController.getInstance().stops);size(bubble,56,56);bubble.onTouchEvent(MotionEvent.obtain(0,0,0,10,10,0));bubble.onTouchEvent(MotionEvent.obtain(0,20,2,999,999,0));bubble.onTouchEvent(MotionEvent.obtain(0,40,1,999,999,0));assertTrue(bubble.getX()<=292);assertTrue(bubble.getY()<=592);assertTrue(SignatureMusicPresentation.isCompact());bubble.performClick();assertFalse(SignatureMusicPresentation.isCompact());assertEquals(0,MediaController.getInstance().stops);MediaController.getInstance().message.music=false;SignatureMusicPresentation.setCompact(true);assertEquals(View.GONE,bubble.getVisibility());host[0].detach();assertEquals(0,root.getChildCount());int count=changes[0];host[0].update(true);host[0].onPresentationChanged();assertEquals(0,root.getChildCount());assertEquals(count,changes[0]);SignatureMusicPresentation.setCompact(false);assertEquals(count,changes[0]);}
 @Test public void navigationCanDetachDuringBubbleDrag(){size(root,360,760);SignatureMusicHost host=new SignatureMusicHost(new BaseFragment(root),null,()->{});host.attach();SignatureMusicPresentation.setCompact(true);host.update(true);View bubble=root.getChildAt(0);size(bubble,56,56);bubble.onTouchEvent(MotionEvent.obtain(0,0,0,10,10,0));bubble.onTouchEvent(MotionEvent.obtain(0,20,2,100,100,0));host.detach();assertNull(bubble.getParent());bubble.onTouchEvent(MotionEvent.obtain(0,40,3,100,100,0));assertEquals(0,MediaController.getInstance().stops);}
 @Test public void miniUsesOriginalPlaybackActionsAndBalancedObservers()throws Exception{BaseFragment fragment=new BaseFragment(root);PlayerMiniView mini=new PlayerMiniView(activity,fragment,null);root.addView(mini);mini.update(false);size(root,360,760);size(mini,360,80);View play=(View)field(mini,"playButton"),next=(View)field(mini,"nextButton"),close=(View)field(mini,"closeButton");play.performClick();assertEquals(1,MediaController.getInstance().pauses);play.performClick();assertEquals(1,MediaController.getInstance().plays);next.performClick();assertEquals(1,MediaController.getInstance().nexts);close.performClick();assertTrue(SignatureMusicPresentation.isCompact());assertEquals(0,MediaController.getInstance().stops);root.removeView(mini);assertEquals(1,root.getChildCount());assertEquals(View.GONE,root.getChildAt(0).getVisibility());for(int a=0;a<UserConfig.MAX_ACCOUNT_COUNT;a++)assertTrue(NotificationCenter.getInstance(a).registrations.isEmpty());assertTrue(NotificationCenter.getGlobalInstance().registrations.isEmpty());}
 @Test public void shortScreensAndLargeFontsScrollWithoutControlOverlap(){for(float font:new float[]{1,1.5f,2,3})for(int width:new int[]{240,320,600}){Configuration config=new Configuration(activity.getResources().getConfiguration());config.fontScale=font;Context c=activity.createConfigurationContext(config);LayoutFixture f=new LayoutFixture(c,false);size(f,width,480);View[] v=f.ordered;assertEquals(0,v[1].getLeft());assertEquals(width,v[1].getRight());assertTrue(v[0].getBottom()<v[1].getBottom());// Artwork deliberately continues behind the title; interactive rows must remain separate.
 assertTrue(v[2].getTop()<v[1].getBottom());assertEquals(v[1].getBottom()-dp(64),v[2].getTop());
 for(int i=3;i<v.length;i++)assertTrue("overlap "+width+" font "+font+" index "+i,v[i].getTop()>=v[i-1].getBottom());assertTrue(f.content.getHeight()>=480);for(int i=0;i<v.length;i++){assertTrue(v[i].getLeft()>=0);assertTrue(v[i].getRight()<=width);}assertTrue(v[1].getHeight()>=220);}}
 @Test public void lateMetadataOnSameMessageRefreshesBothMinis()throws Exception{PlayerBarView top=new PlayerBarView(activity,null,()->{},()->{});PlayerMiniView bottom=new PlayerMiniView(activity,new BaseFragment(root),null);top.update();bottom.update(false);MessageObject same=MediaController.getInstance().message;same.title="Updated title";same.artist="Updated artist";top.update();bottom.update(false);assertEquals("Updated title",((TextView)field(top,"titleView")).getText().toString());assertEquals("Updated artist",((TextView)field(top,"artistView")).getText().toString());assertEquals("Updated title",((TextView)field(bottom,"titleView")).getText().toString());assertEquals("Updated artist",((TextView)field(bottom,"artistView")).getText().toString());}
 @Test public void narrowMinisKeepAccessibleControlsAndText()throws Exception{for(int width:new int[]{240,320,600}){PlayerBarView top=new PlayerBarView(activity,null,()->{},()->{});top.update();size(top,width,64);View text=(View)field(top,"texts");View next=(View)field(top,"nextButton");assertTrue(text.getWidth()>40);assertEquals(width<320?View.GONE:View.VISIBLE,next.getVisibility());assertEquals(48,((View)field(top,"playButton")).getWidth());assertEquals(48,((View)field(top,"closeButton")).getWidth());PlayerMiniView bottom=new PlayerMiniView(activity,new BaseFragment(root),null);bottom.update(false);size(bottom,width,80);assertEquals(width<320?View.GONE:View.VISIBLE,((View)field(bottom,"nextButton")).getVisibility());}}
 @Test public void renderRealComponentLayoutAndMinisLightDark()throws Exception{Bitmap image=Bitmap.createBitmap(1080,1360,Bitmap.Config.ARGB_8888);Canvas canvas=new Canvas(image);for(int panel=0;panel<2;panel++){boolean dark=panel==1;Theme.dark=dark;LayoutFixture f=new LayoutFixture(activity,dark);root.addView(f);size(f,360,780);for(int step=0;step<20;step++){org.robolectric.shadows.ShadowSystemClock.advanceBy(java.time.Duration.ofMillis(33));f.draw(new Canvas(Bitmap.createBitmap(360,780,Bitmap.Config.ARGB_8888)));}canvas.save();canvas.translate(panel*540,0);canvas.scale(1.5f,1.5f);f.draw(canvas);canvas.restore();PlayerBarView bar=new PlayerBarView(activity,null,()->{},()->{});bar.update();size(bar,344,64);canvas.save();canvas.translate(panel*540+12,1210);canvas.scale(1.5f,1.5f);bar.draw(canvas);canvas.restore();root.removeView(f);}try(FileOutputStream out=new FileOutputStream(new File(System.getProperty("probe.root"),"android-music-isolated.png"))){assertTrue(image.compress(Bitmap.CompressFormat.PNG,100,out));}}
 @Test public void detachedRootKeepsStableChildArrayAndReusesDormantBubble(){
  SignatureMusicHost[] host={new SignatureMusicHost(new BaseFragment(root),null,()->{})};
  View trigger=new View(activity){@Override protected void onDetachedFromWindow(){host[0].detachFromWindow();super.onDetachedFromWindow();}};
  root.addView(trigger);host[0].attach();host[0].update(true);View bubble=root.getChildAt(1);size(root,360,760);
  for(int i=0;i<100;i++){
   activity.setContentView(new FrameLayout(activity));host[0].update(true);host[0].onPresentationChanged();
   assertEquals(2,root.getChildCount());assertSame(bubble,root.getChildAt(1));assertEquals(View.GONE,bubble.getVisibility());
   activity.setContentView(root);host[0]=new SignatureMusicHost(new BaseFragment(root),null,()->{});host[0].attach();host[0].update(true);
   assertEquals(2,root.getChildCount());assertSame(bubble,root.getChildAt(1));
  }
 }
 @Test public void realContextMeasureBoundsMusicAndRestoresTranslationSpace(){
  for(float font:new float[]{1,2,3}){
   Configuration config=new Configuration(activity.getResources().getConfiguration());config.fontScale=font;Context c=activity.createConfigurationContext(config);
   LinearLayout stack=new LinearLayout(c);stack.setOrientation(LinearLayout.VERTICAL);
   View header=new View(c);stack.addView(header,new LinearLayout.LayoutParams(-1,56));
   NativeContextMeasure music=new NativeContextMeasure(c);music.addView(new View(c),new FrameLayout.LayoutParams(-1,300));stack.addView(music,new LinearLayout.LayoutParams(-1,-2));
   View translation=new View(c);final int[] taps={0};translation.setOnClickListener(v->taps[0]++);stack.addView(translation,new LinearLayout.LayoutParams(-1,48));
   size(stack,320,640);assertEquals(music.getStyleHeight(),music.getMeasuredHeight());assertTrue(translation.getTop()>=music.getBottom());translation.performClick();assertEquals(1,taps[0]);
   music.setVisibility(View.GONE);size(stack,320,640);assertEquals(header.getBottom(),translation.getTop());
  }
 }
 @Test public void columnsStayStaticDuringPlaybackAndKeepTouchTargets()throws Exception{
  WavySeekBar bar=new WavySeekBar(activity);root.addView(bar);size(bar,320,48);bar.setColors(0xff2288cc,0xffbdc9d2);bar.setProgress(.45f);bar.setPlaying(true);
  Bitmap a=Bitmap.createBitmap(320,48,Bitmap.Config.ARGB_8888),b=Bitmap.createBitmap(320,48,Bitmap.Config.ARGB_8888);bar.draw(new Canvas(a));
  for(int n=0;n<100;n++){org.robolectric.shadows.ShadowSystemClock.advanceBy(java.time.Duration.ofMillis(40));b.eraseColor(0);bar.draw(new Canvas(b));assertTrue(a.sameAs(b));}
  assertEquals(0f,(Float)field(bar,"phase"),0f);assertEquals(0L,field(bar,"lastFrame"));
  for(int w:new int[]{192,240,264,272,300,320,600}){ControlsRow row=new ControlsRow(activity);size(row,w,200);View[] actions={row.shuffle,row.prev,row.play,row.next,row.repeat};for(View v:actions){assertTrue(v.getWidth()>=48);assertTrue(v.getHeight()>=48);assertTrue(v.getLeft()>=0);assertTrue(v.getRight()<=w);}if(w>=264){for(int n=1;n<5;n++)assertTrue(actions[n-1].getRight()<=actions[n].getLeft());}}
 }
 @Test public void heroFadeReusesShaderAndArtworkPaletteIsBounded()throws Exception{
  for(boolean dark:new boolean[]{false,true})for(int seed:new int[]{0xff000000,0xffffffff,0xffff0000,0xff0000ff}){
   PlayerColors c=PlayerColors.fromSignatureArtwork(seed,dark);for(int n=0;n<100;n++)assertSame(c,PlayerColors.fromSignatureArtwork(seed,dark));assertTrue(androidx.core.graphics.ColorUtils.calculateContrast(c.onSurface,c.surface)>=4.5);assertTrue(androidx.core.graphics.ColorUtils.calculateContrast(c.onPrimary,c.primary)>=4.5);
   CoverImage cover=new CoverImage(activity,40);cover.setSignatureSurface(c.surface);Bitmap original=Bitmap.createBitmap(120,120,Bitmap.Config.ARGB_8888);original.eraseColor(0xff22aa88);cover.setImageBitmap(original);size(cover,240,300);
   Object fade=field(cover,"signatureFade");android.graphics.Paint paint=(android.graphics.Paint)field(fade,"paint");Shader shader=paint.getShader();assertNotNull(shader);
   Bitmap pixels=Bitmap.createBitmap(240,300,Bitmap.Config.ARGB_8888);for(int n=0;n<100;n++)cover.draw(new Canvas(pixels));assertSame(shader,paint.getShader());assertEquals(original.getPixel(50,50),pixels.getPixel(120,120));
   int bottom=pixels.getPixel(120,299);assertTrue(Math.abs(Color.red(bottom)-Color.red(c.surface))<=2);assertTrue(Math.abs(Color.green(bottom)-Color.green(c.surface))<=2);assertFalse(original.isRecycled());
  }
  PlayerColors initial=PlayerColors.fromSignatureArtwork(0xff123456,false);for(int n=0;n<9;n++)PlayerColors.fromSignatureArtwork(0xff884400+n,false);assertNotSame(initial,PlayerColors.fromSignatureArtwork(0xff123456,false));
 }

}
