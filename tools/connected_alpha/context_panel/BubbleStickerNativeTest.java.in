import android.app.Activity;import android.graphics.*;import android.view.*;import android.widget.*;import java.io.*;import java.nio.file.*;import java.util.*;import java.util.concurrent.atomic.*;
import org.junit.*;import org.junit.runner.RunWith;import org.robolectric.*;import org.robolectric.annotation.*;import static org.junit.Assert.*;
import app.flexygram.bubbles.interaction.*;import org.telegram.messenger.*;import org.telegram.tgnet.TLRPC;import org.telegram.ui.Cells.ChatMessageCell;
/** Real production capture/codec/workflow/views; native cell, account and server remain doubles. */
@RunWith(RobolectricTestRunner.class) @Config(manifest=Config.NONE,sdk=35,instrumentedPackages={"app.flexygram.bubbles.interaction"}) @GraphicsMode(GraphicsMode.Mode.NATIVE) @LooperMode(LooperMode.Mode.PAUSED)
public class BubbleStickerNativeTest {
 Activity activity;FrameLayout root;ArrayList<BubbleStickerWorkflow> owners=new ArrayList<>();
 @Before public void open(){activity=Robolectric.buildActivity(Activity.class).setup().visible().get();ApplicationLoader.applicationContext=activity.getApplicationContext();root=new FrameLayout(activity);activity.setContentView(root);root.measure(View.MeasureSpec.makeMeasureSpec(400,1073741824),View.MeasureSpec.makeMeasureSpec(800,1073741824));root.layout(0,0,400,800);}
 @After public void close(){for(var o:owners)o.cancel();activity.finish();}
 void await(java.util.function.BooleanSupplier done)throws Exception{long until=System.nanoTime()+4_000_000_000L;while(!done.getAsBoolean()&&System.nanoTime()<until){Shadows.shadowOf(android.os.Looper.getMainLooper()).idle();Thread.sleep(5);}Shadows.shadowOf(android.os.Looper.getMainLooper()).idle();assertTrue("bounded worker completion",done.getAsBoolean());}
 ChatMessageCell cell(){var c=new ChatMessageCell(activity);c.message=new MessageObject();root.addView(c,new FrameLayout.LayoutParams(240,120));c.measure(View.MeasureSpec.makeMeasureSpec(240,1073741824),View.MeasureSpec.makeMeasureSpec(120,1073741824));c.layout(0,0,240,120);org.robolectric.util.ReflectionHelpers.setField(org.robolectric.util.ReflectionHelpers.getField(c,"mAttachInfo"),"mWindowVisibility",View.VISIBLE);return c;}
 static class Listener implements BubbleStickerWorkflow.Listener{File file;Bitmap preview;TLRPC.Document doc;int ready,errors,sent;public void onReady(File f,Bitmap b,TLRPC.Document d){file=f;preview=b;doc=d;ready++;}public void onError(String s){errors++;}public void onSent(){sent++;}}
 @Test public void exactNativeCellRoiEncodesARealTransparentWebp()throws Exception{var c=cell();assertTrue(NativeBubbleStickerPainter.eligible(c,c.message));Bitmap pixels=BubbleStickerEncoder.captureOnUiThread(new NativeBubbleStickerPainter(c,c.message));assertEquals(512,pixels.getWidth());assertEquals(205,pixels.getHeight());assertEquals(0,Color.alpha(pixels.getPixel(0,0)));assertTrue(Color.alpha(pixels.getPixel(380,150))>0);var encoded=BubbleStickerEncoder.encodeAndRecycle(pixels);assertTrue(pixels.isRecycled());assertTrue(BubbleStickerSpec.isWebp(encoded.bytes));Bitmap decoded=BitmapFactory.decodeByteArray(encoded.bytes,0,encoded.bytes.length);assertEquals(encoded.width,decoded.getWidth());assertEquals(encoded.height,decoded.getHeight());assertEquals(0,Color.alpha(decoded.getPixel(0,0)));}
 @Test public void nativeParentWallpaperPassAndPaddingAreNotDropped(){var c=cell();c.parentBackground=true;c.setPadding(0,12,0,0);Bitmap pixels=BubbleStickerEncoder.captureOnUiThread(new NativeBubbleStickerPainter(c,c.message));assertEquals(512,pixels.getWidth());assertEquals(205,pixels.getHeight());assertTrue("parent-rendered background survives capture",Color.alpha(pixels.getPixel(380,150))>0);assertEquals(1,c.parentPasses);assertEquals(1,c.outboundsPasses);pixels.recycle();}
 @Test public void hiddenProtectedSpoilerReboundAndPartlyVisibleCellsAreRejected(){var c=cell();var m=c.message;assertTrue(NativeBubbleStickerPainter.eligible(c,m));m.messageOwner.noforwards=true;assertFalse(NativeBubbleStickerPainter.eligible(c,m));m.messageOwner.noforwards=false;m.ephemeral=true;assertFalse(NativeBubbleStickerPainter.eligible(c,m));m.ephemeral=false;m.messageOwner.entities.add(new TLRPC.TL_messageEntitySpoiler());assertFalse(NativeBubbleStickerPainter.eligible(c,m));m.messageOwner.entities.clear();c.bottom=200;assertFalse(NativeBubbleStickerPainter.eligible(c,m));c.bottom=90;c.setAlpha(.5f);assertFalse(NativeBubbleStickerPainter.eligible(c,m));c.setAlpha(1);c.getTransitionParams().animateChangeProgress=.4f;assertFalse(NativeBubbleStickerPainter.eligible(c,m));c.getTransitionParams().animateChangeProgress=1;c.message=new MessageObject();assertFalse(NativeBubbleStickerPainter.eligible(c,m));}
 @Test public void realWorkflowNeverReportsLocalMetadataAsSentAndCannotDoubleSubmit()throws Exception{var c=cell();var w=new BubbleStickerWorkflow(activity.getCacheDir());owners.add(w);var l=new Listener();w.prepare(new NativeBubbleStickerPainter(c,c.message),l);await(()->l.ready==1||l.errors>0);assertEquals(0,l.errors);assertEquals(512,Math.max(l.preview.getWidth(),l.preview.getHeight()));assertTrue(l.file.isFile());AtomicInteger sends=new AtomicInteger();BubbleStickerWorkflow.NativeStickerSender sender=(f,d,result)->{sends.incrementAndGet();result.complete(d,null);};w.confirmAndSend(sender,l);await(()->l.errors==1);assertEquals("id0 metadata is not server success",0,l.sent);w.confirmAndSend(sender,l);assertEquals(1,sends.get());w.cancel();}
 @Test public void cancelInvalidatesQueuedPublicationAndDeletesUnsubmittedFile()throws Exception{var c=cell();var w=new BubbleStickerWorkflow(activity.getCacheDir());owners.add(w);var l=new Listener();w.prepare(new NativeBubbleStickerPainter(c,c.message),l);w.cancel();long until=System.nanoTime()+250_000_000L;while(System.nanoTime()<until){Shadows.shadowOf(android.os.Looper.getMainLooper()).idle();Thread.sleep(5);}assertEquals(0,l.ready);assertNull(w.exportFile());w.prepare(new NativeBubbleStickerPainter(c,c.message),l);await(()->l.ready==1||l.errors>0);File f=l.file;w.cancel();assertFalse(f.exists());}
 @Test public void permissionRevocationBeforePreviewCannotLeaveUsableButtons()throws Exception{var c=cell();var panel=new BubbleActionPanelView(activity,null);panel.setAllowedActions(EnumSet.of(BubbleActionPanelView.Action.BUILD_STICKER));AtomicBoolean allowed=new AtomicBoolean(true);var session=new BubbleStickerSession(panel,activity.getCacheDir(),allowed::get,()->new NativeBubbleStickerPainter(c,c.message),(f,d,result)->fail("must not send"),f->fail("must not export"));session.handle(BubbleActionPanelView.Action.BUILD_STICKER);allowed.set(false);long until=System.nanoTime()+250_000_000L;while(System.nanoTime()<until){Shadows.shadowOf(android.os.Looper.getMainLooper()).idle();Thread.sleep(5);}session.handle(BubbleActionPanelView.Action.SEND_STICKER);session.close();}
 @Test public void repeatedStickerTabAndThreeColumnActionRebuildsDoNotReparentCrash(){var panel=new BubbleActionPanelView(activity,null);panel.setAllowedActions(EnumSet.allOf(BubbleActionPanelView.Action.class));panel.setStickerEnabled(true);AtomicInteger builds=new AtomicInteger();panel.setListener(a->{if(a==BubbleActionPanelView.Action.BUILD_STICKER)builds.incrementAndGet();});for(int i=0;i<12;i++){named(panel,"FlexyContextSticker").performClick();named(panel,"FlexyContextActions").performClick();}assertEquals(12,builds.get());panel.setLayoutDirection(View.LAYOUT_DIRECTION_RTL);panel.measure(View.MeasureSpec.makeMeasureSpec(320,1073741824),View.MeasureSpec.makeMeasureSpec(800,View.MeasureSpec.AT_MOST));panel.layout(0,0,320,panel.getMeasuredHeight());assertTrue(panel.getMeasuredHeight()<600);named(panel,"FlexyContextSticker").performClick();panel.measure(View.MeasureSpec.makeMeasureSpec(320,1073741824),View.MeasureSpec.makeMeasureSpec(800,View.MeasureSpec.AT_MOST));panel.layout(0,0,320,panel.getMeasuredHeight());View send=named(panel,"FlexyContextSendHere");ViewGroup row=(ViewGroup)send.getParent();assertTrue("send tap target must fit its row",send.getBottom()<=row.getHeight());assertTrue(send.getHeight()>=48*activity.getResources().getDisplayMetrics().density);}
 View named(View v,String name){if(v instanceof TextView && name.contentEquals(((TextView)v).getText()))return v;if(v instanceof ViewGroup)for(int i=0;i<((ViewGroup)v).getChildCount();i++){View x=named(((ViewGroup)v).getChildAt(i),name);if(x!=null)return x;}return null;}
 @Test public void exportUsesSafAndCancellationReleasesBoundedPayload()throws Exception{var c=cell();var data=BubbleStickerEncoder.encodeAndRecycle(BubbleStickerEncoder.captureOnUiThread(new NativeBubbleStickerPainter(c,c.message)));File f=BubbleStickerEncoder.writePrivateCache(activity.getCacheDir(),data);var host=new org.telegram.ui.ActionBar.BaseFragment();host.activity=activity;var export=new BubbleStickerExport(host);export.save(f);await(()->host.lastIntent!=null);assertEquals(android.content.Intent.ACTION_CREATE_DOCUMENT,host.lastIntent.getAction());assertEquals("image/webp",host.lastIntent.getType());assertEquals(BubbleStickerExport.REQUEST,host.request);export.result(Activity.RESULT_CANCELED,null);export.cancel();f.delete();}
}
