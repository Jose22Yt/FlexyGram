import java.io.*;import java.util.*;import java.util.concurrent.atomic.*;import org.junit.*;import org.junit.runner.RunWith;import org.robolectric.*;import org.robolectric.annotation.*;import static org.junit.Assert.*;
import app.flexygram.bubbles.interaction.*;import org.telegram.messenger.*;import org.telegram.tgnet.TLRPC;
/** Production sender/confirmation state machine, with explicit notification and network doubles. */
@RunWith(RobolectricTestRunner.class) @Config(manifest=Config.NONE,sdk=35,instrumentedPackages={"app.flexygram.bubbles.interaction"}) @LooperMode(LooperMode.Mode.PAUSED)
public class BubbleStickerTransportTest {
 File file;SendMessagesHelper.SendMessageParams params;AtomicInteger okay,errors;
 @Before public void start()throws Exception{file=File.createTempFile("sticker-transport-",".webp");try(var out=new FileOutputStream(file)){out.write(new byte[32]);}params=new SendMessagesHelper.SendMessageParams();params.document=NativeStickerMetadata.create(512,256,32,"test");params.path=file.getAbsolutePath();params.peer=7;okay=new AtomicInteger();errors=new AtomicInteger();SendMessagesHelper.sends=0;SendMessagesHelper.onSend=p->{var local=new MessageObject();local.dialog=p.peer;local.messageOwner.id=-4;local.messageOwner.attachPath=p.path;NotificationCenter.getInstance(0).postNotificationName(NotificationCenter.didReceiveNewMessages,p.peer,new ArrayList<>(List.of(local)),false,0);};}
 @After public void end(){Shadows.shadowOf(android.os.Looper.getMainLooper()).idleFor(java.time.Duration.ofSeconds(181));assertEquals(0,NotificationCenter.getInstance(0).count());SendMessagesHelper.onSend=null;file.delete();}
 void send(){NativeBubbleStickerSender.send(0,params,file,(doc,error)->{if(error==null)okay.incrementAndGet();else errors.incrementAndGet();});}
 TLRPC.Message server(boolean sticker){var m=new TLRPC.Message();m.id=123;m.media=new TLRPC.MessageMedia();m.media.document=sticker?NativeStickerMetadata.create(512,256,32,"test"):new TLRPC.TL_document();m.media.document.id=45;return m;}
 @Test public void exactServerStickerAndLocalIdConfirmOnlyOnce(){send();assertEquals(1,SendMessagesHelper.sends);assertEquals(0,okay.get());var m=server(true);NotificationCenter.getInstance(0).postNotificationName(NotificationCenter.messageReceivedByServer,-4,123,m,7L);NotificationCenter.getInstance(0).postNotificationName(NotificationCenter.messageReceivedByServer,-4,123,m,7L);assertEquals(1,okay.get());assertEquals(0,errors.get());assertEquals(0,NotificationCenter.getInstance(0).count());assertFalse(file.exists());}
 @Test public void wrongAccountPeerAndOldIdCannotConfirm(){send();var m=server(true);NotificationCenter.getInstance(1).postNotificationName(NotificationCenter.messageReceivedByServer,-4,123,m,7L);NotificationCenter.getInstance(0).postNotificationName(NotificationCenter.messageReceivedByServer,-4,123,m,8L);NotificationCenter.getInstance(0).postNotificationName(NotificationCenter.messageReceivedByServer,-5,123,m,7L);assertEquals(0,okay.get());assertEquals(3,NotificationCenter.getInstance(0).count());NotificationCenter.getInstance(0).postNotificationName(NotificationCenter.messageSendError,-4);assertEquals(1,errors.get());assertTrue("native retry keeps queued bytes",file.exists());}
 @Test public void genericServerDocumentIsNeverCalledStickerSuccess(){send();NotificationCenter.getInstance(0).postNotificationName(NotificationCenter.messageReceivedByServer,-4,123,server(false),7L);assertEquals(0,okay.get());assertEquals(1,errors.get());}
 @Test public void localIdZeroMetadataCannotConfirm(){send();var m=server(true);m.id=0;m.media.document.id=0;NotificationCenter.getInstance(0).postNotificationName(NotificationCenter.messageReceivedByServer,-4,0,m,7L);assertEquals(0,okay.get());assertEquals(1,errors.get());}
 @Test public void timeoutRemovesAllObserversButNeverPretendsSuccess(){send();Shadows.shadowOf(android.os.Looper.getMainLooper()).idleFor(java.time.Duration.ofSeconds(181));assertEquals(0,okay.get());assertEquals(1,errors.get());assertEquals(0,NotificationCenter.getInstance(0).count());assertTrue(file.exists());}
 @Test public void fileSizeAndPathMismatchFailBeforeNetworkOrObservers(){params.path="/different";try{send();fail("path");}catch(IllegalArgumentException expected){}assertEquals(0,SendMessagesHelper.sends);assertEquals(0,NotificationCenter.getInstance(0).count());params.path=file.getAbsolutePath();params.document.size=500;try{send();fail("size");}catch(IllegalArgumentException expected){}assertEquals(0,SendMessagesHelper.sends);}
}
