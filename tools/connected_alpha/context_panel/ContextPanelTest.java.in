import android.app.Activity;
import android.view.*;
import android.widget.*;
import java.util.*;
import org.junit.*;
import org.junit.runner.RunWith;
import org.robolectric.*;
import org.robolectric.annotation.*;
import static org.junit.Assert.*;
import app.flexygram.bubbles.interaction.*;
import app.flexygram.bubbles.interaction.BubbleActionPanelView.Action;
@RunWith(RobolectricTestRunner.class) @Config(manifest=Config.NONE,sdk=35)
public class ContextPanelTest {
 Activity activity;FrameLayout root;
 @Before public void start(){activity=Robolectric.buildActivity(Activity.class).setup().get();root=new FrameLayout(activity);activity.setContentView(root);}
 @After public void end(){activity.finish();}
 View named(View v,String label){if(v instanceof TextView&&label.contentEquals(((TextView)v).getText()))return v;if(label.contentEquals(v.getContentDescription()==null?"":v.getContentDescription()))return v;if(v instanceof ViewGroup){for(int i=0;i<((ViewGroup)v).getChildCount();i++){View found=named(((ViewGroup)v).getChildAt(i),label);if(found!=null)return found;}}return null;}
 @Test public void onlyNativeAdmittedActionsAreShownAndNoStickerIsAdvertised(){
  var panel=new BubbleActionPanelView(activity,null);panel.setAllowedActions(EnumSet.of(Action.REPLY,Action.COPY,Action.SELECT));
  assertNotNull(named(panel,"Reply"));assertNotNull(named(panel,"Copy"));assertNull(named(panel,"Edit"));assertNull(named(panel,"Delete"));assertNull(named(panel,"FlexyContextSticker"));
 }
 @Test public void clicksDelegateOnceAndDetachReleasesListener(){
  var panel=new BubbleActionPanelView(activity,null);panel.setAllowedActions(EnumSet.of(Action.REPLY,Action.DELETE));ArrayList<Action> received=new ArrayList<>();panel.setListener(received::add);root.addView(panel);
  View reply=named(panel,"Reply");assertTrue(reply.performClick());assertEquals(Collections.singletonList(Action.REPLY),received);
  assertTrue(named(panel,"FlexyContextMore").performClick());assertEquals(Action.MORE,received.get(1));
  root.removeView(panel);reply.performClick();assertEquals(2,received.size());
 }
 @Test public void selectionRemainsInNativeOverflowInsteadOfClutteringQuickActions(){
  var panel=new BubbleActionPanelView(activity,null);panel.setAllowedActions(EnumSet.of(Action.SELECT));ArrayList<Action> received=new ArrayList<>();panel.setListener(received::add);
  assertNull(named(panel,"FlexyContextSelect"));
  assertNotNull(named(panel,"FlexyContextMore"));
  named(panel,"FlexyContextMore").performClick();
  assertEquals(Collections.singletonList(Action.MORE),received);
 }
 @Test public void dampedSpringIsSoftBoundedAndRestoresExactIdle() {
  assertEquals(0f,DampedSpringCurve.progress(0f),0.000001f);
  assertTrue(DampedSpringCurve.progress(.05f)>0f);
  assertTrue(DampedSpringCurve.progress(.05f)<1f);
  float overshoot=DampedSpringCurve.progress(.15f);
  assertTrue("Elastic peak should exist",overshoot>1f);
  assertTrue("Peak must remain subtle",overshoot<1.14f);
  assertTrue("Residual should decay",Math.abs(DampedSpringCurve.progress(.28f)-1f)<.025f);
  assertEquals(1f,DampedSpringCurve.progress(.33f),0.000001f);
  assertEquals(1f,DampedSpringCurve.progress(1f),0.000001f);
 }
 @Test public void panelReturnsToIdleAfterDetachedAnimation() {
  BubbleInteractionSettings.setSpringBounce(activity,true);
  var panel=new BubbleActionPanelView(activity,null);
  root.addView(panel);
  root.removeView(panel);
  assertEquals(1f,panel.getScaleX(),0.000001f);
  assertEquals(1f,panel.getScaleY(),0.000001f);
  assertEquals(0f,panel.getTranslationY(),0.000001f);
 }
 @Test public void selectedOverlayCancelsAndReleasesItsInvalidator() {
  final int[] draws={0}; SelectedBubbleMotion motion=new SelectedBubbleMotion();
  motion.enter(()->draws[0]++);
  assertTrue(motion.scale()>=.962f && motion.scale()<=1.006f);
  motion.reset(); assertFalse(motion.isRunning()); assertEquals(1f,motion.scale(),0f);
  int stopped=draws[0]; org.robolectric.Shadows.shadowOf(android.os.Looper.getMainLooper()).idleFor(java.time.Duration.ofSeconds(1));
  assertEquals(stopped,draws[0]);
  motion.enter(()->draws[0]++);motion.close();motion.reset();
  assertEquals(1f,motion.scale(),0f);assertFalse(motion.isRunning());
 }
 @Test public void selectedOverlayInterruptionKeepsOnlyTheLatestMenuCallback() {
  int[] first={0},second={0}; SelectedBubbleMotion motion=new SelectedBubbleMotion();
  motion.enter(()->first[0]++); motion.enter(()->second[0]++); int before=first[0];
  org.robolectric.Shadows.shadowOf(android.os.Looper.getMainLooper()).idleFor(java.time.Duration.ofSeconds(1));
  assertEquals(before,first[0]);assertTrue(second[0]>0);assertEquals(1f,motion.scale(),0f);assertFalse(motion.isRunning());
 }
 @Test public void verticalRowsHaveRealActionsAndAccessibleTargets() {
  var panel=new BubbleActionPanelView(activity,null);panel.setAllowedActions(EnumSet.allOf(Action.class));
  panel.measure(View.MeasureSpec.makeMeasureSpec(260,View.MeasureSpec.EXACTLY),View.MeasureSpec.makeMeasureSpec(1000,View.MeasureSpec.AT_MOST));
  panel.layout(0,0,260,panel.getMeasuredHeight());
  assertEquals(LinearLayout.VERTICAL,panel.getOrientation());
  ArrayList<Action> received=new ArrayList<>();panel.setListener(received::add);
  assertEquals(7,panel.getChildCount());
  int bottom=0;
  for(int i=0;i<panel.getChildCount();i++){
   View row=panel.getChildAt(i);assertTrue(row.getTop()>=bottom);bottom=row.getBottom();
   assertTrue(row.getHeight()>=48*activity.getResources().getDisplayMetrics().density);
   assertTrue(row.performClick());
  }
  assertEquals(Arrays.asList(Action.REPLY,Action.COPY,Action.FORWARD,Action.EDIT,Action.PIN,Action.DELETE,Action.MORE),received);
  assertEquals(1f,panel.getScaleX(),0f);
 }
 @Test public void localBouncePreferencePersists() {
  var context=activity.getApplicationContext();
  BubbleInteractionSettings.setSpringBounce(context,false);
  org.robolectric.util.ReflectionHelpers.setStaticField(BubbleInteractionSettings.class,"bounce",null);
  assertFalse(BubbleInteractionSettings.springBounce(context));
  BubbleInteractionSettings.setSpringBounce(context,true);
 }
 @Test public void optInPersistsWithoutMotionPreferencesOrNoOpMenuState(){
  var context=activity.getApplicationContext();BubbleInteractionSettings.setSignaturePanel(context,true);
  org.robolectric.util.ReflectionHelpers.setStaticField(BubbleInteractionSettings.class,"panel",null);
  assertTrue(BubbleInteractionSettings.signaturePanel(context));BubbleInteractionSettings.setSignaturePanel(context,false);
  org.robolectric.util.ReflectionHelpers.setStaticField(BubbleInteractionSettings.class,"panel",null);
  assertFalse(BubbleInteractionSettings.signaturePanel(context));
 }
 @Test public void actualNativePermissionAdapterPreservesAllCombinations(){
  for(int bits=0;bits<64;bits++){var host=new PanelHostProbe();var s=host.lastMessageMenuStatus;s.allowReply=(bits&1)!=0;s.allowCopy=(bits&2)!=0;s.allowForward=(bits&4)!=0;s.allowEdit=(bits&8)!=0;s.allowDelete=(bits&16)!=0;
   var options=new ArrayList<Integer>();if((bits&32)!=0)options.add(13);var a=host.signatureContextActions(options);
   assertEquals(s.allowReply,a.contains(Action.REPLY));assertEquals(s.allowCopy,a.contains(Action.COPY));assertEquals(s.allowForward,a.contains(Action.FORWARD));assertEquals(s.allowEdit,a.contains(Action.EDIT));assertEquals(s.allowDelete,a.contains(Action.DELETE));assertEquals((bits&32)!=0,a.contains(Action.PIN));
  }
 }

 @Test public void singleContactCompressesRealOwnerImmediatelyWithoutMenu(){
  View cell=new View(activity);root.addView(cell);BubbleTapMotion motion=new BubbleTapMotion(cell);
  motion.press(.04f,.45f,270);assertEquals(.96f,motion.scale(),.00001f);assertTrue(motion.pressed());
  assertEquals(1f,cell.getScaleX(),0); // Canvas-owned: native cell properties stay untouched.
  motion.release();org.robolectric.Shadows.shadowOf(android.os.Looper.getMainLooper()).idleFor(java.time.Duration.ofMillis(100));
  assertTrue(motion.scale()>.96f);
  org.robolectric.Shadows.shadowOf(android.os.Looper.getMainLooper()).idleFor(java.time.Duration.ofSeconds(1));assertEquals(1f,motion.scale(),0);
 }
 @Test public void tapSpringHasBoundedOvershootAndIndependentRecovery(){
  float peak=1;for(int i=0;i<=100;i++)peak=Math.max(peak,BubbleTapMotion.recovery(i/100f,1));
  assertTrue(peak>1);assertTrue(peak<1.25f);assertEquals(1f,BubbleTapMotion.recovery(1,1),0);
  assertNotEquals(BubbleTapMotion.recovery(.3f,0),BubbleTapMotion.recovery(.3f,1),.001f);
 }
 @Test public void cancelRecycleAndRapidTapsDoNotLeaveScaleOrCallbacks(){
  View cell=new View(activity);root.addView(cell);BubbleTapMotion motion=new BubbleTapMotion(cell);
  for(int i=0;i<50;i++){motion.press(.06f,.8f,140);motion.release();motion.reset();}
  org.robolectric.Shadows.shadowOf(android.os.Looper.getMainLooper()).idleFor(java.time.Duration.ofSeconds(1));assertEquals(1f,motion.scale(),0);assertFalse(motion.pressed());
 }
 @Test public void singleTapSettingsPersistSeparatelyFromContextBounce(){
  BubbleInteractionSettings.resetTap(activity);assertTrue(BubbleInteractionSettings.tapAnimation(activity));assertTrue(BubbleInteractionSettings.tapPanel(activity));
  BubbleInteractionSettings.tapPanel(activity,true);BubbleInteractionSettings.tapAnimation(activity,false);BubbleInteractionSettings.parameter(activity,0,1000);
  org.robolectric.util.ReflectionHelpers.setStaticField(BubbleInteractionSettings.class,"tap",null);
  org.robolectric.util.ReflectionHelpers.setStaticField(BubbleInteractionSettings.class,"tapPanel",null);
  org.robolectric.util.ReflectionHelpers.setStaticField(BubbleInteractionSettings.class,"compression",-1);
  assertTrue(BubbleInteractionSettings.tapPanel(activity));assertFalse(BubbleInteractionSettings.tapAnimation(activity));assertEquals(100,BubbleInteractionSettings.compression(activity));
  BubbleInteractionSettings.resetTap(activity);
 }
}
