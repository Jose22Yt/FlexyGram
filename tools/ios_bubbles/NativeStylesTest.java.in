import android.graphics.*;import org.junit.*;import org.junit.runner.RunWith;import org.robolectric.*;import org.robolectric.annotation.*;import app.flexygram.bubbles.*;import org.telegram.messenger.*;import org.telegram.ui.ActionBar.*;import static org.junit.Assert.*;
@RunWith(RobolectricTestRunner.class) @Config(manifest=Config.NONE,sdk=35) @GraphicsMode(GraphicsMode.Mode.NATIVE)
public class NativeStylesTest{
@Before public void setup(){ApplicationLoader.applicationContext=RuntimeEnvironment.getApplication();ApplicationLoader.applicationContext.getSharedPreferences(BubbleConfig.FILE,0).edit().clear().commit();BubbleConfig.load();AndroidUtilities.density=1;}
@Test public void stylesRemainDistinctAndSwitchBackCleanly(){Bitmap[]images=new Bitmap[3];MessageDrawable bubble=new MessageDrawable(0,true,false);MessageDrawable.PathDrawParams cache=new MessageDrawable.PathDrawParams();bubble.setBounds(4,4,164,84);bubble.setTop(0,180,100,false,false);for(int shape=0;shape<3;shape++){BubbleConfig.setShape(shape);images[shape]=Bitmap.createBitmap(180,100,Bitmap.Config.ARGB_8888);bubble.drawCached(new Canvas(images[shape]),cache);}assertFalse(images[0].sameAs(images[1]));assertFalse(images[1].sameAs(images[2]));BubbleConfig.setShape(0);Bitmap back=Bitmap.createBitmap(180,100,Bitmap.Config.ARGB_8888);bubble.drawCached(new Canvas(back),cache);assertTrue(back.sameAs(images[0]));}
@Test public void silhouetteIsMirroredExactly(){IosBubbleShape s=new IosBubbleShape();Path a=new Path(),b=new Path();s.build(a,new Rect(0,0,180,80),1,16,8,true,false,false,false,false,false);s.build(b,new Rect(0,0,180,80),1,16,8,false,false,false,false,false,false);Matrix mirror=new Matrix();mirror.setScale(-1,1);mirror.postTranslate(180,0);a.transform(mirror);Bitmap x=Bitmap.createBitmap(180,80,Bitmap.Config.ARGB_8888),y=Bitmap.createBitmap(180,80,Bitmap.Config.ARGB_8888);Paint p=new Paint(3);new Canvas(x).drawPath(a,p);new Canvas(y).drawPath(b,p);assertTrue(x.sameAs(y));}
@Test public void allShapesSupportIndependentCustomization(){for(int shape=0;shape<3;shape++)for(int material=0;material<3;material++){BubbleConfig.setShape(shape);BubbleConfig.setSurfaceEffect(material);BubbleConfig.setOutlineEnabled(true);BubbleConfig.setTransparency(25);BubbleConfig.setBackgroundBlur(true);BubbleConfig.load();assertEquals(shape,BubbleConfig.shape());assertTrue(BubbleConfig.outlineEnabled());assertTrue(BubbleConfig.backgroundBlur());}}
@Test public void compactPickerKeepsChoicesInsideBoundsAndAccessible() throws Exception{
 android.app.Activity activity=Robolectric.buildActivity(android.app.Activity.class).setup().get();
 app.flexygram.settings.signature.CompactStylePicker picker=new app.flexygram.settings.signature.CompactStylePicker(activity,key->key==Theme.key_windowBackgroundWhite?0xffeeeeee:key==Theme.key_windowBackgroundWhiteBlueText?0xff4488dd:0xff333333,new BubbleShapeMiniature(activity,1),3);
 for(int n=0;n<3;n++){final int shape=n;picker.addChoice(shape,new String[]{"Telegram","FlexyGram","Telegram for iPhone"}[n],new BubbleShapeMiniature(activity,shape),()->{BubbleConfig.setShape(shape);picker.select(shape);});}
 activity.setContentView(picker);picker.select(1);picker.measure(android.view.View.MeasureSpec.makeMeasureSpec(360,1073741824),0);picker.layout(0,0,360,picker.getMeasuredHeight());
 android.view.ViewGroup grid=(android.view.ViewGroup)picker.getChildAt(1);assertEquals(3,grid.getChildCount());
 for(int n=0;n<3;n++){android.view.View tile=grid.getChildAt(n);assertTrue(tile.getLeft()>=0&&tile.getRight()<=grid.getWidth());assertTrue(tile.getHeight()>=48);}
 grid.getChildAt(2).performClick();assertEquals(2,BubbleConfig.shape());assertTrue(grid.getChildAt(2).isSelected());assertFalse(grid.getChildAt(1).isSelected());
 Bitmap image=Bitmap.createBitmap(360,picker.getHeight(),Bitmap.Config.ARGB_8888);picker.draw(new Canvas(image));try(java.io.FileOutputStream stream=new java.io.FileOutputStream(System.getProperty("probe.root")+"/compact-bubbles.png")){image.compress(Bitmap.CompressFormat.PNG,100,stream);}
 picker.measure(android.view.View.MeasureSpec.makeMeasureSpec(180,1073741824),0);picker.layout(0,0,180,picker.getMeasuredHeight());assertTrue(grid.getChildAt(1).getTop()>=grid.getChildAt(0).getBottom());
}
@Test public void templateMatchesOfficialCoreGraphicsConstruction(){
 for(boolean outgoing:new boolean[]{true,false})for(boolean grouped:new boolean[]{false,true}){
  Bitmap expected=Bitmap.createBitmap(129,111,Bitmap.Config.ARGB_8888),actual=Bitmap.createBitmap(129,111,Bitmap.Config.ARGB_8888);
  Canvas c=new Canvas(expected);c.scale(3,3);if(!outgoing){c.translate(43,0);c.scale(-1,1);}c.translate(2,2);
  Paint p=new Paint(3);p.setColor(Color.BLACK);Path shape=new Path();float corner=grouped?8:16;shape.addRoundRect(new RectF(0,0,33,33),new float[]{16,16,16,16,corner,corner,16,16},Path.Direction.CW);c.drawPath(shape,p);
  if(!grouped){Path tail=new Path();tail.moveTo(24,24.5f);tail.quadTo(24,33,37.5f,33);tail.quadTo(51,33,51,24.5f);tail.close();c.drawPath(tail,p);c.drawRect(16.5f,16,33,25,p);p.setXfermode(new PorterDuffXfermode(PorterDuff.Mode.CLEAR));c.drawOval(new RectF(33,14,56,35),p);p.setXfermode(null);}
  new IosBubbleShape().build(shape,new Rect(0,0,129,111),3,48,24,outgoing,false,grouped,false,false,false);new Canvas(actual).drawPath(shape,p);
  int difference=0;for(int y=0;y<111;y++)for(int x=0;x<129;x++)if((Color.alpha(expected.getPixel(x,y))>127)!=(Color.alpha(actual.getPixel(x,y))>127))difference++;
  assertTrue("reference mask mismatch: "+difference,difference<32);
 }
}
@Test public void compactChoicesAdaptToRtlLargeFontsAndChangingAccent() throws Exception {
 android.app.Activity activity=Robolectric.buildActivity(android.app.Activity.class).setup().get();
 final int[] accent={0xffa6c87a};Theme.ResourcesProvider provider=key->key==Theme.key_windowBackgroundWhite?0xff252525:key==Theme.key_windowBackgroundWhiteBlueText?accent[0]:0xffffffff;
 for(float font:new float[]{1f,1.5f,2f})for(boolean rtl:new boolean[]{false,true}){
  android.content.res.Configuration config=new android.content.res.Configuration(activity.getResources().getConfiguration());config.fontScale=font;
  android.content.Context context=activity.createConfigurationContext(config);LocaleController.isRTL=rtl;
  app.flexygram.settings.signature.CompactStylePicker picker=new app.flexygram.settings.signature.CompactStylePicker(context,provider,new BubbleShapeMiniature(context,1),2);
  for(int n=0;n<5;n++){final int id=n;picker.addChoice(n,new String[]{"Predeterminada","Signature Adaptive","Signature Fusion","Signature Matte Portrait","Signature Floating"}[n],new BubbleShapeMiniature(context,n%3),()->picker.select(id));}
  picker.select(3);picker.measure(android.view.View.MeasureSpec.makeMeasureSpec(360,1073741824),0);picker.layout(0,0,360,picker.getMeasuredHeight());
  android.view.ViewGroup grid=(android.view.ViewGroup)picker.getChildAt(1);
  for(int n=0;n<5;n++){
   android.view.ViewGroup tile=(android.view.ViewGroup)grid.getChildAt(n);
   assertTrue(tile.getLeft()>=0&&tile.getRight()<=grid.getWidth());assertTrue(tile.getHeight()>=48);
   android.view.View pill=tile.getChildAt(0);assertEquals(34,pill.getHeight());
   android.widget.TextView label=(android.widget.TextView)tile.getChildAt(1);
   assertTrue(label.getTop()>=pill.getBottom());assertTrue(label.getBottom()<=tile.getHeight());
  }
  android.graphics.drawable.GradientDrawable selected=(android.graphics.drawable.GradientDrawable)((android.view.ViewGroup)grid.getChildAt(3)).getChildAt(0).getBackground();
  accent[0]=0xff639deb;picker.updateColors();assertTrue(grid.getChildAt(3).isSelected());assertNotNull(selected);
 }
 LocaleController.isRTL=false;
}
@Test public void conversationStageReservesSpaceForItsControlWithoutOverlappingMessages() throws Exception {
 android.app.Activity activity=Robolectric.buildActivity(android.app.Activity.class).setup().get();
 Class<?> type=Class.forName("app.flexygram.settings.signature.ConversationPreviewStage");
 java.lang.reflect.Constructor<?> constructor=type.getDeclaredConstructor(android.content.Context.class,android.view.View.class,boolean.class);constructor.setAccessible(true);
 for(boolean header:new boolean[]{false,true})for(int width:new int[]{240,360,600}){
  android.view.View control=new android.view.View(activity){@Override protected void onMeasure(int w,int h){setMeasuredDimension(MeasureSpec.getSize(w),80);}};
  android.view.ViewGroup stage=(android.view.ViewGroup)constructor.newInstance(activity,control,header);
  stage.measure(android.view.View.MeasureSpec.makeMeasureSpec(width,1073741824),0);stage.layout(0,0,width,stage.getMeasuredHeight());
  BubblePreviewView preview=(BubblePreviewView)stage.getChildAt(0);
  java.lang.reflect.Field field=BubblePreviewView.class.getDeclaredField("bubbles");field.setAccessible(true);
  MessageDrawable[] messages=(MessageDrawable[])field.get(preview);
  if(header)assertTrue(control.getBottom()<=messages[0].getBounds().top);
  else assertTrue(messages[1].getBounds().bottom<=control.getTop());
  assertEquals(stage.getHeight(),preview.getHeight());
 }
}
@Test public void officialStatusVectorPathsPreserveNativeAspectAndRoundedGeometry() throws Exception {
 for(boolean partial:new boolean[]{false,true}){
  String file=System.getProperty("probe.root")+"/flexy_"+(partial?"halfcheck":"check")+"_ios27.xml";
  String xml=java.nio.file.Files.readString(java.nio.file.Path.of(file)).replace("@android:color/transparent","#00000000");
  javax.xml.parsers.DocumentBuilderFactory factory=javax.xml.parsers.DocumentBuilderFactory.newInstance();factory.setNamespaceAware(true);
  org.w3c.dom.Element element=(org.w3c.dom.Element)factory.newDocumentBuilder().parse(new org.xml.sax.InputSource(new java.io.StringReader(xml))).getElementsByTagName("path").item(0);
  String namespace="http://schemas.android.com/apk/res/android";
  Path geometry=(Path)Class.forName("android.util.PathParser").getMethod("createPathFromPathData",String.class).invoke(null,element.getAttributeNS(namespace,"pathData"));
  Bitmap image=Bitmap.createBitmap(110,90,Bitmap.Config.ARGB_8888);Canvas actual=new Canvas(image);actual.scale(10,10);
  Paint ink=new Paint(3);ink.setColor(Color.WHITE);ink.setStyle(Paint.Style.STROKE);ink.setStrokeWidth(Float.parseFloat(element.getAttributeNS(namespace,"strokeWidth")));ink.setStrokeCap(Paint.Cap.ROUND);ink.setStrokeJoin(Paint.Join.ROUND);actual.drawPath(geometry,ink);
  Bitmap reference=Bitmap.createBitmap(110,90,Bitmap.Config.ARGB_8888);Canvas c=new Canvas(reference);c.scale(10,10);c.translate(1,1);
  Path path=new Path();if(partial){path.moveTo(.5f,7);path.lineTo(7,0);}else{path.moveTo(0,4);path.lineTo(2.95157047f,6.95157047f);path.lineTo(2.95157047f,6.95157047f);path.cubicTo(2.97734507f,6.97734507f,3.01913396f,6.97734507f,3.04490857f,6.95157047f);path.cubicTo(3.04548448f,6.95099456f,3.04604969f,6.95040803f,3.04660389f,6.9498112f);path.lineTo(9.5f,0);}
  Paint p=new Paint(3);p.setColor(Color.WHITE);p.setStyle(Paint.Style.STROKE);p.setStrokeWidth(.99f);p.setStrokeCap(Paint.Cap.ROUND);p.setStrokeJoin(Paint.Join.ROUND);c.drawPath(path,p);
  int mismatch=0;for(int y=0;y<90;y++)for(int x=0;x<110;x++)if((Color.alpha(image.getPixel(x,y))>127)!=(Color.alpha(reference.getPixel(x,y))>127))mismatch++;
  assertTrue("Original check path mask differs: "+mismatch,mismatch<12);
 }
}
@Test public void listStatusPathsRemainSharpAtEveryDensityAndRespectTintAndAlpha() {
 for(float density:new float[]{1f,2f,3f,4f})for(boolean partial:new boolean[]{false,true}){
  AndroidUtilities.density=density;app.flexygram.icons.IosListCheckDrawable tick=new app.flexygram.icons.IosListCheckDrawable(partial);
  int size=Math.round(18*density);assertEquals(size,tick.getIntrinsicWidth());assertEquals(size,tick.getIntrinsicHeight());
  Bitmap image=Bitmap.createBitmap(size,size,Bitmap.Config.ARGB_8888);tick.setBounds(0,0,size,size);
  tick.setColorFilter(new PorterDuffColorFilter(0xff42aedd,PorterDuff.Mode.MULTIPLY));tick.setAlpha(128);tick.draw(new Canvas(image));
  int count=0;for(int y=0;y<size;y++)for(int x=0;x<size;x++){int pixel=image.getPixel(x,y);assertTrue(Color.alpha(pixel)<=128);if(Color.alpha(pixel)>64){count++;assertTrue(Color.blue(pixel)>Color.red(pixel));}}
  assertTrue(count>0);tick.setAlpha(255);assertEquals(255,tick.getAlpha());
 }
 AndroidUtilities.density=1;
}

}