import android.app.*;import android.content.*;import android.graphics.*;import android.os.Bundle;import android.view.*;import android.widget.*;import java.io.*;import java.util.*;
import org.junit.*;import org.junit.runner.RunWith;import org.robolectric.*;import org.robolectric.annotation.*;import static org.junit.Assert.*;
import app.flexygram.settings.signature.*;import org.telegram.ui.ActionBar.*;import org.telegram.messenger.*;import tw.nekomimi.nekogram.config.ConfigItem;import tw.nekomimi.nekogram.config.cell.*;
/** NEW production UI/policy with explicit list, fragment, and old-controller doubles. Not an APK. */
@RunWith(RobolectricTestRunner.class) @Config(manifest=Config.NONE,sdk=35) @GraphicsMode(GraphicsMode.Mode.NATIVE)
public class Settings2AndroidTest {
 Activity activity;
 void resources() throws Exception{var m=activity.getAssets().getClass().getMethod("addAssetPath",String.class);assertTrue((Integer)m.invoke(activity.getAssets(),System.getProperty("probe.root")+"/resources.ap_")>0);}
 @Before public void setup()throws Exception{activity=Robolectric.buildActivity(Activity.class).setup().get();BaseFragment.activity=activity;ApplicationLoader.applicationContext=activity;LocaleController.isRTL=false;Theme.dark=false;resources();}
 @After public void end(){activity.finish();}
 static class Key extends AbstractConfigCell implements WithKey{String key;Key(String k){key=k;}public String getKey(){return key;}}
 @Test public void rootHasExactlyEightCategoriesInApprovedOrder(){var e=SignatureSettingsRegistry.children("root");assertEquals(Arrays.asList("appearance","navigation","conversations","studio","files","extensions","general","advanced"),e.stream().map(x->x.id).toList());}
 @Test public void everyFactoryReturnsAnExistingFragmentAndDoesNotWritePreferences(){var pref=activity.getSharedPreferences("isolated_settings2",0);pref.edit().putInt("existing",17).apply();Map<String,?> before=pref.getAll();for(var e:SignatureSettingsRegistry.all())assertNotNull(e.id,SignatureSettingsRegistry.open(e.id));assertEquals(before,pref.getAll());}
 @Test public void ownershipKeepsGroupsAndConditionalRowsOnOnePage(){var files=new Settings2Policy.Rows("general","files");assertFalse(files.named("generalHeader"));assertFalse(files.anonymous());assertTrue(files.named("storageHeader"));assertTrue(files.named("savePath"));assertTrue(files.anonymous());assertFalse(files.named("profileHeader"));assertFalse(files.anonymous());files.reset();assertFalse(files.anonymous());assertEquals("files",Settings2Policy.aliasOwner("general","SaveToChatSubfolder"));}
 @Test public void guardedRowsRejectDuplicatePreferencesEvenWhenNativeCallbackReinserts(){var rows=new SignatureSettingsRows(new ArrayList<>(),c->SignatureLegacyExtras.accepts(c,"ng","advanced_extra"));assertFalse(rows.add(new Key("UploadBoost")));assertFalse(rows.add(new Key("PerformanceClass")));assertTrue(rows.add(new Key("DisableSystemAccount")));assertEquals(1,rows.size());}
 @Test public void actualConfigItemPersistsItsOriginalKeyWithoutChangingOtherValues(){var prefs=tw.nekomimi.nekogram.NekoConfig.getPreferences();prefs.edit().putBoolean("SaveToChatSubfolder",true).putString("untouched","keep").apply();ConfigItem item=new ConfigItem("SaveToChatSubfolder",ConfigItem.configTypeBool,false);item.changed(prefs.getBoolean(item.getKey(),false));assertTrue(item.Bool());item.toggleConfigBool();assertFalse(prefs.getBoolean("SaveToChatSubfolder",true));assertEquals("keep",prefs.getString("untouched",null));assertEquals(2,prefs.getAll().size());}
 @Test public void filesScreenUsesOriginalFlexyFilesPreferenceAndPersistsAfterRecreation(){var prefs=activity.getSharedPreferences("flexyfiles_local",0);prefs.edit().putBoolean("enabled",true).apply();var page=new SignatureFilesSettingsActivity();page.onFragmentCreate();page.createView(activity);assertTrue(page.rowKeys().containsKey("savePath"));assertTrue(page.rowKeys().containsKey("flexyfilesEnabled"));page.click(page.rowKeys().get("flexyfilesEnabled"));assertFalse(app.flexygram.files.FlexyFiles.enabled());var again=new SignatureFilesSettingsActivity();again.onFragmentCreate();assertFalse(app.flexygram.files.FlexyFiles.enabled());}
 @Test public void scaledTextAndRtlDoNotEscapeTheTouchTarget(){for(float scale:new float[]{1f,1.5f,2f})for(boolean rtl:new boolean[]{false,true}){LocaleController.isRTL=rtl;activity.getResources().getDisplayMetrics().scaledDensity=scale;var row=new Settings2Cell(activity,null);row.bind("A long settings title that must wrap safely","An equally long explanatory description without truncation",android.R.drawable.ic_menu_manage,0xff168bea,true);row.measure(View.MeasureSpec.makeMeasureSpec(320,1073741824),0);row.layout(0,0,320,row.getMeasuredHeight());assertTrue(row.getHeight()>=72);for(int i=0;i<row.getChildCount();i++){View child=row.getChildAt(i);assertTrue(child.getLeft()>=0);assertTrue(child.getRight()<=320);assertTrue(child.getBottom()<=row.getHeight());}}}
 @Test public void nativeBackStateAndPasscodeVisibilityAreRetained(){var page=new SignatureSettingsActivity("extensions");page.onFragmentCreate();Bundle b=new Bundle();page.saveSelfArgs(b);var next=new SignatureSettingsActivity();next.restoreSelfArgs(b);next.onFragmentCreate();View v=next.createView(activity);assertTrue(v instanceof ViewGroup);tw.nekomimi.nekogram.helpers.PasscodeHelper.hidden=true;assertFalse(SignatureSettingsRegistry.visible("passcode"));tw.nekomimi.nekogram.helpers.PasscodeHelper.hidden=false;assertTrue(SignatureSettingsRegistry.visible("passcode"));}
 @Test public void captureActualNewRootAndHubViewsInLightAndDark()throws Exception{
  for(boolean dark:new boolean[]{false,true})for(String page:new String[]{"root","appearance","navigation","conversations","extensions","general","advanced"}){Theme.dark=dark;var screen=new SignatureSettingsActivity(page);screen.onFragmentCreate();View content=screen.createView(activity);draw(content,page+(dark?"-dark":"-light"));}
  for(boolean dark:new boolean[]{false,true}){Theme.dark=dark;var page=new SignatureFilesSettingsActivity();page.onFragmentCreate();draw(page.createView(activity),"files"+(dark?"-dark":"-light"));var studio=new app.flexygram.studio.FlexyStudioActivity();studio.onFragmentCreate();assertEquals(5,studio.count());draw(studio.createView(activity),"studio"+(dark?"-dark":"-light"));}
 }
 void draw(View content,String name)throws Exception{int width=440;content.measure(View.MeasureSpec.makeMeasureSpec(width,1073741824),View.MeasureSpec.makeMeasureSpec(4000,View.MeasureSpec.AT_MOST));content.layout(0,0,width,content.getMeasuredHeight());Bitmap b=Bitmap.createBitmap(width,Math.max(1,content.getMeasuredHeight()),Bitmap.Config.ARGB_8888);Canvas canvas=new Canvas(b);canvas.drawColor(Theme.getColor(Theme.key_windowBackgroundGray));content.draw(canvas);File out=new File(System.getProperty("probe.root"),"settings2-"+name+"-isolated.png");try(var f=new FileOutputStream(out)){assertTrue(b.compress(Bitmap.CompressFormat.PNG,100,f));}b.recycle();}
}
