import android.app.Activity;import android.graphics.*;import android.view.*;import java.io.*;import java.util.*;
import org.junit.*;import static org.junit.Assert.*;import org.junit.runner.RunWith;import org.robolectric.*;import org.robolectric.annotation.*;
import app.flexygram.effects.*;import app.exteraless.appearance.AppearanceConfig;import org.telegram.ui.ActionBar.*;import org.telegram.ui.Components.*;import org.telegram.ui.Components.blur3.*;import org.telegram.ui.Components.blur3.drawable.*;
/** Actual new controller/mapper/outline helper + actual production static methods. Not full app. */
@RunWith(RobolectricTestRunner.class) @Config(manifest=Config.NONE,sdk=35) @GraphicsMode(GraphicsMode.Mode.NATIVE)
public class GlareAndroidTest {
 Activity activity;
 @Before public void setup()throws Exception{activity=Robolectric.buildActivity(Activity.class).setup().get();BaseFragment.activity=activity;org.telegram.messenger.ApplicationLoader.applicationContext=activity;AppearanceConfig.glassOutlineStyle.setConfigInt(0);var method=activity.getAssets().getClass().getMethod("addAssetPath",String.class);assertTrue((Integer)method.invoke(activity.getAssets(),System.getProperty("probe.root")+"/resources.ap_")>0);}
 @After public void cleanup(){activity.finish();}
 @Test public void allSavedModesRoundTripAndUnknownIsDefault(){for(int stored=0;stored<5;stored++)assertEquals(stored,GlareMode.toStored(GlareMode.fromStored(stored)));assertEquals(GlareMode.DEFAULT,GlareMode.fromStored(-99));assertEquals(GlareMode.DEFAULT,GlareMode.fromStored(88));assertEquals(2,GlareMode.toStored(0));assertEquals(0,GlareMode.toStored(1));assertEquals(1,GlareMode.toStored(2));try{GlareMode.toStored(5);fail();}catch(IllegalArgumentException expected){}}
 @Test public void selectorUsesActualSavedValueAndOnlyWritesOnSelection(){var prefs=tw.nekomimi.nekogram.NekoConfig.getPreferences();prefs.edit().putString("untouched","keep").apply();AppearanceConfig.glassOutlineStyle.setConfigInt(1);var page=new GlareSettingsSection();page.onFragmentCreate();page.createView(activity);assertEquals(1,AppearanceConfig.glassOutlineStyle());page.click(page.rowKeys().get("glareEffects"));assertEquals(GlareMode.SOLID,AlertsCreator.selected);assertArrayEquals(new String[]{"Desactivar","Por defecto","Contorno sólido","Doble contorno","Adaptativo"},AlertsCreator.options);assertEquals(1,AppearanceConfig.glassOutlineStyle());AlertsCreator.listener.onClick(null,0);assertEquals(2,AppearanceConfig.glassOutlineStyle());assertEquals(2,prefs.getInt("OEAppearanceGlassOutlineStyle",-1));assertEquals("keep",prefs.getString("untouched",null));}
 @Test public void originalWeakListenerDispatchesOnlyOnChange(){int[] calls={0};GlassOutlineStyle.Listener listener=()->calls[0]++;GlassOutlineStyle.addListener(listener);GlassOutlineStyle.addListener(listener);AppearanceConfig.glassOutlineStyle.setConfigInt(0);assertEquals(0,calls[0]);AppearanceConfig.glassOutlineStyle.setConfigInt(1);assertEquals(1,calls[0]);AppearanceConfig.glassOutlineStyle.setConfigInt(1);assertEquals(1,calls[0]);AppearanceConfig.glassOutlineStyle.setConfigInt(2);assertEquals(2,calls[0]);}
 Bitmap stroke(int mode,boolean array,boolean baseline){AppearanceConfig.glassOutlineStyle.setConfigInt(GlareMode.toStored(mode));Bitmap image=Bitmap.createBitmap(100,60,Bitmap.Config.ARGB_8888);Canvas c=new Canvas(image);Paint p=new Paint(Paint.ANTI_ALIAS_FLAG);p.setColor(0xff8196ae);p.setStyle(Paint.Style.STROKE);p.setStrokeWidth(1);float[]r={18,18,9,9,15,15,3,3};for(boolean top:new boolean[]{true,false}){if(baseline){if(array)BaselineStroke.drawStroke(c,10,10,90,50,r,1,top,p);else BaselineStroke.drawStroke(c,10,10,90,50,18,1,top,p);}else{if(array)BlurredBackgroundDrawable.drawStroke(c,10,10,90,50,r,1,top,p);else BlurredBackgroundDrawable.drawStroke(c,10,10,90,50,18,1,top,p);}}return image;}
 int pixels(Bitmap b){int n=0;for(int y=0;y<b.getHeight();y++)for(int x=0;x<b.getWidth();x++)if(Color.alpha(b.getPixel(x,y))>0)n++;return n;}
 @Test public void disabledDrawsNothingAndSolidDrawsPerimeterWithoutFill(){for(boolean array:new boolean[]{false,true}){Bitmap none=stroke(0,array,false),solid=stroke(2,array,false);assertEquals(0,pixels(none));assertTrue(pixels(solid)>0);assertEquals(0,Color.alpha(solid.getPixel(50,30)));assertTrue(Color.alpha(solid.getPixel(50,10))>0);assertTrue(Color.alpha(solid.getPixel(50,49))>0);none.recycle();solid.recycle();}}
 @Test public void defaultModeIsPixelIdenticalToOriginalBothOverloads(){for(boolean array:new boolean[]{false,true}){Bitmap old=stroke(1,array,true),now=stroke(1,array,false);assertTrue(old.sameAs(now));assertTrue(pixels(now)>0);old.recycle();now.recycle();}}
 @Test public void solidBottomPassDoesNotPaintTwice(){Paint p=new Paint(3);p.setColor(Color.WHITE);for(boolean array:new boolean[]{false,true}){Bitmap b=Bitmap.createBitmap(100,60,Bitmap.Config.ARGB_8888);Canvas c=new Canvas(b);if(array)StaticOutlineStroke.drawOverride(c,10,10,90,50,new float[]{10,10,10,10,10,10,10,10},false,p,GlassOutlineStyle.SOLID);else StaticOutlineStroke.drawOverride(c,10,10,90,50,10,false,p,GlassOutlineStyle.SOLID);assertEquals(0,pixels(b));b.recycle();}}
 @Test public void borrowedPaintStateAndShaderAreRestored(){Paint p=new Paint(3);p.setStyle(Paint.Style.FILL);p.setStrokeWidth(7);p.setColor(0x40808080);Shader shader=new LinearGradient(0,0,100,0,Color.RED,Color.BLUE,Shader.TileMode.CLAMP);p.setShader(shader);Bitmap b=Bitmap.createBitmap(100,60,Bitmap.Config.ARGB_8888);Canvas c=new Canvas(b);for(int i=0;i<100;i++){StaticOutlineStroke.drawOverride(c,10,10,90,50,new float[]{10,10,8,8,6,6,4,4},true,p,GlassOutlineStyle.SOLID);assertSame(shader,p.getShader());assertEquals(Paint.Style.FILL,p.getStyle());assertEquals(7,p.getStrokeWidth(),0);assertEquals(0x40808080,p.getColor());}b.recycle();}
 @Test public void defaultNeverConsumesOverrideAndDegenerateBoundsAreSafe(){Bitmap b=Bitmap.createBitmap(100,60,Bitmap.Config.ARGB_8888);Canvas c=new Canvas(b);Paint p=new Paint(3);assertFalse(StaticOutlineStroke.drawOverride(c,10,10,90,50,10,true,p,GlassOutlineStyle.GLARE));assertTrue(StaticOutlineStroke.drawOverride(c,20,10,10,50,10,true,p,GlassOutlineStyle.SOLID));assertEquals(0,pixels(b));b.recycle();}
 @Test public void newOptionsPersistAndDispatchThroughOriginalKey(){
  var page=new GlareSettingsSection();page.onFragmentCreate();page.createView(activity);
  for(int option:new int[]{3,4}){
   page.click(page.rowKeys().get("glareEffects"));AlertsCreator.listener.onClick(null,option);
   assertEquals(option,AppearanceConfig.glassOutlineStyle());
   assertEquals(option,tw.nekomimi.nekogram.NekoConfig.getPreferences().getInt("OEAppearanceGlassOutlineStyle",-1));
   page.click(page.rowKeys().get("glareEffects"));assertEquals(option,AlertsCreator.selected);
  }
 }
 @Test public void doubleHasTwoDistinctThinEdgesAndNoCenterFill(){
  Bitmap b=stroke(3,false,false);boolean light=false,dark=false;
  for(int x=9;x<16;x++){int c=b.getPixel(x,30);if(Color.alpha(c)>0){light|=Color.red(c)>180;dark|=Color.red(c)<70;}}
  assertTrue("outer light edge",light);assertTrue("inner dark edge",dark);
  assertEquals(0,Color.alpha(b.getPixel(50,30)));b.recycle();
 }
 @Test public void adaptiveChangesPrimaryInkWithBackgroundAndUsesHysteresis(){
  GlassContourRenderer renderer=new GlassContourRenderer();
  Bitmap b=Bitmap.createBitmap(100,60,Bitmap.Config.ARGB_8888);Canvas c=new Canvas(b);
  int[] backgrounds={Color.WHITE,Color.BLACK,0xff888888,0xffdddddd};int[] ink={0,255,255,0};
  for(int i=0;i<backgrounds.length;i++){
   b.eraseColor(0);renderer.draw(c,10,10,90,50,15,GlassOutlineStyle.ADAPTIVE,backgrounds[i],255);
   assertEquals(ink[i],Color.red(b.getPixel(10,30)));assertTrue(Color.alpha(b.getPixel(10,30))>140);
   assertEquals(0,Color.alpha(b.getPixel(50,30)));
  }
  b.eraseColor(0);renderer.draw(c,10,10,90,50,15,GlassOutlineStyle.ADAPTIVE,Color.WHITE,0);
  assertEquals(0,pixels(b));b.recycle();
 }
 @Test public void extendedModesNeverMutateBorrowedPaintAndBottomPassStaysEmpty(){
  Paint p=new Paint(3);p.setColor(0x54876543);p.setStyle(Paint.Style.FILL);p.setStrokeWidth(7);
  Shader shader=new LinearGradient(0,0,100,0,Color.RED,Color.BLUE,Shader.TileMode.CLAMP);p.setShader(shader);
  Bitmap b=Bitmap.createBitmap(100,60,Bitmap.Config.ARGB_8888);Canvas c=new Canvas(b);
  for(GlassOutlineStyle mode:new GlassOutlineStyle[]{GlassOutlineStyle.DOUBLE,GlassOutlineStyle.ADAPTIVE}){
   for(int i=0;i<1000;i++)StaticOutlineStroke.drawOverride(c,10,10,90,50,10,true,p,mode);
   assertSame(shader,p.getShader());assertEquals(0x54876543,p.getColor());assertEquals(7,p.getStrokeWidth(),0);
   b.eraseColor(0);StaticOutlineStroke.drawOverride(c,10,10,90,50,10,false,p,mode);assertEquals(0,pixels(b));
  }b.recycle();
 }
 @Test public void adaptiveReusesAvailableBitmapAndFallsBackForUnavailableOrCyclicSources(){
  var sample=new GlassBackdropColor();
  var image=new org.telegram.ui.Components.blur3.source.BlurredBackgroundSourceBitmap();
  image.bitmap=Bitmap.createBitmap(8,8,Bitmap.Config.ARGB_8888);image.bitmap.eraseColor(Color.BLACK);
  image.matrix.setScale(2,2);
  assertEquals(Color.BLACK,sample.resolve(image,4,4,Color.WHITE));
  image.bitmap.eraseColor(Color.WHITE);
  assertEquals("bounded sampling reuses last result",Color.BLACK,sample.resolve(image,4,4,Color.WHITE));
  org.robolectric.shadows.ShadowSystemClock.advanceBy(java.time.Duration.ofMillis(181));
  assertEquals(Color.WHITE,sample.resolve(image,4,4,Color.BLACK));
  image.bitmap.recycle();sample.reset();assertEquals(Color.BLACK,sample.resolve(image,4,4,Color.BLACK));
  var wrapped=new org.telegram.ui.Components.blur3.source.BlurredBackgroundSourceWrapped();wrapped.source=wrapped;
  sample.reset();assertEquals(Color.WHITE,sample.resolve(wrapped,0,0,Color.WHITE));
  var color=new org.telegram.ui.Components.blur3.source.BlurredBackgroundSourceColor();color.color=Color.RED;
  var gpu=new org.telegram.ui.Components.blur3.source.BlurredBackgroundSourceRenderNode();gpu.underSource=color;
  sample.reset();assertEquals(Color.RED,sample.resolve(gpu,0,0,Color.WHITE));
 }
 @Test public void captureNativeContourSamplesBothThemes()throws Exception{for(boolean dark:new boolean[]{false,true}){Bitmap b=Bitmap.createBitmap(400,264,Bitmap.Config.ARGB_8888);Canvas c=new Canvas(b);c.drawColor(dark?0xff111820:0xfff7f8fa);Paint text=new Paint(3),fill=new Paint(3),stroke=new Paint(3);text.setColor(dark?Color.WHITE:Color.BLACK);text.setTextSize(14);fill.setColor(dark?0xff202c39:0xffe7edf5);stroke.setStyle(Paint.Style.STROKE);stroke.setStrokeWidth(1);stroke.setColor(dark?0xff8d9fb5:0xff748297);String[]names={"Desactivar","Por defecto","Contorno sólido"};for(int mode=0;mode<3;mode++){AppearanceConfig.glassOutlineStyle.setConfigInt(GlareMode.toStored(mode));int y=12+mode*84;c.drawText(names[mode],16,y+14,text);c.drawRoundRect(16,y+24,384,y+66,21,21,fill);for(boolean top:new boolean[]{true,false})BlurredBackgroundDrawable.drawStroke(c,16,y+24,384,y+66,21,1,top,stroke);}try(var out=new FileOutputStream(new File(System.getProperty("probe.root"),"glare-"+(dark?"dark":"light")+"-isolated.png"))){assertTrue(b.compress(Bitmap.CompressFormat.PNG,100,out));}b.recycle();}}
}
